const STEP_TIMER_DEFAULT = 18;
const STEP_TIMER_OFFSET = 10;		// added to min/max if crouching
const STEP_TIMER_RUNOFFSET = 5;		// removed from min/max if running
const STEP_MAXTEXLIST = 288;		// max array size for texture reading
const STEP_VOLUME = 1.0;			// default step volume
const STEP_QUIETVOLUME = 0.666;		// default quiet step volume
 
const STEP_SOUNDCHANNEL = CHAN_AUTO; // A_StartSound parameters
const STEP_ATTENUATION = ATTN_NORM;

struct stepDef {
	string Sounds[2];
}

struct stringIndexDef {
	string StringIndex;
	int IndexValue;
}

class StepEventHandler : EventHandler
{
	stringIndexDef TextureIndex[STEP_MAXTEXLIST];
	stepDef SoundIndex[STEP_MAXTEXLIST];
	Array<string> textures;
	Array<string> sounds;
	Actor mo;
	double moSpeed;
	bool quiet;
	
	int stepTimer;
	
	string readStepLump()
	{
		int lump = -1;

		lump = Wads.FindLump("STEPDEF");
		string lumpStr = Wads.ReadLump(lump);		
		return lumpStr;
	}
	
	void parseStepString(string inputLump)
	{
		string workString;
		Array<string> lines;
		string word;
		int pos = 0;
		int texIndex = 0;
		
		workString = inputLump.Filter();
		workString.replace("\t", " ");
		
		workString.Split(lines, "\n", TOK_SKIPEMPTY);
		
		for(int i = 0; i < lines.Size(); i++)
		{
			textures.Clear(); sounds.Clear();
			if(lines[i].IndexOf("#") == 0) { continue; }
			pos = lines[i].IndexOf("=");		// get the texture names
			word = lines[i].Left(pos);
			word.StripRight();
			workString = lines[i].Mid(pos+1);
			workString.StripRight();
			word.Split(textures, ":");
			word = workString;
			word.StripLeft();
			word.Split(sounds, ":");

			for(int y = 0; y < textures.Size(); y++)
			{
				stringIndexDef tex;
				TextureIndex[texIndex].StringIndex = textures[y];
				TextureIndex[texIndex].IndexValue = i;
				texIndex++;
			}
			
			if(sounds.Size() < 2) { sounds.Push(sounds[0]); }
			for(int y = 0; y < 2; y++)
			{
				SoundIndex[i].Sounds[y] = sounds[y];
			}
		}
	}
	
	string findStepSound(string TexFind, int Index)
	{
		for(int i = 0; i < STEP_MAXTEXLIST; i++)
		{
			if(TextureIndex[i].StringIndex == TexFind)
			{
				return SoundIndex[TextureIndex[i].IndexValue].Sounds[Index];
			}
		}
		return "";
	}
	
	bool isMoving()
	{
		let mo = players[consoleplayer].mo;
		if(mo)
		  moSpeed = sqrt((mo.vel.x * mo.vel.x) + (mo.vel.y * mo.vel.y)); //Shout outs to Maths Genie on YT!!
		  
		if(mo.pos.z - mo.floorz > 24) { return false; }
		if(moSpeed > 3.0) { return true; }
		return false;
	}
	
	void A_Footstep()
	{
		let mo = players[consoleplayer].mo;
		let soundIndex = 0;
		if(mo)
		{
			double stepVolume = STEP_VOLUME;
			if(players[consoleplayer].CrouchFactor == 0.5) { soundIndex = 0; stepVolume = STEP_QUIETVOLUME;} else { soundIndex = 1; }
			string soundToPlay = findStepSound(TexMan.GetName(mo.floorpic), soundIndex);
			mo.A_StartSound(soundToPlay, STEP_SOUNDCHANNEL, CHANF_DEFAULT, stepVolume*frandom(0.85, 1.0), STEP_ATTENUATION);
		}
	}
	
	override void WorldTick()
	{
		if(quiet || DFPlayer(mo).inZone || mo.waterlevel >= 1)
		  return;
		  
		if(isMoving())
		{
		  stepTimer++;
		  let offset = 0;
		  if(players[consoleplayer].crouchfactor < 1.0) { offset = STEP_TIMER_OFFSET; }
		  if(stepTimer > (STEP_TIMER_DEFAULT + offset)) {
			stepTimer = STEP_TIMER_DEFAULT - clamp(STEP_TIMER_DEFAULT / (moSpeed / 10.0), 0, STEP_TIMER_DEFAULT);
			A_Footstep();
		  }
		}
		else
		  stepTimer = 14;
		
		super.WorldTick();
	}
	
	override void WorldLoaded(WorldEvent e)
	{
		let lump = readStepLump();
		parseStepString(lump);
		
		mo = players[consoleplayer].mo;
		super.WorldLoaded(e);	
	}
	
}