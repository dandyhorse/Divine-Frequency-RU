Class InventoryItem : CustomInventory
{
  bool requireSpace;
  String PickupMsg, invIcon;
  Property Icon: invIcon;
  
  override String PickupMessage()
  {
    if(PickupMsg != "")
	{
	  GenericScreenStuff ev = GenericScreenStuff(EventHandler.Find("GenericScreenStuff"));
	  if(ev)
	    ev.UpdateItem(PickupMsg);
	}
	
	return "";
  }
  
  override bool TryPickup(in out Actor toucher)
  {
    let p = players[consoleplayer];
	
    if(p.mo && DFPlayer(p.mo).item_focus == self)
	  if((p.cmd.buttons & BT_USE) && !(p.oldbuttons & BT_USE))
	    return super.TryPickup(toucher);
	  
    return false;
  }
  
  //Thanks Major Cookie & zrrion! Yall the real MVPs
  action void A_PickupMessage(string Message)
  {
    invoker.PickupMsg = Message;
  }
  
  Default
  {
    +INVENTORY.NOSCREENFLASH
  }
}

Class CustomInventoryItem : CustomInventory
{
  String PickupSnd, invLog, invName, invIcon, invText, invLore, invSnd;
  int wt;
  bool canUse, useFromFloor, oneLimit, isTool;
  
  action void LogPickup(string msg)
  {
	GenericScreenStuff ev = GenericScreenStuff(EventHandler.Find("GenericScreenStuff"));
	if(ev)
	  ev.UpdateItem(msg);
  }
  
  void UpdateChatLog() //Called from player class
  {
    if(invLog != "")
      LogPickup(String.Format("+1 %s", invLog));
	else
	  LogPickup(String.Format("+1 %s", GetTag()));
  }
  
  override String PickupMessage()
  {
    return "";
  }
  
  override void Touch(Actor toucher)
  {
    return;
  }
  
  override bool TryPickup(in out Actor toucher)
  {
    if(useFromFloor)
	{
	  if(special > 0)
	    toucher.A_CallSpecial(special, args[0], args[1], args[2], args[3], args[4]);
		
	  Super.TryPickup(toucher);
	  return true;
	}
	
	let itm = players[consoleplayer].mo.FindInventory(self.GetClassName());
	  
	if(itm && itm.amount == 1 && CustomInventoryItem(itm).oneLimit)
	  return false;
	  
	if(CanPickup(toucher))
	{
	  if(special > 0)
	    toucher.A_CallSpecial(special, args[0], args[1], args[2], args[3], args[4]);
			
	  Super.TryPickup(toucher);
	  return true;
	}
	
	return false;
  }
  
  override void OnDrop(Actor dropper)
  {
    if(!isTool)
      DFPlayer(dropper).invCur--;
	  
	//if((dropper.vel.x + dropper.vel.y) != 0.0)
	 // vel *= .1;
	 
	Gravity = 1.0;
	  
    Super.OnDrop(dropper);
  }

  override void BeginPlay()
  {
    canUse = true;
	useFromFloor = false;
	oneLimit = false;
  }
  
  Default
  {
    +INVENTORY.KEEPDEPLETED
	+INVENTORY.NOSCREENFLASH
  }
  
  States
  {
    Pickup:
	  TNT1 A 0
	  {
	    DFPlayer(self).invCur++;
		A_StartSound(invoker.PickupSnd, CHAN_AUTO);
		
		if(invoker is "Consumable")
		  EventHandler.SendInterfaceEvent(0, "ItemSpaceUpdate");
	  }
	  Stop;
  }
}

Class LootFlash : Actor
{
  Default
  {
    Alpha 0.85;
	RenderStyle "Add";
	+NOINTERACTION
  }
  States
  {
    Spawn:
	  "####" "#" 0;
	  "####" "#" 1 Bright A_FadeOut(0.05);
	  Wait;
  } 
}