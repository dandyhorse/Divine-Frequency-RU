class InventoryMenuHandler : UIHandler
{
  bool duel_menu_build;
  String snd, commandList;
  InventoryMenu menu;
  
  void CleanExtendedPrompt()
  {
    menu.ExtendedPrompt.Hide();
  }
  
  void CleanBindingOption()
  {
    menu.BindingFrame.Hide();
  }
  
  void CleanRepairOption()
  {
    menu.RepairPrompt.Hide();
  }
	
  void CleanMenu(int i, int type = 0)
  {
	switch(type)
	{
	  case 0:
	  menu.healBtnHolder[i].setCommand("");
	  menu.healBtnHolder[i].setClickTexture(null);
	  menu.healBtnHolder[i].setHoverTexture(null);
	  menu.healIcon[i].setImageScale((1.0,1.0));
	  menu.healIcon[i].setImage("Graphics/Inventory Icon/Grid.png");
	  break;
		
	  case 1:
	  menu.toolBtnHolder[i].setCommand("");
	  menu.toolBtnHolder[i].setClickTexture(null);
	  menu.toolBtnHolder[i].setHoverTexture(null);
	  menu.toolIcon[i].setImage("");
	  menu.toolIcon[i].Unpack();
	  break;
	}
	
	menu.itemName.setText("");
	menu.itemEffect.setText("");
	menu.itemText.setText("");
	
	if(menu.UsagePrompt)
	  menu.UsagePrompt.hide();
  }
  
  void CreateDuelExit()
  {
    if(!duel_menu_build)
	{
		menu.confirm_bound = UIFrame.Create((0,0), (720,400));
		menu.confirm_bound.Pack(menu.mainframe);
		let confirm_bound_img = UIImage.Create((0, 0), (720, 400), "Graphics/GunUpgrade/Confirm_Bound.png", imagescale: (4.0,4.0));
		confirm_bound_img.Pack(menu.confirm_bound);
		menu.confirm_box = UIFrame.Create((260,150), (202,74));
		let confirm_box_img = UIImage.Create((0, 0), (202, 74), "Graphics/GunUpgrade/Confirm_Box.png");
		confirm_box_img.Pack(menu.confirm_box);
		let confirm_inactive = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button.png", true);
		let confirm_hover = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button2.png", true);
		menu.confirm_msg = UILabel.Create
		(
		  (0, 0), (200, 32),
		  text: "Confirm Exit Duel?", fnt: menu.fnt,
		  alignment: UILabel.AlignType_Center,
		  textScale: 0.45
		);
		menu.confirm_msg.Pack(menu.confirm_box);
		
		menu.btn_confirm = UIButton.Create((24, 36), (64, 24),
		"Confirm", self,
		"Confirm_Choice",
		inactive: confirm_inactive,
		hover: confirm_hover,
		click: confirm_inactive,
		fnt: menu.fnt, textScale: 0.45);
		menu.btn_confirm.Pack(menu.confirm_box);
		
		menu.btn_cancel = UIButton.Create((112, 36), (64, 24),
		"Cancel", self,
		"Cancel_Choice",
		inactive: confirm_inactive,
		hover: confirm_hover,
		click: confirm_inactive,
		fnt: menu.fnt, textScale: 0.45);
		menu.btn_cancel.Pack(menu.confirm_box);
		menu.confirm_box.Pack(menu.mainframe);
		menu.confirm_wait = true;
		duel_menu_build = true;
	}
  }
  
  void Confirm()
  {
    EventHandler.SendNetworkEvent("DuelExit");
	Menu.Close();
  }

  override void elementHoverChanged(UIElement caller, Name command, bool unhovered)
  {
	if(!unhovered)
	{
	  Array<String> cmd;
	  cmd.Clear();
	  commandList = command;
	  commandList.Split(cmd, ":");
			  
	  if(cmd.Size() < 3)
	    return;
		
	  if(cmd[0] ~== "UseItem" || cmd[0] ~== "DropItem" || cmd[0] ~== "Repair")
	    return;
	
	  if(cmd[0].Length() > 0)
	  {
		PlayerPawn pmo = players[consoleplayer].mo;
		let itm = pmo.FindInventory(cmd[2]);
		String invName = cmd[0];
		
		if(itm && itm.GetClassName() == "Stim")
		  menu.itemName.setText(cmd[0] .. " : " .. "Charge (" .. Stim(itm).amt ..  "/" .. Stim(itm).maxAmt .. ")");
		else if(itm)
		{
		  invName.Replace("|", ":");
		  menu.itemName.setText(invName);
		}
				
		String effectText = "";
		Array<String> effectList;
		
		if(cmd[1].left(1) ~== "$")
		  StringTable.Localize(cmd[1]).Split(effectList, "|");
		  
		for(int i = 0; i < effectList.Size(); i++)
		{
		  if(effectList[i].left(2) ~== "cJ") //Distinguish between heals vs utility
		  {
			effectList[i].Replace("cJ", "");
			effectText.AppendFormat("· " .. "%s\n\cJ", effectList[i]);
		  }
		  else if(effectList[i].left(2) ~== "cF")
		  {
			effectList[i].Replace("cF", "");
			effectText.AppendFormat("· \cF%s\n", effectList[i]);
		  }
		  else
		  {
			effectText.AppendFormat("· \cD%s\n\cJ", effectList[i]);
		  }
		}
		
		menu.itemEffect.setText(effectText);
		
		if(cmd[4].left(1) ~== "$")
		  menu.itemText.setText(StringTable.Localize(cmd[4]));
	  }
	}
  }

  override void ButtonClickCommand(UIButton caller, Name command)
  {
	Array<String> cmd;
	cmd.Clear();
	commandList = command;
	commandList.Split(cmd, ":");
		
	PlayerPawn pmo = players[consoleplayer].mo;
	
	if(cmd[0] ~== "ChangeMenu")
	{
	  if(cmd[1] != "InventoryMenu")
	  {
	    Menu.Close();
	    Menu.SetMenu(cmd[1]);
		Menu.MenuSound("M_Click1");
	  }
	}
	else if(cmd[0] ~== "UseItem")
	{
	  if(cmd.size() < 7)
	    return;

	  let itm = players[consoleplayer].mo.FindInventory(cmd[3]);
	  if(!itm)
	    return;
		
	  if(cmd[6].toInt(10) == 1)
	    menu.flashAlpha = 0.3;
		
	  if(!menu.ExtendedPrompt.isHidden())
		CleanExtendedPrompt();
		
	  String clsName = itm.GetClassName();
	  if(clsName == "Stim")
	  {
		EventHandler.SendNetworkEvent("UseTonic:");
		if(Stim(itm).amt > 0)
		  menu.itemName.setText(cmd[1] .. " : " .. "Charge (" .. Stim(itm).amt - 1 ..  "/" .. Stim(itm).maxAmt .. ")");
		else
		  menu.flashAlpha = 0.0;
	  }
	  else if(clsName.Left(5) == "Skill") //Bro i am way too lazy to do this the proper way. INITIATING.. LAZY HACKS!!!!
	  {
	    menu.flashAlpha = 0.0;
		if(clsName == "Skill_Exit")
		{
		  menu.MenuSound("M_Click1");
		  if(!duel_menu_build)
		  {
			CreateDuelExit();
			return;
		  }
		  else
		  {
			menu.confirm_bound.Show();
			menu.confirm_box.Show();
			menu.confirm_wait = true;
			return;
		  }
		}
		else
		{
		  EventHandler.SendNetworkEvent(String.Format("UseItem:%s:DSEMPTY", clsName));
		}
	  }
	  else if(clsName.Left(4) ~== "Key_")
	  {
	    menu.flashAlpha = 0.0;
	  }
	  else if(clsName == "GunRepair")
	  {
	    if(menu.hasWpn)
	      menu.ShowRepairOption("GunRepair:" .. cmd[4]);
	  }
	  else if(clsName == "MiniRepair")
	  {
	    if(menu.hasWpn)
	      menu.ShowRepairOption("MiniRepair:" .. cmd[4]);
	  }
	  else if(CustomInventoryItem(itm).canUse)
	  {
		snd = CustomInventoryItem(itm).invSnd;
		CleanMenu(cmd[4].ToInt(10), cmd[6].ToInt(10));
		EventHandler.SendNetworkEvent("UseItem:" .. cmd[3] .. ":" .. snd);
	  }
	}
	else if(cmd[0] ~== "DropItem")
	{
	  if(cmd[1] ~== "None")
	    return;
	
	  let itm = players[consoleplayer].mo.FindInventory(cmd[3]);
	  if(itm)
	  {
		EventHandler.SendNetworkEvent("DropItem:" .. cmd[3]);
		CleanMenu(cmd[4].ToInt(10), cmd[6].ToInt(10));
		if(!menu.ExtendedPrompt.isHidden())
		  CleanExtendedPrompt();
	  }
	}
	else if(cmd[0] ~== "BindItem")
	{
	  CleanExtendedPrompt();
	  Menu.MenuSound("menu/activate");
	  menu.ShowBindingOption();
	}
	else if(cmd[0] ~== "BindTo")
	{
	  CleanBindingOption();
	  Menu.MenuSound("menu/prompt");
	  EventHandler.SendNetworkEvent("BindQuickUse:" .. cmd[1] .. ":" .. menu.bindItem);
	}
	else if(cmd[0] ~== "Repair")
	{
	  CleanRepairOption();
	  CleanMenu(cmd[3].ToInt(10), 0);
	  EventHandler.SendNetworkEvent("RepairItem:" .. cmd[1] .. ":" .. cmd[2]);
	  if(cmd[2] ~== "GunRepair")
	    Menu.MenuSound("Repair");
	  else
	    Menu.MenuSound("Repair2");
	}
	else if(cmd[0] ~== "Cancel_Choice")
	{
	  menu.confirm_bound.hide();
	  menu.confirm_box.hide();
	  menu.confirm_wait = false;
	}
	else if(cmd[0] ~== "Confirm_Choice")
	{
	  Confirm();
	}
  }
}