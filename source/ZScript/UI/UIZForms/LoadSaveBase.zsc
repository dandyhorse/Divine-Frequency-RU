#include "./Load Menu/LoadMenu.zsc"
#include "./Load Menu/LoadHandler.zsc"

#include "./Save Menu/SaveMenu.zsc"
#include "./Save Menu/SaveHandler.zsc"

// I made a base class just to try and reduce how much is in the actual menu docs for Load and Save
// This base uses the UIGenericMenu from Zforms, because ZForms is too good not to use :) 
Class LoadSaveBase : UIGenericMenu
{
	//We use a Standard resoultion across the board to make placement and scaling of elements way easier
	Vector2 BaseRes;

    //This will hold all of the data for our saves
    SaveGameManager Manager;

	//This is going to hold our command Handler class later
	UIHandler cmdHandler;
    
	//I use a universal index to make sure all of our differant elements are in sync
	int SlotSize;
	
	//
	int save_pic_index;
	
	//
	bool del_wait, overwrite_wait;
	
	//
	String save_title;
	
	//
	vector2 RealPos, RealSize;
	
	//A bunch of arrays for our save slot buttons later
	Array<UIButton> SaveSlotButton, DeleteSaveSlot;
	Array<UILabel> SaveSlotTitle, SaveSlotTimeSaved, SaveSlotMapNumber, SaveSlotMapName, SaveSlotSaveAge;

	//This is used in both menus for when pop up menus happen
	UIScrollContainer SaveFrameScrollArea;

    override void init(Menu parent)
	{
		Super.init(parent);
		BaseRes = (1920,1080); //set up that baseRes for everything to use
		SetBaseResolution(BaseRes); //Set the Virtual Resolution to 1920 x 1080.

        //Now we fetch the data for our saves and save it inside of Manager
		Manager = Manager.GetManager();

		//The space that the save slots take up
		SlotSize = 162;

		//Animated: true is uncapped FPS : False is capped at 35
		Animated = true;
		
		//Fetch all of the textures we're going to use for our menu
		InitTextures();
	}

	//Confirm Delete Popup Menu
	UIFrame Delete_Frame;
	
	void ConfirmDelete(Vector2 Resolution, int SaveSlot)
	{
		MenuSound("M_Click2");
		
		//Frame for the Popup window
		Delete_Frame = UIFrame.create(Resolution/4+(0,88), (960, 240));
		Delete_Frame.pack(mainFrame);

		//Background image
		let BackgroundImage = UIImage.create((0,0),(960,240), "Graphics/LoadSave Menu/PopupBackground.png");
		BackgroundImage.pack(Delete_Frame);

		//Title text
		let TitleLabel = UILabel.create((0,20), (960,150), "Delete Save?\n" .. save_title, "BIGFONT", 2, true, true, textscale: 3.0);
		TitleLabel.pack(Delete_Frame);

		//This button will delete the Save
		let ConfirmDeleteButton = UIButton.create((158, 128), (250,80), "DELETE \cU(Y)", cmdHandler, 'DeleteSave'..SaveSlot, ConfirmNormal, ConfirmHover, ConfirmNormal, textScale: 4.0);
		ConfirmDeleteButton.pack(Delete_Frame);

		//This button will cancel the deletion
		let CancelButton = UIButton.create((552, 128), (250,80), "CANCEL \cU(N)", cmdHandler, 'CancelDelete', ConfirmNormal, ConfirmHover, ConfirmNormal, textScale: 4.0);
		CancelButton.pack(Delete_Frame);
	}

	//Confirm Overwrite Popup Menu
	UIFrame OverwriteSave_Frame;

	void ConfirmOverwrite(Vector2 Resolution, int SaveSlot)
	{		
		MenuSound("M_Click2");
		
		//We need this to fetch the title for the Save Game we aree tyring to overwrite
		Manager.ReadSaveStrings();

		OverwriteSave_Frame = UIFrame.create(Resolution/4+(0,88), (960, 240));
		OverwriteSave_Frame.pack(mainFrame);

		let BackgroundImage = UIImage.create((0,0),(960,240), "Graphics/LoadSave Menu/PopupBackground.png");
		BackgroundImage.pack(OverwriteSave_Frame);

		let TitleLabel = UILabel.create((0,20), (960,150), "Overwrite Save?", "BIGFONT", 2, true, true, textscale: 3.0);
		TitleLabel.pack(OverwriteSave_Frame);

		let ConfirmSaveButton = UIButton.create((158,128), (250,80), "SAVE \cU(Y)", cmdHandler, 'OverwriteSave'..SaveSlot, ConfirmNormal, ConfirmHover, ConfirmNormal, textScale: 4.0);
		ConfirmSaveButton.pack(OverwriteSave_Frame);

		let CancelButton = UIButton.create((552,128), (250,80), "CANCEL \cU(N)", cmdHandler, 'CancelOverwrite', ConfirmNormal, ConfirmHover, ConfirmNormal, textScale: 4.0);
		CancelButton.pack(OverwriteSave_Frame);
	}

	//Confirm Create New Save Popup Menu
	UIFrame NewSave_Frame;

	void CreateNewSave(Vector2 Resolution)
	{
		NewSave_Frame = UIFrame.create(Resolution/4+(240,0), (480, 240));
		NewSave_Frame.pack(mainFrame);

		let BackgroundImage = UIImage.create((0,0),(480,240), "Graphics/LoadSave Menu/PopupBackground.png");
		BackgroundImage.pack(NewSave_Frame);

		let TitleLabel = UILabel.create((0,20), (480,150), "Create New Save?", "BIGFONT", 2, true, true, textscale: 4.0);
		TitleLabel.pack(NewSave_Frame);
		
		let ConfirmSaveButton = UIButton.create((480-138,240-74), (128,64), "Confirm", cmdHandler, 'ConfirmNewSave', ConfirmNormal, ConfirmHover, ConfirmClick);
		ConfirmSaveButton.pack(NewSave_Frame);

		let CancelButton = UIButton.create((15,240-74), (128,64), "Cancel", cmdHandler, 'CancelNewSave', CancelNormal, CancelHover, CancelClick);
		CancelButton.pack(NewSave_Frame);
	}

	//Textures for save slot buttons
	UIBoxTextures SaveSlotNormal, SaveSlotHover, SaveDefaultNormal;
	UIBoxTextures ScrollNormal,	ScrollHover;
	UIBoxTextures DeleteSaveNormal, DeleteSaveHover;
	UIBoxTextures ConfirmNormal, ConfirmHover, ConfirmClick;
	UIBoxTextures CancelNormal, CancelHover, CancelClick;
	UIBoxTextures Textbox_Normal;

	void InitTextures()
	{
		// Save Game Slot Textures
		SaveSlotNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/SaveSlot_Normal.png", (0,0), (1200,SlotSize), true, true);
		SaveSlotHover = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/SaveSlot_Hover.png", (0,0), (1200,SlotSize), true, true);
		SaveDefaultNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/SaveDef_Normal.png", (0,0), (1200,SlotSize), true, true);

		//Scrollbar Textures
        ScrollNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/ScrollBar.png", (0,0), (10,700), true, true);
		ScrollHover = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/ScrollBarHover.png", (0,0), (10,700), true, true);

		//Delete save Button Textures
		DeleteSaveNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/DeleteNormal.png", (0,0), (76,76), true, true);
		DeleteSaveHover = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/DeleteHover.png", (0,0), (76,76), true, true);
		
		//Confirm Button Textures
		ConfirmNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/ConfirmNormal.png", (0,0), (250,80), true, true);
		ConfirmHover = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/ConfirmHover.png", (0,0), (250,80), true, true);
		ConfirmClick = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/ConfirmClick.png", (0,0), (128,64), true, true);
		
		//Cancel Button Textures
		CancelNormal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/CancelNormal.png", (0,0), (128,64), true, true);
		CancelHover = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/CancelHover.png", (0,0), (128,64), true, true);
		CancelClick = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/CancelClick.png", (0,0), (128,64), true, true);

		//Text Box Textures
		Textbox_Normal = UIBoxTextures.CreateTexturePixels("Graphics/LoadSave Menu/Textbox_Normal.png", (0,0), (256,64), true, true);
	}

	//This handles what happens when you press the Escape key on your keyboard
	//If we have a popup open will will close it, otherwise we go back to the previous menu like normal
	override void handleback()
	{
		//If the pop up menu has existed and still exists, close it
		if(Delete_Frame && mainFrame.indexOfElement(Delete_Frame) != mainframe.elementCount())
		{			
			del_wait = false;
			Delete_Frame.unpack();
			SaveFrameScrollArea.Enable();
		}else if(OverwriteSave_Frame && mainFrame.indexOfElement(OverwriteSave_Frame) != mainframe.elementCount())
		{			
			del_wait = false;
			overwrite_wait = false;
			OverwriteSave_Frame.unpack();
			SaveFrameScrollArea.Enable();

		}else if(NewSave_Frame && mainFrame.indexOfElement(NewSave_Frame) != mainframe.elementCount())
		{			
			NewSave_Frame.unpack();
			SaveFrameScrollArea.Enable();

		}else
		{
			super.handleback();
		}

	}
}


