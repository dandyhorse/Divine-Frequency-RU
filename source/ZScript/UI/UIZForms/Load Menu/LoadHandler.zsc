Class LoadMenuHandler : UIHandler
{
	//This is for referancing the menu that is using this handler
	DFLoadMenu menu;
	SaveGameManager Manager;
	
	void DeleteSave(int i)
	{
		DFLoadMenu(menu).del_wait = false;
		
		Manager = Manager.GetManager();
		Manager.ReadSaveStrings();
		manager.ExtractSaveData(i);
		//Crashes if unpacked so we have to hide instead
		//hide the buttons associated with the save slot we are deleting
		//Delete the button from the array then shrink the array
		DFLoadMenu(menu).SaveSlotButton[i].sethidden(1);
		DFLoadMenu(menu).SaveSlotButton.Delete(i);
		DFLoadMenu(menu).SaveSlotButton.ShrinkToFit();

		DFLoadMenu(menu).DeleteSaveSlot[i].sethidden(1);
		DFLoadMenu(menu).DeleteSaveSlot.Delete(i);
		DFLoadMenu(menu).DeleteSaveSlot.ShrinkToFit();

		DFLoadMenu(menu).SaveSlotTitle[i].sethidden(1);
		DFLoadMenu(menu).SaveSlotTitle.Delete(i);
		DFLoadMenu(menu).SaveSlotTitle.ShrinkToFit();

		DFLoadMenu(menu).SaveSlotMapName[i].sethidden(1);
		DFLoadMenu(menu).SaveSlotMapName.Delete(i);
		DFLoadMenu(menu).SaveSlotMapName.ShrinkToFit();

		DFLoadMenu(menu).SaveSlotSaveAge[i].sethidden(1);
		DFLoadMenu(menu).SaveSlotSaveAge.Delete(i);
		DFLoadMenu(menu).SaveSlotSaveAge.ShrinkToFit();

		DFLoadMenu(menu).SaveSlotTimeSaved[i].sethidden(1);
		DFLoadMenu(menu).SaveSlotTimeSaved.Delete(i);
		DFLoadMenu(menu).SaveSlotTimeSaved.ShrinkToFit();
	
		//Takes all the buttons below the deleted save and moves them up
		for(int k = 0; k < DFLoadMenu(menu).SaveSlotButton.Size(); k++)
		{
			if(k >= i)
			{
				DFLoadMenu(menu).SaveSlotButton[k].SetPosY(DFLoadMenu(menu).SaveSlotButton[k].GetPosY()-162);
				DFLoadMenu(menu).SaveSlotButton[k].SetCommand('Saveslot:'..k);
				DFLoadMenu(menu).SaveSlotTitle[k].SetPosY(DFLoadMenu(menu).SaveSlotTitle[k].GetPosY()-162);

				DFLoadMenu(menu).DeleteSaveSlot[k].SetPosY(DFLoadMenu(menu).DeleteSaveSlot[k].GetPosY()-162);
				DFLoadMenu(menu).DeleteSaveSlot[k].SetCommand('ConfirmMenu'..k);

				DFLoadMenu(menu).SaveSlotMapName[k].SetPosY(DFLoadMenu(menu).SaveSlotMapName[k].GetPosY()-162);
				DFLoadMenu(menu).SaveSlotSaveAge[k].SetPosY(DFLoadMenu(menu).SaveSlotSaveAge[k].GetPosY()-162);
				DFLoadMenu(menu).SaveSlotTimeSaved[k].SetPosY(DFLoadMenu(menu).SaveSlotTimeSaved[k].GetPosY()-162);
			}
		}

		//This actually deletes the save
		Manager.UnloadSaveData();
		Manager.RemoveSaveSlot(i);
		
		//Unloads the Delete Menu and Enables the Scroll Area
		LoadSaveBase(menu).Delete_Frame.unpack();
		DFLoadMenu(menu).SaveFrameScrollArea.Enable();
	}
	
	override void elementHoverChanged(UIElement caller, Name command, bool unhovered)
    {
		if(!unhovered)
		{
			Array<String> cmd;
			String commandList = command;
			commandList.Split(cmd, ":");
			Menu.MenuSound("menu/clear");
			if(cmd[0] == "SaveSlot")
			{
				Menu.save_pic_index = cmd[1].ToInt(10);
			}
		}
	}
	
	override void buttonClickCommand(UIButton caller, Name command)
	{
		Array<String> cmd;
		String commandList = command;
		commandList.Split(cmd, ":");
	  
		//strings for the multiple buttons we created in the Load Menu
		string SaveSlotNum;
		string ConfirmMenuNum;
		string DeleteSaveNum;

		//Setup the Save Game Manager
		Manager = Manager.GetManager();
		Manager.ReadSaveStrings();

		//Cancels out of the Delete Pop up without doing anything
		if(command == "CancelDelete")
		{
			//Unloads the Delete Save Menu and re-enables the Scroll Area
			LoadSaveBase(menu).Delete_Frame.unpack();
			DFLoadMenu(menu).SaveFrameScrollArea.Enable();
			LoadSaveBase(menu).del_wait = false;
		}

		for(int i = 0; i < manager.SavegameCount(); i++)
		{
			SaveSlotNum = "SaveSlot:" ..i;
			ConfirmMenuNum = 'ConfirmMenu'..i;
			DeleteSaveNum = 'DeleteSave'..i;
			
			if(command == SaveSlotNum)
			{
				manager.ExtractSaveData(i);
				//This actually loads the save game we have chosen
				Manager.LoadSaveGame(i);
				break;
			}else if(command == ConfirmMenuNum)
			{
				//disables the Scroll Area and loads the Scroll Area
				DFLoadMenu(menu).del_wait = true;
				DFLoadMenu(menu).SaveFrameScrollArea.Disable();
				LoadSaveBase(menu).ConfirmDelete(DFLoadMenu(menu).BaseRes, i);
				break;
			}else if(command == DeleteSaveNum)
			{
				Menu.MenuSound("menu/prompt");
				LoadSaveBase(menu).del_wait = false;
				DeleteSave(i);
				break;
			}
		}
	}
}