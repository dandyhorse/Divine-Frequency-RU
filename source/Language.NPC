[enu default]
Next = "\cQNext";
Back = "\cQPrevious";
Leave = "\cQ(Leave)";
Silent = "\cD[Remain silent]";
Ask = "I wanted to ask you about something else.";
Nvm = "Nevermind.";

Background = "BACKGROUND";
Intro_Name = "DEATH";
Intro_New_Title = "CHARACTER SHEET";
Intro_New_00 = "\cDYou are dead...";
Intro_New_01 =
"\cDBut you are briefly returned to awareness by three distinct waveforms. They are ringing out into the cosmos in a "
"silent ensemble. The harmonies leave a lasting impression on your senses and embryonic mind.\n\n"
"These vibrations, like you, are fading away. You must synchronize. Choosing one foregoes the others.";
Intro_New_01a = "\cQ[Instinct] \cDAttune to the low vibration.";
Intro_New_01b = "\cQ[Instinct] \cDAttune to the high vibration. \cQ(Recommended)";
Intro_New_01c = "\cQ[Instinct] \cDAttune to the chaotic vibration.";
Intro_New_01a_1 =
"\cFYou feel strong, fully energized. Any opposition can be shattered with your bare hands, any current can be tempered with your might.\n\n"
"\cDADVANTAGE:\n"
"·Melee attacks become powerful. You do not have to solely rely on firearms.\n"
"·Killing an enemy with a melee attack recovers a significant amount of health.\n\n"
"\cRDISADVANTAGE:\n"
"·Your carry limit on ammunition and consumable items are severely limited.\n\n"
"\cJThis chosen vibration will grant you \cF+1 Strength\cJ, which determines melee damage, stamina consumption, and recoil control.";
Intro_New_01b_1 =
"\cFYou feel an intrinsic awareness of all systems and arrangements. Whether it's the abstraction of machine codes or the mechanical "
"complexity of a firearm. You are keenly aware on how most things operate.\n\n"
"\cDADVANTAGE:\n"
"·You have an easier time spotting consumables. You can also detect secrets and ambush.\n"
"·Your psionic potential allows you to acquire more psychic power.\n\n"
"\cRDISADVANTAGE:\n"
"·You are weak. Your maximum health is lowered and your melee attacks are near useless.\n\n"
"\cJThis chosen vibration will grant you \cF+1 Wits\cJ, which determines your handling of firearms and ability to bypass electronic security - which "
"can provide additional supplies and intel on enemies.";
Intro_New_01c_1 =
"\cFYou're not quite sure what you feel, if you could even constitute it as feeling. You are everything, and nothing. You feel... the need to devour.\n\n"
"\cDADVANTAGE:\n"
"·You can eat corpses (including dead enemies) to evolve and mutate. Mutation allows you to develop offensive and defensive biological abilities.\n\n"
"\cRDISADVANTAGE:\n"
"·You cannot receive Weapon Modifications.\n"
"·Your melee attacks are near useless.\n\n"
"\cJThis chosen vibration will grant you \cF+1 Physique\cJ, which determines your tolerance to Radiation & Toxin.";
Intro_New_02a = "\cQ[Instinct] \cDFeel drawn towards the low vibration.";
Intro_New_02b = "\cQ[Instinct] \cDFeel drawn towards the high vibration.";
Intro_New_02c = "\cQ[Instinct] \cDFeel drawn towards the chaotic vibration.";
Intro_New_Ready = "\cQ[Instinct] \cDInterlink your ontological nature and awaken.";
Intro_New_Back = "\cQ[Instinct] \cDWithdraw from this sensation (Go back).";
Intro_Cheater = "Cool Gods of the Divine Frequency Universe";
Intro_Cheater01 = 
"THAT. WAS. AWESOME!! Either you totally cheated or are packing some serious skills! But really, what can we say? "
"It was impressive! You naughty, wild animal, putting that punk ass bitch in their place.\n\n"
"Anyway, read this cool pamphlet.";

Intro =
"Welcome to the world of Divine Frequency!\n\n"
"Beyond are many terrible and malevolent ways to be slaughtered. Shattered minds and the sinister geometry alike roam this dizzying nightmare. "
"But there in the inferno... in the abyss, Treasures and Eternal Life abound!\n"
"Before you venture out into the unknown, you must CHOOSE YOUR HOBO:\n\n"
"Consider \cFTerminator Street Fighting Kung-Fu Gorilla\cJ:\n"
"\cD''Refine your mechanical anatomy towards lethal precision. Remove the limits between mind and body...''\n\n\cJ"
"Or \cFMagical Gun Expert Wizard\cJ:\n"
"\cD''Delve deeper into the intricacies of cosmos' harmonics. Synchronize thoughts with matter...''\n\n\cJ"
"Alternatively, for those seeking a spicier option, \cFEldritch Monster\cJ:\n"
"\cD''Embrace the madness beyond biology. Steer the course of your evolution...''";
Intro_a = "\cDExamine \cFTerminator Street Fighting Kung-Fu Gorilla";
Intro_b = "\cDExamine \cFMagical Gun Expert Wizard";
Intro_c = "\cDExamine \cFEldritch Monster";
Intro_1a = "\cDConfirm \cFTerminator Street Fighting Kung-Fu Gorilla \cD& open your eyes...";
Intro_1b = "\cDConfirm \cFMagical Gun Expert Wizard \cD& open your eyes...";
Intro_1c = "\cDConfirm \cFEldritch Monster \cD& open your eyes...";
Intro_1d = "\cQGo Back & let this dream continue.";

Intro_STR = 
"\cFAn ancient champion of the Enlightened tribe, you are a powerful warrior who had their "
"soul blessed by the Divine Frequency itself. Your vitality and regenerative factor allowed "
"you to emerge victorious in grueling and deadly fights that would had claimed even the most "
"toughest predators.\n\n"
"\cDADVANTAGE:\n"
"·Melee attacks become powerful. You do not have to solely rely on firearms.\n"
"·Killing an enemy with a melee attack recovers a significant amount of health.\n\n"
"\cRDISADVANTAGE:\n"
"·Your carry limit on ammunition and consumable items are severely limited.\n\n"
"\cJThis hobo comes with \cF+1 Strength\cJ, which determines melee damage, stamina consumption, and recoil control.";

Intro_STR2 =
"\cFBorn into a savage world, you learned quickly that words are meaningless, only actions mattered. "
"Your willingness to act leaves no room for hesitations, allowing you to destroy many enemies head on. "
"The world may stand against you as an all consuming darkness, but your spirit will always illuminate a "
"path forward. This blessing is won over in past shamanic rituals of death, journeys that revealed to "
"your soul the world within & the one beyond.\n\n"
"\cDYOUR LAST MEMORY:\n"
"\cJYou walked along the tunnels of the underworks, muscles on a hair-trigger, ready to answer "
"in kind to any menace. All kinds of creatures lurk in the dark pits flooded with sewage, and down here, "
"it's kill for food, or die to feed.\n\n"

"But you remember finding something. You didn't know what it was, but you were certain it was yours. It "
"was the first time you went to sleep at peace in too many years...";

Intro_WIT =
"\cFAn ancient cultist of the Chiral Covenant, you are a cyborg that siphons the Divine Frequency "
"through its arcane machinery and circuits. Your intellect and sensory awareness lets you unfold "
"layers of the world -- its secrets and intricate complexities fall into your hand to command.\n\n"
"\cDADVANTAGE:\n"
"·You have an easier time spotting consumables. You can also detect secrets and ambush.\n"
"·Your psionic potential allows you to acquire more psychic power.\n\n"
"\cRDISADVANTAGE:\n"
"·You are weak. Your maximum health is lowered and your melee attacks are near useless.\n\n"
"\cJThis hobo comes with \cF+1 Wits\cJ, which determines your handling of firearms and ability to bypass electronic security - which "
"can provide additional supplies and intel on enemies.";

Intro_WIT2 =
"\cFYou hail from the Chiral Covenant, an empire that formerly held the world in its palm. You've witnessed "
"the peak of a golden era and its inevitable descent into nothingness. Hosting a century's worth of "
"knowledge and some expired implants, your senses are tuned beyond the human restraint. Limit breaks "
"have allowed you to glimpse past the universe's illusory veil, a calibrating lens peering into the Pleroma.\n\n"
"\cDYOUR LAST MEMORY:\n"
"\cJYou roamed on the edges of the underworks, close to the ruins of knowledge centers and "
"whatever secrets stored within that could be physically salvaged. You've carved a path for "
"yourself through every tool available to you, but there's only so much a cunning mind can achieve in this "
"barbaric world.\n\n"

"But then, you found that which you were looking for. You couldn't make much sense of it, but you knew "
"your search had ended. The next day would begin with hope.";

Intro_PHY =
"\cFAn escaped experiment inside the underground labs, you are a shambling horror that is "
"juiced up on the Divine Frequency. And much like the Divine Frequency, you relentlessly "
"devour anything in sight - particularly biomass, constantly mutating and morphing into "
"the perfect disorder.\n\n"
"\cDADVANTAGE:\n"
"·You can eat corpses (including dead enemies) to evolve and mutate. Mutation allows you to develop offensive and defensive biological abilities.\n\n"
"\cRDISADVANTAGE:\n"
"·You cannot receive Weapon Modifications.\n"
"·Your melee attacks are near useless.\n\n"
"\cJThis hobo comes with \cF+1 Physique\cJ, which determines your tolerance to Radiation & Toxin.";

Intro_PHY2 =
"\cFYou are an unnatural product of aberrant mutations. Even your creators aren't quite sure WHAT you are...\n\n"
"\cDYOUR LAST MEMORY:\n"
"\cJYour escape led you to the pits beneath whatever originated you. Comfortable in the "
"darkness and solitude you skulked on the shadows, preying on the flesh and minds of whatever put their "
"sights on you. Refusing to just lay down and die, your misshapen existence grew ever more resilient.\n\n"

"But then, you found that piece you knew was missing. Your every instinct pointed towards it, and now "
"that it was close to you, surviving didn't seem so bad anymore.";

Spray = "Repair Spray";
Spray_01 =
"\cDThe printed label on the repair spray reads:\n"
"\cU''EZ Fix! For all your repairing needs, nothing like EZ Fix! With a stable shelf life of over a hundred years, there's nothing you can't fix with EZ Fix!''";
Spray_01a = "\cD[Repair Handgun]";
Spray_02 =
"\cDDecades of wear and tear washes away relatively quickly. The Handgun is operational again.";

Vial = "Fully Distilled Psykhus";
Vial_01 = "\cDGo ahead. Give it a sip...";
Vial_01a = "\cD[Drink Fully Distilled Psykhus]";
Vial_02 = "\cDYou feel an immediate and overwhelming surge of life energy. Wounds appear to mend themselves, bones snap back into place, and your spirit feels emboldened, ready for "
"whatever horror is waiting for you outside.";

//Map02c //////////////////////////////////////////////////////////
ODD_DEVICE_01 =
"\cDIts presence is now cavernous, yet fleeting, withering and re-assembling into impossible concepts at a constant rhythm.\n\n"
"The space beyond are almost within reach. Its celestial lights dancing in an exotic pattern, taunting you.\n\n...";

ODD_DEVICE_02 =
"\cDA mounting maelstrom of thoughts becomes more apparent. Its ongoing deviation between the language of creation and the absurdity of imagination quickens to an unbearable pace.\n\n"
"There is no denying it. This is the heartbeat of the Divine Wave. One mere droplet, gargantuous to all the rivers and sea.\n\n"

"However, within the throes of fragmented chaos. One concept remains clear. Possbility, the very raw essence of it.";