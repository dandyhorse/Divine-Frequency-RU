Script "Handgun_Ammo1" (void)
{
	SetFont (const:"ACS_FONT");
    HudMessage(s:"\c[Gold]--Extended Mag: Tier I--\c[-]\nHandgun Maximum Capacity +2";
                HUDMSG_FADEOUT, 1, CR_WHITE, 1.5, 0.05, 4.0, 1.0);
	Delay(35*4);
}

