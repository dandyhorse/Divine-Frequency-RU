Script "Codex_Weapon" (int type)
{
	str wep = "";
	switch(type)
    {
	  case 0:
	  wep = "\cFWrench";
	  break;
	  
	  case 1:
	  wep = "\cFHandgun";
	  break;
	  
	  case 2:
	  wep = "\cFTrench Gun";
	  break;
	  
	  case 3:
	  wep = "\cFDeath";
	  break;
	  
	  case 4:
	  wep = "\cFSpray Can";
	  break;
	  
	  case 5:
	  wep = "\cFChipped Tooth";
	  break;
	  
	  case 6:
	  wep = "\cFSniper Rifle";
	  break;
	}
	
	SetFont (const:"ACS_FONT");
    HudMessage(s:"+Codex Entry: ", s:wep;
    HUDMSG_FADEOUT, 1, CR_WHITE, 1.5, 0.05, 3.0, 1.0);
	Delay(35*4);
}

Script "Codex_Misc" (int type)
{
	str nfo = "";
	switch(type)
    {
	  case 0:
	  nfo = "\cFAnomaly Levels";
	  break;
	  
	  case 1:
	  nfo = "\cFFactions";
	  break;
	}
	
	SetFont (const:"ACS_FONT");
    HudMessage(s:"+Codex Entry: ", s:nfo;
    HUDMSG_FADEOUT, 1, CR_WHITE, 1.5, 0.05, 3.0, 1.0);
}

