Script "Jammed" (void)
{
	SetFont(const:"ACS_FONT");
	for(int i = 0; i < 5; i++)
	{
		HudMessage(s:"Weapon Broken!!";
		0, 900, CR_WHITE, 1.5, 0.55, 0.3);
		Delay(7);
		HudMessage(s:"\cGWeapon Broken!!";
		0, 900, CR_WHITE, 1.5, 0.55, 0.5);
		Delay(14);
	}
}

Script "NoPsi" (void)
