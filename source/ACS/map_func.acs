#library "map_func"
#include "zcommon.acs"

Script "Autosave" (void)
{
	ScriptCall("Saver", "Autosave");
}

Script "NewGoal" (void)
{
	SetFont(const:"ACS_FONT");
	for(int i = 0; i < 8; i++)
	{
		HudMessage(s:"--Objective Updated--";
		0, 900, CR_WHITE, 1.5, 0.05, 0.12);
		Delay(4);
		HudMessage(s:"\cF--Objective Updated--";
		0, 900, CR_WHITE, 1.5, 0.05, 0.12);
		Delay(4);
	}
}

Script "Radiation_Build" (int ticInterval)
{
	GiveActorInventory(0, "RadiationToken", 1);
	Delay(ticInterval);
	restart;
}

int intSetVolume = 1.0;
Script "SetMusicVolumeFactor" (int intTargetVolume, int intDelay)
{
   intTargetVolume *= 256;

   If (intDelay > 0)
   {
      int intStepSize = (intSetVolume - intTargetVolume) / intDelay;

      For (int i = 0; i <= intDelay; i++)
      {
         SetMusicVolume(intSetVolume - (intStepSize * i));
         Delay(1);
      }
   }

   SetMusicVolume(intTargetVolume);
   intSetVolume = intTargetVolume;
}

Script "TP_Door"(int sec_tag, int snd_type)
{
	CancelFade();
	if(snd_type == 0)
	{
		LocalAmbientSound("DoorTP1",127);//Regular transition
	}
	else if (snd_type == 1)
	{
	    LocalAmbientSound("DoorTP7", 127); //Softer Transition
	}
	else if (snd_type == 2)
	{
		LocalAmbientSound("DOORM1O", 127); //Big Metal Door transition
	}
	
	SetPlayerProperty(1,1,0);
	fadeto(0, 0, 0, 1.0, 0.5);
	Delay(32);
	Teleport_NoFog(sec_tag, 1, 0);
	Delay(24);
	
	if(snd_type == 0)
	{
		LocalAmbientSound("DoorTP2",127);//Regular transition
	}
	else if (snd_type == 1)
	{
	    LocalAmbientSound("DoorTP8", 127); //Softer Transition
	}
	else if (snd_type == 2)
	{
		LocalAmbientSound("DOORM1C", 127); //Big Metal Door transition
	}
	
	fadeto(0, 0, 0, 0.0, 0.5);
	SetPlayerProperty(1,0,0);
}

Script "Ladder" (int sectag)
{
	SetPlayerProperty(0, 1, 4);
	FadeTo(0, 0, 0, 1.0, 0.5);
	Delay(7);
	AmbientSound("Ladder", 127);
	Delay(10);
	Teleport_NoFog(sectag, 1, sectag);
	Delay(10);
	SetPlayerProperty(0, 0, 4);
	FadeTo(0, 0, 0, 0.0, 0.5);
}

Script "LightSwitchIsUp"(int switchlineid)
{
	SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_OFF");
	 ActivatorSound("LIGHTSW",127);
     suspend;
	 SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_ON");
	 ActivatorSound("LIGHTSW",127);
}

Script "LightSwitchIsDown"(int switchlineid)
{
	SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_ON");
	 ActivatorSound("LIGHTSW",127);
     suspend;
	 SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_OFF");
	 ActivatorSound("LIGHTSW",127);
}

Script "DeactivateLight"(int switchlineid, int thingtag)
{
	SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_OFF");
	ActivatorSound("LIGHTSW",127);
	Thing_Deactivate(thingtag);
    suspend;
	SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_ON");
	ActivatorSound("LIGHTSW",127);
	Thing_Activate(thingtag);
}

Script "ActivateLight"(int switchlineid, int thingtag)
{
    SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_ON");
	 ActivatorSound("LIGHTSW",127);
	 Thing_Activate(thingtag);
     suspend;
	 SetLineTexture(switchlineid, SIDE_FRONT, TEXTURE_MIDDLE, "B_SW_OFF");
	 ActivatorSound("LIGHTSW",127);
	 Thing_Deactivate(thingtag);
}

