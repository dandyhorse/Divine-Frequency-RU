int shroom_prog = 0;
Script 26 (int var) //Mushroom stuff Leave Trance
{
	shroom_prog++;
	if(shroom_prog >= 2)
	{
		if(ThingCountName("HighPipeGuy", 140) == 3)
		{
			ScriptCall("DFPlayer", "GiveExaltation", 500);
		}
		Thing_Remove(73);
		Thing_Remove(140);
	}
	Delay(35*3);
	if(var == 0)
	{
		FadeTo(255, 255, 255, 0.0, 6.0);
	}
	else
	{
		FadeTo(0, 0, 0, 0.0, 6.0);
	}
	ScriptCall("DFPlayer", "SetHud", TRUE);
	ChangeCamera(0, 0, 0);
	ScriptCall("DFPlayer", "GiveExaltation", 100);
	Delay(35*6);
	SetPlayerProperty(0, 0, PROP_TOTALLYFROZEN);
	if(shroom_prog < 2)
	{
		SetLineSpecial(137, 18, 73, 1, 0, 0, 0);
	}
	Delay(3);
	StartConversation(73, 1);
}