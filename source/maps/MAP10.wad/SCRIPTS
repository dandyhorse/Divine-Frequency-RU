Script "Cutscene_Skip" (int skip, int activate)
{
	int buttons;

	while (TRUE)
	{
		buttons = GetPlayerInput(-1, INPUT_BUTTONS);

		if(buttons & BT_JUMP)
	    {
			ACS_Terminate(skip, 0);
			ACS_Execute(activate, 0);
			break;
	    }
		delay(1);
	}
}

