	Delay(20);

	//Activate Boss Music
	Thing_Deactivate(34);
	SetMusic("MP1_BOSS");
	HudMessageBold(s:"Inside the depth, you see a great storm in the darkness...";
	0, 1, CR_UNTRANSLATED, 1.5, 0.5, 4.0);
	Delay(47);
	LocalAmbientSound("Thunder0", 127);
	Delay(93);

	HudMessageBold(s:"Quiet your mind and brace for the oncoming waves.";
	HUDMSG_FADEOUT, 1, CR_UNTRANSLATED, 1.5, 0.5, 2.0, 1.0);
	ChangeActorPitch(0, 0.25);
	if(CheckInventory("Trenchgun") <= 0)
	{
		GiveInventory("Trenchgun", 1);
	}
	if(CheckInventory("ShotgunAmmo") <= 0)
	{
		GiveInventory("ShotgunAmmo", 3);
	}
	if(CheckInventory("PistolAmmo") <= 0)
	{
		GiveInventory("PistolAmmo", 8);
	}
	Delay(1);
	GiveInventory("Duel_Prep", 1);
	SetWeapon("Trenchgun");
	Delay(22);
	ScriptCall("DFPlayer", "QuietLand", TRUE);
	Light_ChangeToValue(79, 0);
	Teleport_NoFog(12, 1, 31);
	GiveInventory("LanternKill", 1);
