Script "Light_Flash" (int level)
{
	if(level == 0)
	{
		Light_Stop(63);
		Light_Stop(64);
		Delay(1);
		Light_ChangeToValue(63, 136);
		Light_ChangeToValue(64, 168);
		Delay(1);
		Light_Fade(63, 0, 105);
		Light_Fade(64, 136, 105);
	}
	else if(level == 1)
	{
		Light_Stop(63);
		Light_Stop(64);
		Delay(1);
		Light_ChangeToValue(63, 0);
		Light_ChangeToValue(64, 136);
		Delay(1);
		Light_Fade(63, 136, 25);
		Light_Fade(64, 168, 25);
	}
	else if(level == 2)
	{
		SetActorState(100, "Spawn", FALSE);
		Delay(14);
		SetActorState(65, "Spawn", FALSE);
	}
	else if(level == 3)
	{
		Light_Stop(63);
		Light_Stop(64);
		Delay(1);
		Light_ChangeToValue(63, 152);
		Light_ChangeToValue(64, 184);
		Delay(1);
		Light_Fade(63, 0, 175);
		Light_Fade(64, 136, 175);
	}
	else if(level == 4)
	{
		Light_Stop(63);
		Light_Stop(64);
		Delay(1);
		Light_ChangeToValue(63, 160);
		Light_ChangeToValue(64, 192);
		Delay(1);
		Light_Fade(63, 0, 175);
		Light_Fade(64, 136, 175);
		Delay(20);
		SetActorState(100, "Spawn", FALSE);
	}
}

