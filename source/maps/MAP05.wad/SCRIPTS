Script 4 (void)
{
	//Prompt tutorial
	ScriptCall("GenericScreenStuff", "PromptTutorial", "Tip_DuelHelp");

	//Prepare the reward
	ACS_Execute(39, 0);

	//Code
	SetLineSpecial(37, 0);
	SetPlayerProperty(0, 1, PROP_TOTALLYFROZEN);
	ScriptCall("DFPlayer", "MusicFade", 0.0, 50);
	Delay(1);
	FadeTo(0, 0, 0, 1.0, 2.0);
	Delay(35*2);
	ChangeCamera(35, 1, 0);
	Delay(35*2);
	LocalAmbientSound("Duel01", 65);
	SetMusic("D_NULL");
	Delay(35);
	ScriptCall("DFPlayer", "MusicFade", 1.0, 0);

	//Prompt
	SetFont(const:"ACS_FONT");
	HudMessageBold(s:"You begin to submerge into an otherworldly depth.";
	0, 1, CR_UNTRANSLATED, 1.5, 0.5, 3.0);
	Delay(1);
	ScriptCall("GenericScreenStuff", "Clean");
	Delay(35*3);

	HudMessageBold(s:"Submerging in complete blackness as your mind becomes the envoy between worlds.";
