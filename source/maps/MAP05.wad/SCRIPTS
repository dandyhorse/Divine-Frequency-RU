	{
		ScriptCall("GenericScreenStuff", "PromptTutorial", "Tip_DuelPhy");
	}
	else if(CheckInventory("StrToken") > 0)
	{
		ScriptCall("GenericScreenStuff", "PromptTutorial", "Tip_DuelStr");
	}
	Delay(22);
	ChangeCamera(0, 1, 0);
	FadeTo(0, 0, 0, 0.0, 1.0);
}

