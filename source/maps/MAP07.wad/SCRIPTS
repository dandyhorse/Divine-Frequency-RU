Script 03 (int sectag) //Transition to basement
{
	CancelFade();
	ScriptCall("DFPlayer", "MusicFade", 0.0, 100);
	LocalAmbientSound("DoorTP3", 127);
	SetPlayerProperty(1,1,0);
	SetActorProperty(0, APROP_Invulnerable, TRUE);
	FadeTo(0, 0, 0, 1.0, 0.5);
	Delay(35);
	Teleport_NoFog(sectag, 1, sectag);
	if(sectag == 14)
	{
		GiveInventory("DustSpawnerBudget", 1);
		Thing_Activate(16);
		Thing_Activate(191); //Drips
	}
	else
	{
		TakeInventory("DustSpawnerBudget", 1);
	}
	Delay(50);
	LocalAmbientSound("DoorTP4",127);
	if(sectag == 14)
	{
		SetMusic("MP2_A2");
		Thing_Activate(13);
	}
	else
	{
		SetMusic("D_NULL");
		Thing_Deactivate(13);
		Thing_Deactivate(16);
		Thing_Deactivate(191); //Drips
	}
	Delay(25);
	ScriptCall("DFPlayer", "MusicFade", 1.0, 50);
	FadeTo(0, 0, 0, 0.0, 0.5);
	SetPlayerProperty(1,0,0);
	SetActorProperty(0, APROP_Invulnerable, FALSE);
	if(sectag == 14)
	{
		SetActorPitch(0, 0.05);
	}
	else
	{
		SetActorPitch(0, 0);
	}
}

