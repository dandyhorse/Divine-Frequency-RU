Script "Init" ENTER
{
	if(GetUserCVar(0, "dev_debug") == 0)
	{
		FadeTo(0, 0, 0, 1.0, 0.0);
		Delay(20);
		LocalAmbientSound("DoorTP12", 100);
		Delay(4);
		FadeTo(0, 0, 0, 0.0, 1.0);
		SetPlayerProperty(1,0,4);
		ScriptCall("DFPlayer", "SetLocation", "Buried Level");
		ScriptCall("DFPlayer", "MusicFade", 1.0, 0);
		ScriptCall("GenericScreenStuff", "Clean");
		ACS_NamedExecute("Autosave", 0);
	}
	Delay(1);
	if(CheckInventory("SprayCan") > 0)
	{
		Thing_Remove(29);
	}
}

