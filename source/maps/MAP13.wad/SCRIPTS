Script "Init" ENTER
{
	if(GetCVar("dev_debug") == 0)
	{
		fadeto(0, 0, 0, 1.0, 0.0);
		GiveInventory("MidZone", 1);
		Delay(35);
		Teleport_NoFog(41, 1, 0);
		LocalAmbientSound("DoorTP2",127);
		fadeto(0, 0, 0, 0.0, 0.5);
		SetPlayerProperty(1,0,0);
		Delay(20);
		ScriptCall("DFPlayer", "MusicFade", 1.0, 0);
		SetMusic("MP2_D3");
		ScriptCall("Saver", "Autosave");
	}
}

