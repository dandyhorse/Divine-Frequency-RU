Script "Entrance" (void)
{
	Delay(140);
	PlaySound(200, "Arena00B", CHAN_BODY, 0.01, 0, 0.15);
	Delay(128);
	ACS_NamedExecute("FadeCrowd", 0);
	LocalAmbientSound("Arena00", 127);
	Delay(46);
	PlaySound(201, "Arena00A", CHAN_AUTO, 0.6, 0, 0.1);
	Delay(30);
	//Delay(35); //Remove later
	//SetMusic("MP2_BOS1");
	SpawnSpot("DS_Music_01", 25, 25, 0);
	GiveInventory("Duel_Prep", 1);
	if(CheckInventory("ShotgunAmmo") <= 0)
	{
		GiveInventory("ShotgunAmmo", 3);
		GiveInventory("ShellLoaded", 5);
	}
	if(CheckInventory("PistolAmmo") <= 0)
	{
		GiveInventory("PistolAmmo", 8);
	}
	ACS_NamedExecute("FadeCrowd2", 0);
	Delay(10);
	ACS_NamedExecute("Torch", 0);
	Delay(22); //28 total
	ACS_NamedExecute("Lightz", 0);
	Delay(6);
	PlaySound(202, "Arena00C", CHAN_AUTO, 0.5, 0, 0.08);
	//
	Delay(160);
	SpawnSpot("Stars", 10, 1000, 0);
	//Do tutorial if we's really them boys!
	if(CheckInventory("PhyOrigin") > 0)
	{
		ScriptCall("GenericScreenStuff", "PromptTutorial", "Tip_DuelPhy");
	}
	else if(CheckInventory("StrToken") > 0)
	{
		ScriptCall("GenericScreenStuff", "PromptTutorial", "Tip_DuelStr");
	}
	Delay(245);
	SetActorState(1000, "IntroUltWait", 0);
	Delay(67);
	SetActorState(1000, "IntroUltEnd", 0);
	Delay(22);
	SpawnSpot("DS_Music_02", 26, 26, 0);
	Delay(46);
	SetMusic("MP2_BOS1");
	Delay(30);
	if(GetActorProperty(0, APROP_Health) > 20)
	{
		ScriptCall("Saver", "Autosave");
	}
}


