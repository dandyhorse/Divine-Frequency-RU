Script "Phase3Lighting" (void)
{
	ACS_Execute(2, 0);
	FadeRange(255, 76, 211, 0.3, 0, 0, 0, 0.0, 2.0);
	Thing_Activate(667);
	Thing_Deactivate(18);
	Thing_Deactivate(19);
	Light_Glow(16, 128, 104, 35);
	Light_ChangeToValue(17, 64);
	Light_ChangeToValue(18, 128);
	while(TRUE)
	{
		Thing_Deactivate(41);
		Thing_Activate(40);
		Delay(40);
		Thing_Deactivate(40);
		Thing_Activate(41);
		Delay(40);
	}
}

