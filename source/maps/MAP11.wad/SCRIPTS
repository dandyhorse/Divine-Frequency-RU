Script "Lightz" (void)
{
	Thing_Activate(20);
	for(int n = 400; n <= 404; n++)
	{
		Thing_Activate(n);
		Delay(2);
	}
	for(n = 0; n <= 5; n++)
	{
		Thing_Deactivate(400);
		Thing_Deactivate(401);
		Thing_Deactivate(402);
		Thing_Deactivate(403);
		Thing_Deactivate(404);
		Delay(2);
		Thing_Activate(400);
		Thing_Activate(401);
		Thing_Activate(402);
		Thing_Activate(403);
		Thing_Activate(404);
		Delay(2);
	}
}

