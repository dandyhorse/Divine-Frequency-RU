#include "zcommon.acs"

script "Init" ENTER
{
	GiveInventory("RetroDisabler", 1);
	FadeTo(0, 0, 0, 1.0, 0.0);
	Delay(35);
	FadeTo(0, 0, 0, 0.0, 4.0);
	ChangeCamera(1, 1, 0);
	Delay(35*6);
	FadeTo(0, 0, 0, 1.0, 2.0);
	Delay(35*3);
	ScriptCall("ShaderHandler", "SetColorGlitch", TRUE);
	SetMusic("Title1");
	Delay(35);
	FadeTo(0, 0, 0, 0.0, 8.0);
	ChangeCamera(5, 1, 0);
	ACS_Execute(1, 0);
	Delay(35*2);
	ScriptCall("GenericScreenStuff", "StartupInput");
}

Script 1 (void)
{
	while (TRUE)
	{
		Delay(35 * random(12,15));
		Thing_Activate(2);
		Thing_Activate(3);
		GiveInventory("HighZone", 1);
		GiveInventory("RetroEnabler", 1);
		Delay(35 * random(7,8));
		Thing_Deactivate(2);
		Thing_Deactivate(3);
		GiveInventory("LowZone", 1);
		Delay(1);
		GiveInventory("RetroDisabler", 1);
	}
}