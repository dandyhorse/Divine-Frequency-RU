Script "Train_Door" (int sectag, int set_dust)
{
	CancelFade();
	if(set_dust == 0)
	{
		TakeInventory("DustSpawner", 1);
	}
	LocalAmbientSound("TrainTP", 88);
	SetPlayerProperty(1,1,4);
	SetActorProperty(0, APROP_Invulnerable, TRUE);
	fadeto(0, 0, 0, 1.0, 0.3);
	Delay(10);
	Teleport_NoFog(sectag, 1, 0);
	if(set_dust == 1)
	{
		GiveInventory("DustSpawner", 1);
	}
	Delay(12);
	fadeto(0, 0, 0, 0.0, 0.4);
	SetPlayerProperty(1,0,4);
	SetActorProperty(0, APROP_Invulnerable, FALSE);
}

Script "Train_End" (void)
{
	//Fade Out
	FadeTo(0, 0, 0, 1.0, 6.0);
	for(int i = 75; i > 0; i--)
	{
		SoundVolume(212, CHAN_BODY, 0.01 * i);
		Delay(2);
	}
	ScriptCall("DFPlayer", "MusicFade", 0.0, 100);
	Delay(105);
	SetMusic("D_NULL");
	SetPlayerProperty(0, 1, PROP_TOTALLYFROZEN);
	Delay(35);
	Exit_Normal(0);
}

Script "Train_FadeOut" (void)
{
	for(int i = 75; i > 0; i--)
	{
		SoundVolume(212, CHAN_BODY, 0.01 * i);
		Delay(2);
	}
}

Script "Train_FadeIn" (void)
{
	for(int i = 0; i < 75; i++)
	{
		SoundVolume(212, CHAN_BODY, 0.01 * i);
		Delay(2);
	}
}

