Script "Short_Circuit" (void)
{
	if(!bypass)
	{
			ACS_NamedTerminate("Light_Cycle", 0);
			bypass = TRUE;
			Light_Stop(15);
			Light_Stop(33);
			Ceiling_LowerByValue(121, 4, 74);
			SpawnSpot("ShortCircuitFX", 124, 0, 0);
			SetActorState(123, "Active", 0);
			PlaySound(124, "ElecHit1", CHAN_BODY, 0.7);
			PlaySound(123, "Stun/Active", CHAN_BODY, 0.7);
			for(int i = 0; i < 4; i++)
			{
				PlaySound(125, "ElecPop1", CHAN_AUTO, 1.0);
				Delay(random(10,24));
			}
			Light_ChangeToValue(15, 152);
			Light_ChangeToValue(33, 144);
			Thing_Activate(34);
			StopSound(123, CHAN_BODY);
			SetActorState(123, "Spawn", 0);
	}
}

int flip = 0;
int flip_countdown = 0;
int flip_goal = 1;
int flip_seq = 0;

Script "Flip" (void)
{
	if(flip == 0)
	{
		ACS_NamedExecute("Flip_Init", 0);
	}
	flip++;
	flip_countdown = 20;
}

Script "Flip_Init" (void)
{
	while(flip_countdown > 0)
	{
		//print(d:flip_countdown);
		Delay(1);
		flip_countdown--;
	}
	if(flip_countdown == 0)
	{
		ACS_NamedExecute("Flip_Check", 0);
	}
}

Script "Flip_Check" (void)
{
	if(flip == flip_goal)
	{
		flip_seq++;
		flip = 0;
		if(flip_seq == 1)
		{
			flip_goal = 5;
			Thing_Activate(263);
			PlaySound(263, "Hack_01", CHAN_AUTO, 0.5, 0, 0.5);
		}
		else if(flip_seq == 2)
		{
			flip_goal = 4;
			Thing_Deactivate(263);
			Thing_Activate(264);
			PlaySound(263, "Hack_01", CHAN_AUTO, 0.5, 0, 0.5);
		}
		else if(flip_seq == 3)
		{
			Thing_Deactivate(264);
			Thing_Activate(265);
			ACS_NamedExecute("Short_Circuit", 0);
		}
	}
	else
	{
		flip = 0;
		flip_goal = 1;
		flip_seq = 0;
		Thing_Deactivate(263);
		Thing_Deactivate(264);
		Thing_Deactivate(265);
	}
}

