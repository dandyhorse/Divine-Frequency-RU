int t_charge = 4;
Script 4 (void)
{
	if(t_charge > 0)
	{
		SpawnSpot("GaryEnergyBurst", 51, 999, 0);
		t_charge--;
		switch(t_charge)
		{
			case 3:
			Thing_Deactivate(200);
			break;
			case 2:
			Thing_Deactivate(201);
			break;
			case 1:
			Thing_Deactivate(202);
			break;
			case 0:
			Thing_Deactivate(203);
			Thing_Deactivate(56);
			break;
		}
		SetFont (const:"ACS_FONT");
		HudMessage(s:"Electrifying Containment Field deployed.\n", d: t_charge, s:" out of 4 charges available."; 0, 1, CR_WHITE, 1.5, 0.85, 5.0);
	}
	else
	{
		SetFont (const:"ACS_FONT");
		HudMessage(s:"Insufficient charge."; 0, 1, CR_WHITE, 1.5, 0.1, 5.0);
	}
}

