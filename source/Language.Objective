[enu default]
Obj_00 = "\cU·Travel to 39°59'0''N 43°59'0''W.";
Obj_01 = "\cU·According to the creepy skeleton, what you seek can be found by ''Turn around. Go first right. Then up. Then more down. Below the benthic -- inside one frame of time, is destination.''";
Obj_02 = "\cU·Find a way to 37.5°0'0''N 36.5°0'0''W.";
Obj_03 = "\cU·Search for the lowest point at 37.5°0'0''N 36.5°0'0''W.";
Obj_04 = "\cU·A refrigerator is promising a reward in exchange for a peculiar artifact that could be found far below. You can ignore this request, but having some extra firepower never hurts.";
Obj_05 = "\cU·Continue searching for the lowest possible point at 37.5°0'0''N 36.5°0'0''W.";
Obj_06 = "\cU·Confront what lurks below.";