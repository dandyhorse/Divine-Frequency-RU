Tu_Sprint = "Useful for creating a safe distance against attacker(s).";
Tip_Ammo = "Tip: \cFHigh-Explosive\cJ rounds are very effective against most creatures, yourself included.";
Tip_Condition = "\cDTip: \cJMost weapons degrade as they fire. \cFRepair is vital\cJ to preserving functionality.";
Tip_Icon = "\cDPreference: \cFInteraction Icons \cJcan be disabled in the Accessibility Option Menu.";
Tip_Injector = "\cDTip: \cJThe \cGPsykhus Injector \cJis an extremely potent healing item. Refills are very rare, so use it wisely!";
Tip_Parry = "\cDTip: \cJGhosts are vulnerable to \cFResonance Break\cJ: Firing your \cDTrench Gun\cJ in the middle of their attacks will inflict catastrophic damage.";
Tip_Weapon = "In-depth information about weapons can be accessed from the inventory menu.";
Tip_DuelEnd = "\cDTip: \cJDuels can be exited at any time by using the 'Exit Duel' item in the inventory.\n\n";
Tip_DuelHelp = "\cDPreference: \cJThe attack timing for \cIResonance Break\cJ can be \cDextended\cJ in the Accessibility Option Menu.";
Tip_DuelStr = "\cDTip: \cJYour \cFStrength\cJ allows you to inflict Resonance Break with your \cDFists\cJ as well as your \cDTrench Gun\cJ.";
Tip_DuelPhy = "\cDTip: \cJYour chosen waveform \cF(Chaotic Vibration)\cJ allows you to bypass all damage resistance in this challenge.";