OptionMenu "DFDisplayOptions" protected
{
	Title "$DSPLYMNU_TITLE"
	Class "DescriptorMenu"
	DescriptionFont "ACS_FONT"
	AnimatedTransition

	SubMenu "$VIDMNU_RESPRESET", NewResolutionMenu
	Description "$DESC_RESPRESET"
	TextField "Resolution Width", menu_resolution_custom_width
	TextField "Resolution Height", menu_resolution_custom_height
	Option "$VIDMNU_FORCEASPECT",		"vid_aspect", 			"ForceRatios"
	Description "$DESC_FORCEASPECT"
	Option "$VIDMNU_CROPASPECT",		"vid_cropaspect", 		"CropAspect"
	Description "$DESC_FORCERATIOSTYLE"
	SafeCommand "$VIDMNU_APPLYW", "menu_resolution_commit_changes 0"
	SafeCommand "$VIDMNU_APPLYFS", "menu_resolution_commit_changes 1"
	StaticText ""
	
	Slider "$DSPLYMNU_BRIGHTNESS",		vid_whitepoint,    		-1.0, 1.0, 0.01, 2
	Description "$DESC_BRIGHTNESS"
	Slider "$DSPLYMNU_FOV",				"fov",					75.0, 120.0, 0.1, 1
	Description "$DESC_FOV"
	Option "VHS Intensity", 			"vhs_strength", 		"vhss"
	Description "$DESC_VHS"
	Option "VHS Tearing", 				"vhs_scroll", 			"OnOff"
	Description "$DESC_VHSTear"
	Option "$GLPREFMNU_BLOOM",		 	gl_bloom, 				"OnOff"
	Description "$DESC_BLOOM"
	Option "$GLPREFMNU_SSAO",		 	gl_ssao,				"SSAOModes"
	Description "$DESC_SSAO"
	Option "$GLTEXMNU_TEXFILTER",		gl_texture_filter,		"FilterModes"
	Description "$DESC_TEXFILTER"
	Option "$GLTEXMNU_PRECACHETEX",  	gl_precache, 			"OnOff"
	Description "$DESC_PRECACHE"
	Option "HUD Size",					"vid_scalefactor", 		"hudScale"
	Description "$DESC_SCALEFACTOR"
	Slider "$HUDMNU_CROSSHAIRSCALE",    "crosshairscale", 		0.5, 3.0, 0.1
	Description "$DESC_CROSSHAIRSCALE"
	StaticText ""
	
	Slider "$VIDMNU_MAXFPS",			"vid_maxfps", 			35, 500, 1
	Description "$DESC_MAXFPS"
	Slider "$DSPLYMNU_CONTRAST",        vid_contrast,      		0.5, 2.0, 0.01, 2
	Description "$DESC_CONTRAST"
	Slider "$DSPLYMNU_SATURATION",      vid_saturation,    		-1.0, 2.0, 0.01, 2
	Description "$DESC_SATURATION"
	StaticText ""
	
	SafeCommand	"$OPTMNU_DEFAULTS",		"reset2defaults"
}

