[enu default]
M01_Box = "Suspicious Box";
M01_Box01 = "\cDYou could've sworn you saw the box move. Whatever's inside the box is making a barely audible gurgle.";
M01_Box01a = "\cD[Examine the box]";
M01_Box01b = "\cQ(Leave) \cJEw, no.";

M01_Box02 = "\cDA broken, raspy, and pained voice emerges from the box.\n\n"
"\cJW..Wait... d-don't... come ... closer...";
M01_Box02a = "Why are you hiding in a box?";

M01_Box02_1 = "I... I'm only trying... to... hide. Th-there's things here. Y-you... have seen them. Y-you... are one of them... They a-are lu-lured here by its presence.";
M01_Box02_1a = "They're all dead now.";
M01_Box02_1b = "You're mistaken. I'm only passing through.";
M01_Box02_1c = "\cD[Laugh maniacally]\cJ YOUR LIFE ENDS NOW!!";
M01_Box02_1d = "\cQ(Leave) \cDLeave the box alone.";

M01_Box03 = "\cDA brief pause. You know whatever's inside is examining what has to be your feet from inside the box.\n\n"
"\cJP-please. I... am... hungry.";
M01_Box03a = "I'll feed you. But in exchange I want information.";

M01_Box031_1 = "Y-Yes!... Anything... please... \cDA kind of brownish ooze leaks from the opening.";
M01_Box031_2 = "NO! NO!!! P-PLEASE!. I... I-I am...";
M01_Box031a = "\cD[Offer a Ration]";
M01_Box031b = "\cD[Offer a Can of Fruit]";
M01_Box031c = "\cD[Offer a Can of Mystery Meat]";
M01_Box031d = "\cD[Offer a Psi shroom]";
M01_Box031e = "\cD[Offer a Repair Kit]";
M01_Box031f = "\cD[Offer a Gun Oil]";

M01_Box032_2 = "I-I can't eat this...";

M01_Box032_3 = "E-eeww... okay.... \cD*Gulps*";
M01_Box032_3a = "Well?";

M01_Box033 = "\cDThe box is silent. It's probably dead.";

M01_Box04 = "\cDA tendril of rapidly dissolving flesh lashes out of the box at a blindingly fast speed, snatching the food off the lid. "
"You can hear the box hastely devouring the food package.\n\n\cJMmm...";
M01_Box04a = "\cD[Explain your mission] \cJTell me everything you know.";
M01_Box05 = "\cDThe box's breathing quickens. There appears to be something eerie about the nature of your request.\n\n"
"\cJD-don't... remember. C-can't be too far... I... I c-can't walk, see... It's b-been a long... while... crawling a-and falling... though.\n\n"
"\cDAn awkward silence takes hold of the room, and you get the impression that whatever's inside the box is afraid to speak.";
M01_Box05a = "You're hiding something.";
M01_Box05b = "\cQ(Leave) \cDLeave the matter be.";

M01_Box06 = "N-no. I-I... I can't.. Please....";
M01_Box06a = "\cQ[Strength] \cDKick the box.";
M01_Box06b = "\cQ[Strength] \cDScream at the box.";
M01_Box06c1 = "\cQ[Wits] \cDInvade the box's mind.";
M01_Box06c2 = "\cQ[Wits] \cJI have not hurt you, I even aided you when asked. Answer me and I'll leave you be.";
M01_Box06d1 = "\cQ[Physique] \cDOpen the box and take off your mask, revealing your face. \cJLiiiiies....";
M01_Box06d2 = "\cQ[Physique] \cDPut your hand on the box. \cJDon't worry, I won't hurt you. I'm more like yoouu. Seeee?";
M01_Box06e = "\cQ(Leave) \cJOkay, this is getting weird. I'm out of here.";

M01_Box06da = "\cDThe box recoils in disgust. \cJE-e-eww... Um... N-no, not... really... T-thank the... gods...";

M01_Box07_01 = "AAHH!!!!\n\nI-impor...tant! Knowledge! From h-h-Heavens! L-lost! P-please! I'm... scared!\n\n";
M01_Box07_01b = "Wa-Wait!!\n\nThere are... I-impor...tant! Knowledge! From h-h-Heavens! L-lost! P-please! I'm... scared!\n\n";

M01_Box07_02 = "\cDThe box stiffens a bit, as if wary. "
"\cJIt's... a commu-nication from the h-h-Heavens... F-Forbidden... knowledge. O-or, at... least... f-f-forgotten. By m-most of... us. "
"I...I've been trying to climb... my... way out... for as long as I remember... away from the labs. "
"W-well... T-the lab I used... to w-work in h-had a comms... array. M-maybe there?\n\n"
"\cDThe box deflates in what you consider a sign of relief. \cJVery... important.";
M01_Box07_02b = "\cDThe box stiffens a bit, as if wary. "
"\cJOkay-okay... There is... a commu-nication from the h-h-Heavens... F-Forbidden... knowledge. O-or, at... least... f-f-forgotten. By m-most of... us. "
"I...I've been trying to climb... my... way out... for as long as I remember... away from the labs. "
"W-well... T-the lab I used... to w-work in h-had a comms... array. M-maybe there?\n\n"
"\cDThe box deflates in what you consider a sign of relief. \cJVery... important.";

M01_Box07a = "Wait, that's it?";
M01_Box07b = "\cQ(Leave) \cDThank the box and apologize for your hostile actions.";
M01_Box07c = "\cQ(Leave) \cJI see. Thank you.";
M01_Box07d = "\cQ(Leave) \cDWalk away.";

M01_Box08 = "Y-Yes... Please... I am t-tired.";

M01_Box09 = "\cDThe box hesistantly examines the mushroom with great care... Then shortly after, you hear a munch.\n\n"
"Shortly, there is a new wet gurgling noise coming from the box. Its voice deepening into a near inaudible pitch. "
"Every word spoken echoing off into some unseen void around you...";
M01_Box09a = "\cQ(See what happens)";

M01_BoxFinal = "\cDThe box is silent.";
M01_BoxScript01 = "\"Ha.\"";
M01_BoxScript02 = "\"Ha. ..ha ha..\"";
M01_BoxScript03 = "\"Ha. ..ha ha.. ha.\"";
M01_BoxScript04 = "\"A light...\"";
M01_BoxScript05 = "\"A light to find your way back from the dream...\"";
M01_BoxScript06 = "\"...If only you had eyes to find it.\"";