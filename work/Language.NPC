[ru]
Next = "\cQДалее";
Back = "\cQНазад";
Leave = "\cQ(Уйти)";
Silent = "\cD[Промолчать]";
Ask = "Я хотел спросить тебя кое о чём ещё.";
Nvm = "Забудь.";

Background = "ПРЕДЫСТОРИЯ";
Intro_Name = "СМЕРТЬ";
Intro_New_Title = "ЛИСТ ПЕРСОНАЖА";
Intro_New_00 = "\cDТы мёртв...";
Intro_New_01 =
"\cDНо три различных колебания ненадолго возвращают тебя к сознанию. Они звучат в космосе безмолвным "
"ансамблем. Гармонии оставляют неизгладимый след в твоих чувствах и зарождающемся разуме.\n\n"
"Эти вибрации, как и ты, угасают. Ты должен синхронизироваться. Выбор одной исключает остальные.";
Intro_New_01a = "\cQ[Инстинкт] \cDНастроиться на низкую вибрацию.";
Intro_New_01b = "\cQ[Инстинкт] \cDНастроиться на высокую вибрацию. \cQ(Рекомендуется)";
Intro_New_01c = "\cQ[Инстинкт] \cDНастроиться на хаотичную вибрацию.";
Intro_New_01a_1 =
"\cFТы чувствуешь силу, полон энергии. Любое сопротивление можно сокрушить голыми руками, любой поток укротить своей мощью.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Атаки в ближнем бою становятся мощными. Тебе не обязательно полагаться только на огнестрельное оружие.\n"
"·Убийство врага в ближнем бою восстанавливает значительное количество здоровья.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Твой лимит переноски патронов и расходников сильно ограничен.\n\n"
"\cJЭта вибрация дарует тебе \cF+1 к Силе\cJ, что определяет урон в ближнем бою, расход выносливости и контроль отдачи.";
Intro_New_01b_1 =
"\cFТы ощущаешь врождённое понимание всех систем и устройств. Будь то абстракция машинных кодов или механическая "
"сложность огнестрельного оружия — ты прекрасно понимаешь, как работает большинство вещей.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Тебе легче замечать расходники. Ты также можешь обнаруживать секреты и засады.\n"
"·Твой псионический потенциал позволяет получать больше психической силы.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Ты слаб. Твоё максимальное здоровье снижено, а атаки в ближнем бою почти бесполезны.\n\n"
"\cJЭта вибрация дарует тебе \cF+1 к Разуму\cJ, что определяет обращение с огнестрельным оружием и способность обходить электронную защиту — "
"это может дать дополнительные припасы и сведения о врагах.";
Intro_New_01c_1 =
"\cFТы не совсем понимаешь, что чувствуешь, если это вообще можно назвать чувством. Ты — всё и ничто. Ты чувствуешь... потребность пожирать.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Ты можешь есть трупы (включая мёртвых врагов), чтобы эволюционировать и мутировать. Мутация позволяет развивать наступательные и защитные биологические способности.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Ты не можешь получать модификации оружия.\n"
"·Твои атаки в ближнем бою почти бесполезны.\n\n"
"\cJЭта вибрация дарует тебе \cF+1 к Телосложению\cJ, что определяет твою устойчивость к радиации и токсинам.";
Intro_New_02a = "\cQ[Инстинкт] \cDПочувствовать влечение к низкой вибрации.";
Intro_New_02b = "\cQ[Инстинкт] \cDПочувствовать влечение к высокой вибрации.";
Intro_New_02c = "\cQ[Инстинкт] \cDПочувствовать влечение к хаотичной вибрации.";
Intro_New_Ready = "\cQ[Инстинкт] \cDСвязать свою онтологическую природу и пробудиться.";
Intro_New_Back = "\cQ[Инстинкт] \cDОтстраниться от этого ощущения (Назад).";
Intro_Cheater = "Крутые боги вселенной Divine Frequency";
Intro_Cheater01 = 
"ЭТО. БЫЛО. ОХРЕНИТЕЛЬНО!! Либо ты жульничал, либо у тебя серьёзные навыки! Но серьёзно, что мы можем сказать? "
"Это было впечатляюще! Ты грязный дикий зверь, поставивший этого мерзкого ублюдка на место.\n\n"
"В любом случае, прочитай эту классную брошюру.";

Intro =
"Добро пожаловать в мир Divine Frequency!\n\n"
"Впереди множество ужасных и злобных способов быть убитым. Разбитые умы и зловещая геометрия одинаково бродят по этому головокружительному кошмару. "
"Но там, в преисподней... в бездне, изобилуют Сокровища и Вечная Жизнь!\n"
"Прежде чем отправиться в неизвестность, ты должен ВЫБРАТЬ СВОЕГО БРОДЯГУ:\n\n"
"Рассмотри \cFТерминатора уличных боёв кунг-фу гориллу\cJ:\n"
"\cD''Отточи свою механическую анатомию до смертоносной точности. Убери границы между разумом и телом...''\n\n\cJ"
"Или \cFМагического эксперта по оружию волшебника\cJ:\n"
"\cD''Погрузись глубже в тонкости космических гармоний. Синхронизируй мысли с материей...''\n\n\cJ"
"Или, для тех, кто ищет более пикантный вариант, \cFПотусторонний монстр\cJ:\n"
"\cD''Прими безумие за пределами биологии. Управляй курсом своей эволюции...''";
Intro_a = "\cDРассмотреть \cFТерминатора уличных боёв кунг-фу гориллу";
Intro_b = "\cDРассмотреть \cFМагического эксперта по оружию волшебника";
Intro_c = "\cDРассмотреть \cFПотустороннего монстра";
Intro_1a = "\cDПодтвердить \cFТерминатора уличных боёв кунг-фу гориллу \cDи открыть глаза...";
Intro_1b = "\cDПодтвердить \cFМагического эксперта по оружию волшебника \cDи открыть глаза...";
Intro_1c = "\cDПодтвердить \cFПотустороннего монстра \cDи открыть глаза...";
Intro_1d = "\cQВернуться назад и позволить этому сну продолжаться.";

Intro_STR = 
"\cFДревний чемпион племени Просвещённых, ты — могучий воин, чья душа была благословлена самой Божественной Частотой. "
"Твоя живучесть и регенерация позволяли тебе выходить победителем из изнурительных и смертельных схваток, которые одолели бы даже самых "
"стойких хищников.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Атаки в ближнем бою становятся мощными. Тебе не обязательно полагаться только на огнестрельное оружие.\n"
"·Убийство врага в ближнем бою восстанавливает значительное количество здоровья.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Твой лимит переноски патронов и расходников сильно ограничен.\n\n"
"\cJЭтот бродяга получает \cF+1 к Силе\cJ, что определяет урон в ближнем бою, расход выносливости и контроль отдачи.";

Intro_STR2 =
"\cFРодившись в диком мире, ты быстро понял, что слова ничего не значат, — важны только действия. "
"Твоя готовность действовать не оставляет места сомнениям и позволяет уничтожать множество врагов в лоб. "
"Мир может восстать против тебя всепоглощающей тьмой, но твой дух всегда осветит "
"путь вперёд. Это благословение добыто в прошлых шаманских ритуалах смерти — путешествиях, открывших "
"твоей душе мир внутри и мир за его пределами.\n\n"
"\cDТВОЁ ПОСЛЕДНЕЕ ВОСПОМИНАНИЕ:\n"
"\cJТы шёл по туннелям нижних уровней, мышцы на взводе, готовый ответить "
"тем же на любую угрозу. В тёмных ямах, затопленных нечистотами, таится множество созданий, и здесь "
"убивают ради еды или умирают, чтобы стать едой.\n\n"

"Но ты помнишь, что нашёл что-то. Ты не знал, что это было, но был уверен, что оно твоё. Это "
"был первый раз, когда ты уснул в мире за слишком много лет...";

Intro_WIT =
"\cFДревний культист Хирального Ковенанта, ты — киборг, который впитывает Божественную Частоту "
"через свои тайные механизмы и цепи. Твой интеллект и сенсорное восприятие позволяют раскрывать "
"слои мира — его секреты и запутанные сложности ложатся в твою руку, чтобы повелевать ими.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Тебе легче замечать расходники. Ты также можешь обнаруживать секреты и засады.\n"
"·Твой псионический потенциал позволяет получать больше психической силы.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Ты слаб. Твоё максимальное здоровье снижено, а атаки в ближнем бою почти бесполезны.\n\n"
"\cJЭтот бродяга получает \cF+1 к Разуму\cJ, что определяет обращение с огнестрельным оружием и способность обходить электронную защиту — "
"это может дать дополнительные припасы и сведения о врагах.";

Intro_WIT2 =
"\cFТы родом из Хирального Ковенанта, империи, что некогда держала мир в своей ладони. Ты видел "
"пик золотой эры и её неизбежный спуск в небытие. Обладая вековыми "
"знаниями и просроченными имплантами, твои чувства настроены за пределы человеческих ограничений. Предельные прорывы "
"позволили тебе заглянуть за иллюзорную завесу вселенной — калибрующая линза, вглядывающаяся в Плерому.\n\n"
"\cDТВОЁ ПОСЛЕДНЕЕ ВОСПОМИНАНИЕ:\n"
"\cJТы бродил по краям нижних уровней, рядом с руинами центров знаний и "
"всеми секретами, которые можно было физически извлечь. Ты проложил себе путь "
"всеми доступными инструментами, но хитрый ум может достичь лишь немногого в этом "
"варварском мире.\n\n"

"Но затем ты нашёл то, что искал. Ты не мог до конца понять это, но знал, "
"что твой поиск завершён. Следующий день должен был начаться с надежды.";

Intro_PHY =
"\cFСбежавший эксперимент из подземных лабораторий, ты — ковыляющий ужас, "
"накачанный Божественной Частотой. И, подобно Божественной Частоте, ты безжалостно "
"пожираешь всё на виду — особенно биомассу, постоянно мутируя и превращаясь в "
"идеальный беспорядок.\n\n"
"\cDПРЕИМУЩЕСТВО:\n"
"·Ты можешь есть трупы (включая мёртвых врагов), чтобы эволюционировать и мутировать. Мутация позволяет развивать наступательные и защитные биологические способности.\n\n"
"\cRНЕДОСТАТОК:\n"
"·Ты не можешь получать модификации оружия.\n"
"·Твои атаки в ближнем бою почти бесполезны.\n\n"
"\cJЭтот бродяга получает \cF+1 к Телосложению\cJ, что определяет твою устойчивость к радиации и токсинам.";

Intro_PHY2 =
"\cFТы — неестественный продукт аберрантных мутаций. Даже твои создатели не совсем уверены, ЧТО ты такое...\n\n"
"\cDТВОЁ ПОСЛЕДНЕЕ ВОСПОМИНАНИЕ:\n"
"\cJТвой побег привёл тебя в ямы под тем местом, что породило тебя. Чувствуя себя уютно в "
"темноте и одиночестве, ты крался по теням, охотясь на плоть и разум всех, кто обращал на тебя "
"взгляд. Отказываясь просто лечь и умереть, твоё бесформенное существование становилось всё более живучим.\n\n"

"Но затем ты нашёл ту часть, которой, как ты знал, не хватало. Каждый твой инстинкт указывал на неё, и теперь, "
"когда она была рядом, выживание больше не казалось таким плохим.";

Spray = "Ремонтный спрей";
Spray_01 =
"\cDНапечатанная на ремонтном спрее этикетка гласит:\n"
"\cU''EZ Fix! Для всех ваших потребностей в ремонте нет ничего лучше EZ Fix! Со стабильным сроком хранения более ста лет — с EZ Fix вы почините всё, что угодно!''";
Spray_01a = "\cD[Починить пистолет]";
Spray_02 =
"\cDДесятилетия износа смываются относительно быстро. Пистолет снова в строю.";

Vial = "Полностью очищенный Психус";
Vial_01 = "\cDДавай. Сделай глоток...";
Vial_01a = "\cD[Выпить полностью очищенный Психус]";
Vial_02 = "\cDТы чувствуешь немедленный и всепоглощающий прилив жизненной энергии. Раны, кажется, затягиваются сами собой, кости встают на место, а дух крепнет, готовый к "
"любому ужасу, что ждёт тебя снаружи.";

ODD_DEVICE_01 =
"\cDЕго присутствие теперь огромно, но мимолётно: оно увядает и пересобирается в невозможные концепции в постоянном ритме.\n\n"
"Пространство за ним почти достижимо. Его небесные огни танцуют в экзотическом узоре, дразня тебя.\n\n...";

ODD_DEVICE_02 =
"\cDРастущий вихрь мыслей становится всё отчётливее. Его постоянное отклонение между языком творения и абсурдом воображения ускоряется до невыносимого темпа.\n\n"
"Это неоспоримо. Это сердцебиение Божественной Волны. Одна лишь капля, огромная для всех рек и морей.\n\n"
"Однако в тисках фрагментированного хаоса одна концепция остаётся ясной. Возможность — самая сырая её сущность.";
