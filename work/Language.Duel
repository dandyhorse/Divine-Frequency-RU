[ru]

Duel = "Порог";
Duel_01a = "\cI[Принять испытание одиночным боем]";
Duel_01c = "\cI[Позвонить в колокол]";
Duel_02 = "\cDЧто такое Дуэль?";
Duel_03 = "\cD[Исследовать это владение]";

DUEL_01_PRE =
"\cDСуществует много туманных стихов и отрывков об ужасном существе, владеющем силой аэромантии.\n\n"
"\cDОдин отрывок предполагает, что оно обитает в плоскости мыслей.";

DUEL_01_DLG_01 =
"\cDЗдесь лежит точка, где могут соединиться два горизонта. То, что скрывается за ней, — конструкция ритуала. "
"Космосы могут говорить друг с другом в этом чудесном пространстве.\n\n"
"Многие до тебя покидали свои тела в поисках общения с другим миром, гонясь за песней, которую наши уши никогда не услышат. "
"Это зов, исходящий на инстинктивном уровне, не отличающийся от реакции выживания.\n\n"
"Но именно в его пике, когда происходит контакт, всех уносит течением.";

DUEL_01_DLG_02 =
"\cDВнутри этого владения — вихрь мыслей. На мгновение вспыхивают фрагменты истины, а следующие за ними "
"ревущие раскаты — заявления о праздновании. Старая дилемма наконец разрешена, новое понятие посеяно... "
"Но им не за что держаться, и потому их уносит обратно во тьму.\n\n"

"В центре этого владения находится существо, резонирующее с божественной гармонией. "
"Это создание пережило ритуал, выдержав бездонную бурю и переполняющий поток небес. "
"Его онтологическое существование — двойственный аспект мира внутри и мира за пределами. Существо воплощает сырую "
"сущность энергии; его агрессия неизбирательна — текущая река жизненной силы, требующая вырваться наружу.";

DUEL_01_DLG_03 =
"\cDДуэли — необязательные боевые встречи с могущественными сущностями, возвысившимися над обычным состоянием бытия. Их мутировавшие тела, "
"переформированные резонансом с высшим порядком, делают их \cRнеуязвимыми к обычному урону\cD.\n\n"
"\cDОднако большинство их атак рассинхронизированы с приливами и отливами этого почти совершенного состояния. Если ты сможешь нанести "
"точную контратаку из \cIтраншейного ружья\cD в середине их атаки, ты вызовешь \cIРазрыв резонанса\cD — "
"перегрузив их чувства и привязав их к твоей реальности.";

DUEL_01_DLG_03B =
"\cDДуэли — необязательные боевые встречи с могущественными сущностями, возвысившимися над обычным состоянием бытия. Их мутировавшие тела, "
"переформированные резонансом с высшим порядком, делают их \cRнеуязвимыми к обычному урону\cD.\n\n"
"\cDОднако большинство их атак рассинхронизированы с приливами и отливами этого почти совершенного состояния. Если ты сможешь нанести "
"точную контратаку из \cIтраншейного ружья\cD в середине их атаки, ты вызовешь \cIРазрыв резонанса\cD — "
"перегрузив их чувства и привязав их к твоей реальности.\n\n"
"\cF(Телосложение) \cDБлагодаря природе твоего происхождения ты можешь игнорировать эти правила. Твой урон всегда будет засчитываться.";

DUEL_02_DLG_01 =
"\cDЗдесь лежит точка, где могут соединиться два горизонта. То, что скрывается за ней, — конструкция единения. "
"Космосы могут говорить друг с другом в этом чудесном пространстве.\n\n"
"Многие до тебя покидали свои тела в поисках общения с другим миром, гонясь за песней, которую наши уши никогда не услышат. "
"Это зов, исходящий на инстинктивном уровне, не отличающийся от реакции выживания.\n\n"
"Но именно в его пике, когда происходит контакт, всех уносит течением.";

DUEL_02_DLG_02 =
"\cDВнутри этого владения лежит воплощение ни дня, ни ночи, а заката и рассвета. Это промежуточное состояние, "
"параллельное смерти, высшей реальности. Образ живой противоборствующей силы — существующей за пределами невообразимой "
"тьмы. Оно по своей природе парадоксально, но истинно во всех смыслах.\n\n"

"В центре этого владения находится дуалистический сосуд, содержащий первобытную женскую и мужскую энергию. "
"Внешняя избранная форма женская, внутренняя незримая форма мужская. Это существо воплощает "
"преобразующее состояние бытия, существуя, чтобы испытывать и выносить на поверхность величайшую опасность, дабы все, кто способен "
"выдержать, могли подняться на новую высоту.";

DUEL_03_DLG_01 =
"\cDЗдесь лежит точка, где могут соединиться два горизонта. То, что скрывается за ней, — конструкция парадокса. "
"Космосы могут говорить друг с другом в этом чудесном пространстве.\n\n"
"Многие до тебя покидали свои тела в поисках общения с другим миром, гонясь за песней, которую наши уши никогда не услышат. "
"Это зов, исходящий на инстинктивном уровне, не отличающийся от реакции выживания.\n\n"
"Но именно в его пике, когда происходит контакт, всех уносит течением.";

DUEL_03_DLG_02 =
"\cDВнутри этого владения — напряжение контраста. Здесь ждёт предельная слепая зона всякого осознания. "
"С краёв форм — смутный образ строится в непостижимых глубинах, изгнанный из двух миров.\n\n"
"В центре этого владения находится существо с перевёрнутой ориентацией. Внешний мир мгновенно сдаёт все "
"свои истины. То, что стоит перед ним, — противоположность: абсурдная, неправильная, нависающая тень.";


DUEL_QUEST =
"\cDЭтот журнал написан на странном языке. Некоторые слова ты узнаёшь, другие — странная мешанина символов.\n\n"
"Ты не можешь в этом разобраться.\n\n"
"Возможно, будет разумно взять его с собой; кто-то мог бы его перевести...";

DUEL_NOTE =
"Вступать в бой с мета-формой жизни класса III — опасное испытание на чувство времени и точность. Среди всех описаний встреч с этими сущностями "
"есть несколько пунктов, с которыми обычно единодушно соглашаются:\n\n"
"\cR-Слепые атаки — короткий путь в могилу. \cJНаблюдай за противником и запоминай его манёвры, прежде чем вступать в бой. "
"\cDБыстрые, короткие уклонения здесь особенно полезны.\n\n"
"\cR-Бегать кругами бесполезно. \cJЭти существа воспринимают время и пространство иначе. Они могут сократить дистанцию за мгновение. Ты лишь потратишь силы.\n\n"
"\cF-У каждого существа есть одна по-настоящему разрушительная атака. \cJЭту атаку нельзя парировать, её можно только избежать своевременным выходом из боя. "
"\cDВоздушный рывок — известный излюбленный приём для такого случая.";
