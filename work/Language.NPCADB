[ru]
//Let your soul contend the tidal waves of reality.
M01_ADB = "Актор Чувак Братан";
M01_ADB01 =
"\cDКогда ты приближаешься к фигуре в капюшоне, то начинаешь ощущать тревожную незащищённость. Инстинкты предупреждают, что на тебя направлено несколько взглядов, "
"хотя в комнате больше никого нет, кроме тебя и этой фигуры.";
M01_ADB01a = "\cD[Игнорировать ощущение] \cJЭй.";
M01_ADB01b = "Я ищу направление.";
M01_ADB01c = "Ты что-то со мной делаешь?";
M01_ADB02 =
"\cDСущество поворачивает к тебе череп. В глазницах нет глаз, но ты чувствуешь, как они изучают тебя.";
M01_ADB02b = "Что ты такое?";
M01_ADB02c = "Ранее я встретил говорящий фонарь, ты тоже умеешь говорить?";
M01_ADB03 =
"\cDОно продолжает смотреть на тебя. Паранойя, которую ты чувствовал раньше, теперь на полную мощность; тебя переполняет инстинкт бежать. "
"В этой груде костей есть что-то глубоко отталкивающее, будто его существование было помещено в этот мир каким-то высшим порядком.\n\n"
"Ты чувствуешь, как в твоём черепе нарастает слабая вибрация; её форма меняется в высокий звук, прежде чем отзвук "
"превращается в глубокий, искажённый, гулкий голос.";
M01_ADB04 =
"Да?";
M01_ADB04a = "Мне нужно направление.";
M01_ADB04b = "А?";
M01_ADB04c = "\cQ(Уйти) \cJТы странный тип. Прощай.";
M01_ADB05 =
"«А»? Искатель глубины?";
M01_ADB05a = "Что-?";
M01_ADB06 =
"\cDПрежде чем ты успеваешь вымолвить слово, существо внезапно смотрит в пространство вокруг тебя. Оно кажется погружённым в мысли, "
"будто пытается решить невидимую загадку. После короткой тишины существо снова говорит.\n\n"
"\cJПовернись. Иди сначала направо. Потом вверх. Потом ещё ниже. Под бенталью — внутри одного кадра времени — место назначения.";
M01_ADB06a = "\cQ(Уйти) \cD[Кивнуть]";
M01_ADB06b = "\cQ(Уйти) \cJСпасибо.";
M01_ADB06c = "\cQ(Уйти) \cJЧто?";
M01_ADB06x = "\cQ[Рефлекс памяти] \cJВпечатляющая телепатия. Ты был членом Ковенанта?";
M01_ADB07_01 =
"\cDСущество раскатисто смеётся, его смех достаточно громкий, чтобы разорвать барабанные перепонки и лопнуть голову, как воздушный шар. Но ты чувствуешь себя на удивление хорошо.\n\n"
"\cJМы закончили. Не завершили, увы. Далеко не завершили.";
M01_ADB07_02 =
"\cDСущество раскатисто смеётся, его смех достаточно громкий, чтобы разорвать барабанные перепонки и лопнуть голову, как воздушный шар. Но ты чувствуешь себя на удивление хорошо.\n\n"
"\cJМы закончили. Не завершили, увы. Далеко не завершили. Давай, скажи это.";
M01_ADB07_02a = "\cQ(Уйти) \cJСкажи что...??";
M01_ADB07_03 =
"\cDСущество раскатисто смеётся, его смех достаточно громкий, чтобы разорвать барабанные перепонки и лопнуть голову, как воздушный шар. Но ты чувствуешь себя на удивление хорошо.\n\n"
"\cJШесть становится Четырьмя. Ковенант живёт в чёрно-красном облаке. Но ты. Я. Мы закончили. Не завершили, увы. Далеко не завершили.";
M01_ADB08 =
"\cDСущество хранит молчание.";

//Second Encounter
M01_ADB_E01 =
"\cDФигура в капюшоне остаётся такой же зловещей, как и прежде.";
M01_ADB_E01a = "Как ты здесь оказался?";
M01_ADB_E01a_1 = "\cDАктор Чувак Братан говорит. Но космический шум вокруг заглушает всякий смысл.";

M01_ADB_E01b = "Что это за место?";
M01_ADB_E01b_1 = 
"Гниение. Материя разума терпела соединение до растворения. Пики и впадины в ритме песни.\n\n"
"Гниль. Немногие, если вообще кто-то, выживут...";

//Third Encounter
M01_ADB09 =
"\cDТы снова находишь то же существо. На этот раз оно сжалось в углу, промокшее до костей. Оно смотрит на тебя и подносит палец к "
"челюсти, делая жест «тише».\n\n"
"\cJБуря здесь...";
M01_ADB09a = "Какая буря?";
M01_ADB09b = "Что ты здесь делаешь?";
M01_ADB09c = "Ты следил за мной...";
M01_ADB09a_01 =
"Наверху. Сверхсознание. Миллион кричащих хоров марширует сквозь нигде.";
M01_ADB09a_01a = "Я не слышу и не вижу никакой бури.";
M01_ADB09a_02 =
"Скоро увидишь. \cDСущество переводит взгляд в сторону. \cJСобытия влекут притяжения к столкновению.";
M01_ADB09c_01 =
"Нет...";
M01_ADB09c_01a = "Тогда почему ты здесь?";
M01_ADB09c_01b = "Хорошо, у меня нет причин сомневаться в тебе.";
M01_ADB09c_01c = "\cD[Наставить пистолет на его череп] \cJХватит игр, скелет. Ты умрёшь здесь.";
M01_ADB09c_01d = "\cQ(Уйти) \cJВ это трудно поверить. Я тебе не доверяю.";
M01_ADB09c_01a_01 =
"\cDАктор Чувак Братан в ответ смотрит на тебя.";
M01_ADB09c_01c_1 =
"\cDПрежде чем ты успеваешь среагировать, затвор твоего пистолета отходит назад сам по себе и выбрасывает патрон из патронника. "
"Защёлка магазина также отключается, и магазин выскальзывает, начиная парить в воздухе и, как ни странно, "
"удлиняться, прежде чем скользнуть обратно в пистолет.\n\n"
"\cF(Макс. ёмкость пистолета +4)";
M01_ADB09c_01c_1a = "О...";
M01_ADB09c_01c_1b = "Мои искренние извинения. Я, возможно, переборщил.";
M01_ADB09c_01c_1c = "Спасибо. Просто чтобы ты знал, я блефовал.";
M01_ADB09c_01c_1d = "Держи руки при себе!";
M01_ADB09c_01c_1e_1 =
"\cDИ вот так магазин возвращается к прежнему размеру. Неудачный выбор слов. Эх.\n\n"
"\cR(Макс. ёмкость пистолета -4)";
M01_ADB10 = "Невозможно. Статика льётся с облаков. Увы, пока нет.";
M01_ADB10a = "Где мы теперь?";
M01_ADB10a_01 = "Мембрана поля мысли подуровня — ниже сна... Тсссс.";
M01_ADB11 =
"\cDАктор Чувак Братан оглядывается вокруг тебя, затем лезет в мантию и кладёт предмет рядом с собой.";

///////******* TRAIN
M01_ADB11_00 = 
"\cDВновь неподвижная фигура приветствует тебя пустыми глазницами.";
M01_ADB11_01 =
"\cDТвой разум встречает знакомое гулкое эхо. \cJТы победил.";
M01_ADB11_01a = "Да. Победа достигнута.";
M01_ADB11_01b = "Это было трудно, но всякая добыча в итоге бывает зарезана.";
M01_ADB11_01c = "Я едва выжил.";
M01_ADB11_01a_1 =
"\cDАктор Чувак Братан складывает руки вместе. \cJОчень хорошо, хорошо прозвучавшее музыкальное объявление. "; 
M01_ADB11_01c_1 =
"...но всё же вышел победителем.\n\n"
"\cDАктор Чувак Братан складывает руки вместе. \cJВсё равно очень хорошо, хорошо прозвучавшее музыкальное объявление. ";
//Main bulk ///////////////////////////////
M01_ADB12 = "\cDАктор Чувак Братан поворачивается к тебе. \cJВопрос?";
M01_ADB12a = "\cD[Показать странную книгу] \cJТы можешь это прочитать?"; //Ignorant minds consuming its consumer's consumption!
M01_ADB12b = "Куда идёт этот поезд?";
M01_ADB12b_1 =
"В никуда.";
M01_ADB12b_1a = "Что ты имеешь в виду?";
M01_ADB12b_1a_1 =
"Хаааааа?";
M01_ADB12b_1b = "Мы можем как-то изменить курс?";
M01_ADB12b_1b_1 =
"Нет.";
M01_ADB12b_1c = "Очередные бессмысленные ответы. Почему ты не можешь сказать ничего нормального?";
M01_ADB12b_1c_1 =
"\cDОн насмешливо смеётся над тобой. \cJЯзыки. Правила для ясности, а получается безумие. Жалкие существа вращаются и мыслят линейно.";
M01_ADB12c_2a = "\cQ(Телосложение) \cJОнииии--верили, что это предначертано. Это чисто--по случайности. Резонанс--пожираееет.";
M01_ADB12a_1 =
"\cDАктор Чувак Братан берёт книгу и начинает быстро перелистывать все страницы; ты не уверен, читает ли он вообще хоть что-нибудь. "
"Закончив, он начинает объяснять содержание.";
M01_ADB12a_2 =
"\cDЭта книга написана формой гипертемпоральной каллиграфии. Ты никак не мог расшифровать письмо, если бы не был способен "
"смотреть на время с неограниченной свободой. Текст содержит краткую гипотезу об успехе воздействия экзотических материалов на обычный разум.\n\n"
"\cU''Резонанс, как уже не раз говорилось, затрагивает все слои этой вселенной; аберрантная мутация, способная резонировать только со слоями "
"разума, приводит к тому, что мутация затрагивает лишь то, что относится к разуму. В этом случае, из-за взаимодействия с эго и другими аспектами "
"разума, мутация является самодостаточной и имеет узкий охват.\n\n"
"Конечным результатом становится разум, который полностью принадлежит другой вселенной, тогда как тело остаётся запертым в этой. "
"«Божественность» такого разума означает, что он интерпретирует нашу вселенную по правилам другой вселенной, позволяя "
"проявляться экстрасенсорным способностям, а также натурокинезу (контролю над элементами), среди прочих паранормальных сил разума.''";
M01_ADB12_2a = "Ты можешь меня этому научить?";
M01_ADB13 = "А. Знаешь буквы, не знаешь слов. Давай напишем предложение.";
M01_ADB14 = "\cDАктор Чувак Братан хранит молчание.";
//AHHHHHHH~!!!!!!!!!!!!!!!!!///////////////////////
Psi_01 = "\cI[Изучить псионические способности]";
Psi_01a = "\cD[Потратить 4000 экзальтации]";
Psi_01b = "\cD[Потратить 3000 экзальтации]";
Psi_01c = "Забудь.";

Psi_HG_01 = "\cI[Психоэнтомное единение]";
Psi_HG_02 =
"\cIПСИХОЭНТОМНОЕ ЕДИНЕНИЕ:\n"
"Призовите рой насекомых, чтобы наложить на цель Гниль мозга. Жертвы под эффектом Гнили мозга становятся дружелюбными и получают постоянный урон.\n"
"\cFРезонирующее оружие: \cJПистолет\n"
"\cFТребуется слот настройки: \cJ1\n"
"\cFСтоимость: \cJ4000 экзальтации \cJ| \cDДоступно: \cJitem_find:ExaltXP: Экзальтация";
Psi_HG_03 =
"\cBМиллиарды влияний. Коллективное программирование. Неодолимо.\n\n"
"\cI(Психоэнтомное единение получено)";

Psi_SG_01 = "\cI[Психоэлектрокинетическое притяжение]";
Psi_SG_02 =
"\cIПСИХОЭЛЕКТРОКИНЕТИЧЕСКОЕ ПРИТЯЖЕНИЕ:\n"
"Дёрните воздушный поток, чтобы ударить током основную цель и до 2 дополнительных целей. Каждая поражённая жертва будет Оглушена, усилив траншейное ружьё и его владельца.\n"
"\cFРезонирующее оружие: \cJТраншейное ружьё\n"
"\cFТребуется слот настройки: \cJ1\n"
"\cFСтоимость: \cJ4000 экзальтации \cJ| \cDДоступно: \cJitem_find:ExaltXP: Экзальтация";
Psi_SG_03 =
"Невидимое сознание. Предначертанная полярность. Светящиеся корни.\n\n"
"\cI(Психоэлектрокинетическое притяжение получено)";

Psi_SP_01 = "\cI[Психосоматическая связь]";
Psi_SP_02 =
"\cIПСИХОСОМАТИЧЕСКАЯ СВЯЗЬ:\n"
"Насильно разорвите биомассу павших врагов и срастите её со своей, чтобы заменить повреждённые или недостающие части. Труп врага должен быть относительно целым.\n"
"\cFРезонирующее оружие: \cJБаллончик\n"
"\cFТребуется слот настройки: \cJ1\n"
"\cFСтоимость: \cJ3000 экзальтации \cJ| \cDДоступно: \cJitem_find:ExaltXP: Экзальтация";
Psi_SP_03 =
"Жизнь пожирает жизнь. Причинная инверсия.\n\n"
"\cI(Психосоматическая связь получена)";

Psi_Fail =
"Невежественные умы пожрут потребление своего потребителя!\n\n"
"\cR(Недостаточная псионическая настройка)";



M02_ADB_00 =
"Под \cDдвором\cJ... Неудачи плоти общаются с забвением. Сходятся в спираль.\n\n"
"...Ложный, Пирамидальный Бог. Задерживается перед сном под смертью.";
M02_ADB_00a = "О чём ты говоришь?";
M02_ADB_00b = "Конечно, очередные загадки от пыльной реликвии.";
M02_ADB_00c = "Понятно.";
M02_ADB_00a_1 = "Чувства сужают полотно воображения к неразличимому хаосу. Но потенциал Первоматерии шире, его благословенный вид незрим.\n\nРезонанс смещает онтологические приливы через заражённые сны.";
M02_ADB_01 =
"\cDАктор Чувак Братан говорит, но шум искажается и не достигает твоего разума.";

//M01_ADB11_01 =
//"There remained that which is to be seen yet. I must see to it.\n\n"
//"\cDThe creature stares at you. Then places an item for you next to itself.";
