[ru]
M01_Box = "Подозрительная коробка";
M01_Box01 = "\cDТы готов поклясться, что видел, как коробка шевельнулась. То, что внутри, издаёт едва слышное бульканье.";
M01_Box01a = "\cD[Осмотреть коробку]";
M01_Box01b = "\cQ(Уйти) \cJФу, нет.";

M01_Box02 = "\cDИз коробки доносится сломленный, хриплый и полный боли голос.\n\n"
"\cJП-подожди... н-не... подходи... ближе...";
M01_Box02a = "Почему ты прячешься в коробке?";

M01_Box02_1 = "Я... я просто пытаюсь... спрятаться. З-здесь есть вещи. Т-ты... видел их. Т-ты... один из них... Они... их привлекает его присутствие.";
M01_Box02_1a = "Теперь они все мертвы.";
M01_Box02_1b = "Ты ошибаешься. Я просто прохожу мимо.";
M01_Box02_1c = "\cD[Безумно рассмеяться]\cJ ТВОЯ ЖИЗНЬ ЗАКАНЧИВАЕТСЯ СЕЙЧАС!!";
M01_Box02_1d = "\cQ(Уйти) \cDОставить коробку в покое.";

M01_Box03 = "\cDКороткая пауза. Ты понимаешь, что существо внутри изучает то, что должно быть твоими ногами.\n\n"
"\cJП-пожалуйста. Я... голоден.";
M01_Box03a = "Я тебя накормлю. Но взамен хочу информацию.";

M01_Box031_1 = "Д-да!.. Что угодно... пожалуйста... \cDИз отверстия вытекает какая-то коричневатая слизь.";
M01_Box031_2 = "НЕТ! НЕТ!!! П-ПОЖАЛУЙСТА! Я... я-я...";
M01_Box031a = "\cD[Предложить паёк]";
M01_Box031b = "\cD[Предложить банку фруктов]";
M01_Box031c = "\cD[Предложить банку таинственного мяса]";
M01_Box031d = "\cD[Предложить пси-гриб]";
M01_Box031e = "\cD[Предложить ремкомплект]";
M01_Box031f = "\cD[Предложить ружейное масло]";

M01_Box032_2 = "Я-я не могу это есть...";

M01_Box032_3 = "Ф-фуу... ладно... \cD*Глотает*";
M01_Box032_3a = "Ну?";

M01_Box033 = "\cDКоробка молчит. Вероятно, она мертва.";

M01_Box04 = "\cDИз коробки с ослепительной скоростью вырывается щупальце из быстро растворяющейся плоти и смахивает еду с крышки. "
"Ты слышишь, как коробка торопливо пожирает упаковку.\n\n\cJМмм...";
M01_Box04a = "\cD[Объяснить свою миссию] \cJРасскажи мне всё, что знаешь.";
M01_Box05 = "\cDДыхание коробки учащается. В твоей просьбе есть что-то жуткое.\n\n"
"\cJН-не... помню. Н-не может быть слишком далеко... Я... я не м-могу ходить, видишь... Это д-длится уже долго... ползал и падал...\n\n"
"\cDНеловкая тишина заполняет комнату, и у тебя возникает ощущение, что существо внутри боится говорить.";
M01_Box05a = "Ты что-то скрываешь.";
M01_Box05b = "\cQ(Уйти) \cDОставить это дело.";

M01_Box06 = "Н-нет. Я-я... не могу... Пожалуйста...";
M01_Box06a = "\cQ[Сила] \cDПнуть коробку.";
M01_Box06b = "\cQ[Сила] \cDНаорать на коробку.";
M01_Box06c1 = "\cQ[Разум] \cDВторгнуться в разум коробки.";
M01_Box06c2 = "\cQ[Разум] \cJЯ не причинил тебе вреда, я даже помог, когда попросили. Ответь мне, и я оставлю тебя в покое.";
M01_Box06d1 = "\cQ[Телосложение] \cDОткрыть коробку и снять маску, показав своё лицо. \cJЛожь....";
M01_Box06d2 = "\cQ[Телосложение] \cDПоложить руку на коробку. \cJНе волнуйся, я не причиню тебе вреда. Я больше похож на тебяяя. Вииидишь?";
M01_Box06e = "\cQ(Уйти) \cJЛадно, это становится странным. Я ухожу.";

M01_Box06da = "\cDКоробка отшатывается в отвращении. \cJФ-фуу... Эм... Н-нет, не... совсем... С-слава... богам...";

M01_Box07_01 = "ААА!!!\n\nВ-важно!.. Знание! С н-небес! П-потеряно! П-пожалуйста! Мне... страшно!\n\n";
M01_Box07_01b = "П-подожди!!\n\nЕсть... В-важно!.. Знание! С н-небес! П-потеряно! П-пожалуйста! Мне... страшно!\n\n";

M01_Box07_02 = "\cDКоробка слегка напрягается, будто насторожившись. "
"\cJЭто... сообщение с н-небес... З-запретное... знание. И-или, по... крайней мере... з-забытое. Б-большинством из... нас. "
"Я... я пытался выбраться... наружу... сколько себя помню... подальше от лабораторий. "
"Н-ну... Т-та лаборатория, где я р-работал, имела... антенну связи. М-может, там?\n\n"
"\cDКоробка сдувается, что ты воспринимаешь как признак облегчения. \cJОчень... важно.";
M01_Box07_02b = "\cDКоробка слегка напрягается, будто насторожившись. "
"\cJЛадно-ладно... Есть... сообщение с н-небес... З-запретное... знание. И-или, по... крайней мере... з-забытое. Б-большинством из... нас. "
"Я... я пытался выбраться... наружу... сколько себя помню... подальше от лабораторий. "
"Н-ну... Т-та лаборатория, где я р-работал, имела... антенну связи. М-может, там?\n\n"
"\cDКоробка сдувается, что ты воспринимаешь как признак облегчения. \cJОчень... важно.";

M01_Box07a = "Подожди, это всё?";
M01_Box07b = "\cQ(Уйти) \cDПоблагодарить коробку и извиниться за враждебность.";
M01_Box07c = "\cQ(Уйти) \cJПонятно. Спасибо.";
M01_Box07d = "\cQ(Уйти) \cDУйти.";

M01_Box08 = "Д-да... Пожалуйста... Я устал.";

M01_Box09 = "\cDКоробка с осторожностью изучает гриб... Затем вскоре ты слышишь чавканье.\n\n"
"Вскоре из коробки доносится новый влажный булькающий звук. Её голос становится почти неслышным. "
"Каждое произнесённое слово отражается эхом в невидимой пустоте вокруг тебя...";
M01_Box09a = "\cQ(Посмотреть, что будет)";

M01_BoxFinal = "\cDКоробка молчит.";
M01_BoxScript01 = "\"Ха.\"";
M01_BoxScript02 = "\"Ха. ..ха-ха..\"";
M01_BoxScript03 = "\"Ха. ..ха-ха.. ха.\"";
M01_BoxScript04 = "\"Свет...\"";
M01_BoxScript05 = "\"Свет, чтобы найти дорогу назад из сна...\"";
M01_BoxScript06 = "\"...Если бы у тебя были глаза, чтобы его найти.\"";
