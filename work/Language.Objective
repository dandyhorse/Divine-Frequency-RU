[ru]
Obj_00 = "\cU·Отправляйтесь к 39°59'0''N 43°59'0''W.";
Obj_01 = "\cU·По словам жуткого скелета, то, что вы ищете, можно найти так: ''Повернись. Сначала иди направо. Потом вверх. Потом ещё ниже. Под бенталью — внутри одного кадра времени находится место назначения.''";
Obj_02 = "\cU·Найдите путь к 37.5°0'0''N 36.5°0'0''W.";
Obj_03 = "\cU·Ищите самую низкую точку на 37.5°0'0''N 36.5°0'0''W.";
Obj_04 = "\cU·Холодильник обещает награду в обмен на странный артефакт, который можно найти глубоко внизу. Вы можете проигнорировать эту просьбу, но лишняя огневая мощь никогда не помешает.";
Obj_05 = "\cU·Продолжайте искать самую низкую возможную точку на 37.5°0'0''N 36.5°0'0''W.";
Obj_06 = "\cU·Встретьте то, что скрывается внизу.";
