[ru]
UPG_01_DLG_01 = "\cD[Осмотреть яйцо]";
UPG_01_DLG_01a1 = "\cDЯйцо тёплое на ощупь. Оно мягко пульсирует изнутри. Его потенциал ждёт проявления.\n\n"
"\cIТЕКУЧИЙ РАЗУМ\n"
"\cF+10 Физический порог: \cJПлоское снижение физического урона. Хорошо против слабого и среднего урона.\n"
"\cF+10 Слоёв брони: \cJПозволяет получать пользу от физического порога и физического сопротивления. Вы теряете один слой каждый раз, когда получаете урон. Восполнимо.\n\n"
"\cIУКОРЕНЁННЫЙ РАЗУМ\n"
"\cF+60% Физическое сопротивление: \cJМультипликативное снижение физического урона. Хорошо против сильного урона.\n"
"\cF+10 Слоёв брони: \cJПозволяет получать пользу от физического порога и физического сопротивления. Вы теряете один слой каждый раз, когда получаете урон. Восполнимо.";

UPG_01_DLG_01a2 = "\cDЯйцо тёплое на ощупь. Оно мягко пульсирует изнутри. Его потенциал ждёт проявления.\n\n"
"\cIКЕВЛАРОВАЯ БРОНЯ MK.I\n"
"\cF+10 Физический порог: \cJПлоское снижение физического урона. Хорошо против слабого и среднего урона.\n"
"\cF+10 Слоёв брони: \cJПозволяет получать пользу от физического порога и физического сопротивления. Вы теряете один слой каждый раз, когда получаете урон. Восполнимо.\n\n"
"\cIБРОНЯ С ТЯЖЁЛЫМИ ПЛАСТИНАМИ MK.I\n"
"\cF+60% Физическое сопротивление: \cJМультипликативное снижение физического урона. Хорошо против сильного урона.\n"
"\cF+10 Слоёв брони: \cJПозволяет получать пользу от физического порога и физического сопротивления. Вы теряете один слой каждый раз, когда получаете урон. Восполнимо.";

UPG_01_DLG_01a3 = "\cDЯйцо тёплое на ощупь. Оно мягко пульсирует изнутри. Его потенциал ждёт проявления.\n\n"
"\cIЗАЩИТНОЕ МЯСНОЕ БЛЮДО\n"
"\cF+10 Физический порог: \cJПлоское снижение физического урона. Хорошо против слабого и среднего урона.\n"
"\cF+10 Слоёв брони: \cJПозволяет получать пользу от физического порога и физического сопротивления. Вы теряете один слой каждый раз, когда получаете урон. Восполнимо.\n\n"
"\cIПАНЦИРЬ РАКОВОГО КРАБА\n"
"\cF+60% Физическое сопротивление: \cJМультипликативное снижение физического урона. Хорошо против сильного урона.\n"
