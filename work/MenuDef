	Option "Расход выносливости",		"modf_stamina", "skill_stamina"
	Option "Скорость износа оружия",	"modf_weapon", "skill_weapon"
	Option "Разрыв резонанса: расширенное окно",	"modf_parry", "skill_parry"
	
	StaticText ""
