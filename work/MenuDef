	Option "HUD (интерфейс)",		"hud_enable", "OnOff"
	Description "$DESC_HUD"
	Option "Значок взаимодействия",				"icon_enable", "OnOff"
	Description "$DESC_ICON"
	Option "Подсказка предмета",				"itemToolTip_enable", "OnOff"
	Description "$DESC_TOOLTIP"
	Option "Движение камеры в ближнем бою",		"mcam_enable", "OnOff"
	Description "$DESC_MELEECAM"
	Option "Искажение Nulled Landscape","hzv_enable", "OnOff"
	Description "$DESC_DISTORTION"
	Option "Прицел траншейного ружья",		"sgxh_enable", "OnOff"
	Description "$DESC_SGCX"
	Option "Обучение",					"tutorial_enable", "OnOff"
	Description "$DESC_TUTORIAL"
	
	StaticText ""
	StaticText "--РАЗНОЕ--", "Green"
	Option "$DSPLYMNU_MOVEBOB",					"movebob", "boboption"
	Option "Яркость вспышки при подборе",		"itemFlash_amount", "flashoption"
	Option "Яркость вспышки при получении урона",		"blood_fade_scalar", "painflashoption"
	Option "Цвет прицела по уровню здоровья",		"crosshaircolors", "CrosshairHealthTypes"
