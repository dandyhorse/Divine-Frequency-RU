[ru]
Tu_Combo = "\cD[Удерживайте перезарядку] \cJНакопите тяжёлую атаку. Отпустите, чтобы высвободить.\n"
"\cD[Нажмите перезарядку]\cJ во время \cFблока \cJвызывает мощный взрыв. Блокируйте урон или бейте головой, чтобы зарядиться.";
Tu_Dash = "Полезно для уклонения от быстрых атак ближнего боя или атак с воздуха.";
Tu_Sprint = "Полезно, чтобы создать безопасную дистанцию от атакующих.";
Tip_Ammo = "Совет: \cFФугасные\cJ патроны очень эффективны против большинства существ, включая тебя самого.";
Tip_Condition = "\cDСовет: \cJБольшинство оружия изнашивается при стрельбе. \cFРемонт жизненно важен\cJ для сохранения работоспособности.";
Tip_Icon = "\cDНастройка: \cFЗначки взаимодействия \cJможно отключить в меню специальных возможностей.";
Tip_Injector = "\cDСовет: \cJ\cGИнъектор Психуса \cJ— чрезвычайно мощный лечебный предмет. Пополнения очень редки, используйте его с умом!";
Tip_Parry = "\cDСовет: \cJПризраки уязвимы к \cFРазрыву резонанса\cJ: выстрел из \cDтраншейного ружья\cJ в середине их атаки нанесёт катастрофический урон.";
Tip_Weapon = "Подробную информацию об оружии можно найти в меню инвентаря.";
Tip_DuelEnd = "\cDСовет: \cJИз Дуэли можно выйти в любой момент, используя предмет «Выйти из Дуэли» в инвентаре.\n\n";
Tip_DuelHelp = "\cDНастройка: \cJВремя атаки для \cIРазрыва резонанса\cJ можно \cDпродлить\cJ в меню специальных возможностей.";
Tip_DuelStr = "\cDСовет: \cJТвоя \cFСила\cJ позволяет накладывать Разрыв резонанса \cDкулаками\cJ, а также \cDтраншейным ружьём\cJ.";
Tip_DuelPhy = "\cDСовет: \cJВыбранная тобой волна \cF(Хаотичная вибрация)\cJ позволяет игнорировать всё сопротивление урону в этом испытании.";
