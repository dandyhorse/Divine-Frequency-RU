		if(healItems.Size() > 0)
		{
			hItemX = 0;
			hItemY = 80;
			
			for(int i = 0; i < healItems.Size(); i++)
			{
				if(hItemX >= 256)
				{
					hItemX = 0;
					hItemY += 32;
				}
				
				UIImage itemIcon = UIImage(new("UIImage")).Create
				(
					(hItemX, hItemY),
					(32, 32),
					CustomInventoryItem(healItems[i]).invIcon,
