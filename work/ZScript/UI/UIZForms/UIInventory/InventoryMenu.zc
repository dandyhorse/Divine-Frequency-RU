		  hasWpn = true;
		  rHG = UIButton(new("UIButton").Create
		  (
			(16, 8), (96, 12), "", handler, "", epBtnTex, epBtnHover, epBtnTex, null, fnt, 0.45,
			alignment: UIButton.AlignType_Right
		  ));			
		  rHG.Pack(RepairPrompt);
	  }
	  
	  if(DFPlayer(pmo).wep3a)
	  {
		  hasWpn = true;
		  rSG = UIButton(new("UIButton").Create
		  (
			(16, 22), (96, 12), "", handler, "", epBtnTex, epBtnHover, epBtnTex, null, fnt, 0.45,
			alignment: UIButton.AlignType_Right
		  ));			
		  rSG.Pack(RepairPrompt);
	  }
	  
	  if(DFPlayer(pmo).wep4a)
	  {
		  hasWpn = true;
		  rSP = UIButton(new("UIButton").Create
		  (
			(16, 36), (96, 12), "", handler, "", epBtnTex, epBtnHover, epBtnTex, null, fnt, 0.45,
			alignment: UIButton.AlignType_Right
		  ));			
		  rSP.Pack(RepairPrompt);
	  }
	  
	  if(DFPlayer(pmo).wep4b)
	  {
		  hasWpn = true;
		  rAR = UIButton(new("UIButton").Create
		  (
			(16, 50), (96, 12), "", handler, "", epBtnTex, epBtnHover, epBtnTex, null, fnt, 0.45,
			alignment: UIButton.AlignType_Right
		  ));			
		  rAR.Pack(RepairPrompt);
	  }
	}
	
	ui void InteractItem(String command)
	{		
	  for(int j = 0; j < allBtnHolder.Size(); j++)
	  {
	    if(allBtnHolder[j].isHovered() && handler)
		{
		  if(command ~== "use")
		    handler.buttonClickCommand(allBtnHolder[j], "UseItem:" .. allBtnHolder[j].getCommand());
		  else if(command ~== "extra")
		    ShowExtendedOption(allBtnHolder[j].getCommand());
		  break;
		}
	  }
	}
	
	void ShowExtendedOption(string cmd)
    {
	  if(cmd == "None")
	    return;
		
	  Array<String> command;
	  cmd.Split(command, ":");
	  
      menu.MenuSound("menu/clear");
	  epUse.setCommand("UseItem:" .. cmd);
	  epDrop.setCommand("DropItem:" .. cmd);
	  epDrop.setHoverTexture(epBtnHover);
	  epDrop.setAlpha(1.0);
	  
	  if(command[2] ~== "Stim")
	  {
		epDrop.setCommand("");
		epDrop.setHoverTexture(epBtnTex);
		epDrop.setAlpha(0.5);
	    epBind.setCommand("");
		epBind.setHoverTexture(epBtnTex);
		epBind.setAlpha(0.5);
	  }
	  else if(command[2].Left(4) ~== "Key_")
	  {
		epUse.setCommand("");
		epUse.setHoverTexture(epBtnTex);
		epUse.setAlpha(0.5);
		epBind.setCommand("");
		epBind.setHoverTexture(epBtnTex);
		epBind.setAlpha(0.5);
		epDrop.setCommand("");
		epDrop.setHoverTexture(epBtnTex);
		epDrop.setAlpha(0.5);
	  }
	  else if(command[2].Left(5) ~== "Skill")
	  {
		if(command[0].Left(7) ~== "Passive")
		{
		  epUse.setCommand("");
		  epUse.setHoverTexture(epBtnTex);
		  epUse.setAlpha(0.5);
		  epBind.setCommand("");
		  epBind.setHoverTexture(epBtnTex);
		  epBind.setAlpha(0.5);
		}
		else
		{
		  epBind.setCommand("BindItem");
		  epBind.setHoverTexture(epBtnHover);
		  epBind.setAlpha(1.0);
		}
		epDrop.setCommand("");
		epDrop.setHoverTexture(epBtnTex);
		epDrop.setAlpha(0.5);
		bindItem = command[2];
	  }
	  else if(command[2].Left(6) ~== "Helper")
	  {
		epUse.setCommand("");
		epUse.setHoverTexture(epBtnTex);
		epUse.setAlpha(0.5);
		epBind.setCommand("");
		epBind.setHoverTexture(epBtnTex);
		epBind.setAlpha(0.5);
	  }
	  else
	  {
	    epBind.setCommand("BindItem");
		epBind.setHoverTexture(epBtnHover);
		epBind.setAlpha(1.0);
		bindItem = command[2];
	  }
	  UsagePrompt.hide();
	  ExtendedPrompt.setPos(mainframe.screenToRel(getMousePos() - (22,24)));
	  ExtendedPrompt.show();
    }
	
	void ShowRepairOption(String cmd)
	{
	  menu.MenuSound("menu/clear");
	  if(DFPlayer(pmo).wep2)
	  {
	    let inv = pmo.FindInventory("Handgun");
		if(inv)
		  rHG.setText(String.Format("Пистолет: %d", DF_Weapon(inv).wep_cond) .. "%  ");
		
	    rHG.setCommand("Repair:Handgun:" .. cmd);
	  }
		
	  if(DFPlayer(pmo).wep3a)
	  {
	    let inv = pmo.FindInventory("Trenchgun");
		if(inv)
		  rSG.setText(String.Format("Траншейка: %d", DF_Weapon(inv).wep_cond) .. "%  ");
		  
	    rSG.setCommand("Repair:Trenchgun:" .. cmd);
	  }
	  
	  if(DFPlayer(pmo).wep4a)
	  {
	    let inv = pmo.FindInventory("SprayCan");
		if(inv)
		  rSP.setText(String.Format("Баллончик: %d", DF_Weapon(inv).wep_cond) .. "%  ");
		
	    rSP.setCommand("Repair:Spraycan:" .. cmd);
	  }
	  
	  if(DFPlayer(pmo).wep4b)
	  {
	    let inv = pmo.FindInventory("AR");
		if(inv)
		  rAR.setText(String.Format("Автомат: %d", DF_Weapon(inv).wep_cond) .. "%  ");
	    
	    rAR.setCommand("Repair:AR:" .. cmd);
	  }
	  
	  UsagePrompt.hide();
	  RepairPrompt.setPos(mainframe.screenToRel(getMousePos() - (22,50)));
	  RepairPrompt.show();
	}
	
	void ShowBindingOption()
	{
	  let pmo = players[consoleplayer].mo;
	  
	  if(DFPlayer(pmo).quickUse1)
	    bnd1.setImage(CustomInventoryItem(DFPlayer(pmo).quickUse1).invIcon);
		
	  if(DFPlayer(pmo).quickUse2)
	    bnd2.setImage(CustomInventoryItem(DFPlayer(pmo).quickUse2).invIcon);
		
	  if(DFPlayer(pmo).quickUse3)
	    bnd3.setImage(CustomInventoryItem(DFPlayer(pmo).quickUse3).invIcon);
		
	  if(DFPlayer(pmo).quickUse4)
	    bnd4.setImage(CustomInventoryItem(DFPlayer(pmo).quickUse4).invIcon);
		
	  BindingFrame.setPos(mainframe.screenToRel(getMousePos() - (64,64)));
	  BindingFrame.show();
	}
	
	override bool OnUIEvent(UIEvent ev)
	{
	  if(ev.Type == UIEvent.Type_KeyDown)
	  {
		if(ev.KeyString ~== "	")
		  Close();
		else if((ev.KeyChar == 32 || ev.KeyChar == 89) && confirm_wait)
	      handler.Confirm();
	  }
	  
	  if(ev.type == UIEvent.Type_LButtonDown)
	  {
		if(inv_clickSwap)
		  InteractItem("extra");
		else
		  InteractItem("use");
	  }
	  
	  if(ev.type == UIEvent.Type_RButtonDown)
	  {
	    if(confirm_wait)
	    {
	      confirm_bound.hide();
		  confirm_box.hide();
		  confirm_wait = false;
	    }
		else
		{
		  if(inv_clickSwap)
		    InteractItem("use");
		  else
		    InteractItem("extra");
		}
	  }
	  
	  return Super.OnUIEvent(ev);
	}
	
	override bool menuEvent(int mkey, bool fromcontroller)
    {
      if(mkey == MKEY_Enter && confirm_wait)
	    handler.Confirm();
		
      return Super.menuEvent(mkey, fromController);
    }
	
	override void Ticker()
	{
	  DisplayStatus();
	  
	  if(flashAlpha > 0.0)
	    flashAlpha -= 0.015;
		
	  if(subHead1)
	    subHead1.setText(conTitle);
		
      if(usagePrompt)
	  {
	    vector2 pos = mainframe.screenToRel(getMousePos());
		UsagePrompt.setPos(pos + (8, 8));
	  }
	  
	  if(!RepairPrompt.isHidden() && !RepairPrompt.containsMouse())
	    RepairPrompt.hide();
	  
	  if(!ExtendedPrompt.isHidden() && !ExtendedPrompt.containsMouse())
	    ExtendedPrompt.hide();
	  else if(ExtendedPrompt.isHidden())
	  {
	    for(int i = 0; i < allBtnHolder.Size(); i++)
	    {
	      if(allBtnHolder[i].isHovered())
		  {
		    if(allBtnHolder[i].getCommand() != "none" || allBtnHolder[i].getCommand() != "")
		    {
		       UsagePrompt.show();
		       break;
		    }
		    else
		    {
		      itemName.setText("");
		      itemEffect.setText("");
		      itemText.setText("");
		      UsagePrompt.hide();
		    }
		  }
		  else if(i == allBtnHolder.Size() -1 && !allBtnHolder[i].isHovered())
		  {
		    itemName.setText("");
		    itemEffect.setText("");
		    itemText.setText("");
		    UsagePrompt.hide();
		  }
	    }
	  }
	  
	  Super.Ticker();
	}
	
	override void Drawer()
	{
	  Screen.Dim(Color(8, 8, 8), 0.6, 0, 0, Screen.GetWidth(), Screen.GetHeight());
	  Super.Drawer();
	  Screen.Dim(Color(208, 240, 255), flashAlpha, 0, 0, Screen.GetWidth(), Screen.GetHeight());
    }

