class InventoryActivator : Inventory
{
  bool tip_prompt;
  Default
  {
	+Inventory.UNDROPPABLE
	-Inventory.INVBAR
  }

  override bool Use(bool pickup)
  {
	if(owner == null)
	  return true;
	  
	if(tip_prompt)
	{
	  let ev = GenericScreenStuff(EventHandler.Find("GenericScreenStuff"));
	  if(ev)
	    ev.PromptTutorial("Clear");
		
	  tip_prompt = false;
	}

	if(owner == players[consoleplayer].mo)
	{
	  DFPlayer(owner).goal_alert = false;
	  A_StartSound("menu/clear", CHAN_AUTO, CHANF_UI, attenuation: 0.0);
	  Menu.SetMenu("InventoryMenu");
	}

	return false;
  }
  
  States
  {
	Spawn:
	  TNT1 A -1;
	  Stop;
	Use:
	  TNT1 A 0;
	  Fail;
  }
}