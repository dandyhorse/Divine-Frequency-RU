class InventoryMenu : UIGenericMenu //Please don't ever copy this hacky mess lmfao. Dict tape and strings galore
{
	Font fnt;
	PlayerPawn pmo;
	InventoryMenuHandler handler;
	Array<CustomInventoryItem> healItems, toolItems, skillItems;
	Array<UIButton> healBtnHolder, toolBtnHolder, skillBtnHolder, allBtnHolder;
	Array<UIImage> healIcon, toolIcon, skillIcon;
	
	int fntColor, hItemX, hItemY, tItemX, tItemY, sItemX, sItemY, strCount, witCount, endCount, maxInv, EPTimer;
	String conTitle, bindItem;
	double flashAlpha;
	
	//Repair
	UIButton rHG, rSG, rSP, rAR;
	bool hasWpn; //Prevent vm crash and having to actually use my brain
	
	 //Confirmation
    string upg_command;
    bool confirm_wait;
    UIButton btn_confirm, btn_cancel;
    UIFrame confirm_box, confirm_bound;
    UILabel confirm_msg;
	
	//Status
	UIFrame UsagePrompt, ExtendedPrompt, BindingFrame, RepairPrompt;
	UIButton epUse, epDrop, epBind;
	UIBoxTextures epBtnTex, epBtnHover;
	UIImage bnd1, bnd2, bnd3, bnd4;
	UILabel itemName, itemText, itemEffect, subHead1, subHead2, subHead3, AtrText, CStateText, ObjectiveText, LocationName;
	
	string getKey(string keybind) 
    {
      Array<int> keyInts;
      AutoMapBindings.GetAllKeysForCommand(keyInts, keybind);
      return AutoMapBindings.NameAllKeys(keyInts, FALSE);
    }

	void DisplayStatus()
	{
		PlayerPawn pmo = players[consoleplayer].mo;
		String Attribute = "";
		String condText = "";
		conTitle = String.Format("Расходники и медикаменты (%d/%d)", DFPlayer(pmo).invCur, DFPlayer(pmo).invMax);

		if(DFPlayer(pmo).tox > DFPlayer(pmo).toxMax * 0.8)
		  condText.AppendFormat("Токсин (смертельный)\n\cR-Периодический урон\n-Нарушение движения\n-Нарушение прицеливания\n\n");
		else if(DFPlayer(pmo).tox >= DFPlayer(pmo).toxMax * 0.5)
		  condText.AppendFormat("Токсин (умеренный)\n\cR-Нарушение прицеливания\n\n");
		
		if(DFPlayer(pmo).rad > DFPlayer(pmo).radMax * 0.9)
		  condText.AppendFormat("\cJРадиация (смертельная)\n\cR-Неминуемая перегрузка\n-Нарушение зрения\n\n");
		else if(DFPlayer(pmo).rad >= DFPlayer(pmo).radMax * 0.5)
		  condText.AppendFormat("\cJРадиация (умеренная)\n\cR-Нарушение зрения\n\n");
		  
		CStateText.setText(condText);

		Attribute.AppendFormat("УРОВЕНЬ %d Аватар:\n%s\n\nСила: %d\nРазум: %d\nТелосложение: %d\n\n    Экзальтация: %d\n    Мутация: %d\n    Пси-настройка: %d/%d",
		DFPlayer(pmo).level,
		DFPlayer(pmo).title,
		pmo.CountInv("StrToken"),
		pmo.CountInv("WitToken"),
		pmo.CountInv("PhyToken"),
		pmo.CountInv("ExaltXP"),
		pmo.CountInv("Mutation"),
		DFPlayer(pmo).tune,
		DFPlayer(pmo).tune_max
		);
		AtrText.setText(Attribute);

		LocationName.setText(String.Format("Локация: %s", DFPlayer(pmo).location));
		ObjectiveText.setText(StringTable.Localize(DFPlayer(pmo).goal));
	}
	
    override void Init(Menu parent)
    {
        Super.Init(parent);
		pmo = players[consoleplayer].mo;
		fnt = Font.GetFont("RU_DF_FONT");
		fntColor = Font.CR_White;
		DontDim = true;
		flashAlpha = 0.0;
		handler = new("InventoryMenuHandler");
        handler.menu = self;
	
        SetBaseResolution((720, 400));
		SetBackgroundImage();
		CreateMenuTabs();
		
		if(pmo)
		{
		  strCount = pmo.CountInv("StrToken");
		  witCount = pmo.CountInv("WitToken");
		  endCount = pmo.CountInv("PhyToken");
		  maxInv = DFPlayer(pmo).invMax;
		}
		
		allBtnHolder.Clear();
		healItems.Clear();
		toolItems.Clear();
		skillItems.Clear();
		healBtnHolder.Clear();
		toolBtnHolder.Clear();
		skillBtnHolder.Clear();
		
		for(Inventory item = DFPlayer(pmo).Inv; item != NULL; item = item.Inv)
		{
			if(item is "Consumable")
			{
				if(item.amount > 0)
				{
					for(int i = 0; i < item.Amount; i++)
						healItems.Push(CustomInventoryItem(item));
				}
			}
			else if(item is "Tool" || item is "KeyItem")
			{
				if(item.amount > 0)
				{
					for(int i = 0; i < item.Amount; i++)
						ToolItems.Push(CustomInventoryItem(item));
				}
			}
			else if(item is "Skill")
			{
				if(item.amount > 0)
				{
					for(int i = 0; i < item.Amount; i++)
						skillItems.Push(CustomInventoryItem(item));
				}
			}
		}
		
		//Draw the location header
		let nameImg = UIImage(new("UIImage")).Create
		(
			(210, 32),
			(300, 19),
			"Graphics/Inventory Icon/Name.png",
