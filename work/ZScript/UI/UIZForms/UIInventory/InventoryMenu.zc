				);
				itemIcon.Pack(mainframe);
				healIcon.Push(itemIcon);
				
				String cmd = String.Format("%s:%s:%s:%d:%s:%s",
				CustomInventoryItem(healItems[i]).invName,
				CustomInventoryItem(healItems[i]).invText,
				healItems[i].GetClassName(),
				i,
				CustomInventoryItem(healItems[i]).invLore,
				"0"
				);
				
				UIButton btn = UIButton(new("UIButton").Create
				(
					(hItemX, hItemY),
					(32, 32),
					cmdHandler: handler,
					command: cmd,
					//altcommand: "dropItem:" .. CustomInventoryItem(healItems[i]).GetClassName() .. ":" .. i .. ":" .. "1"
					hover: hoverTexture
				));
				btn.Pack(mainframe);
				healBtnHolder.Push(btn);
				allBtnHolder.Push(btn);
				
				hItemX += 32;
			}
		}
		
		if(healItems.Size() <= 0)
