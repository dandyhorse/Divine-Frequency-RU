Class DFSaveMenu : LoadSaveBase
{
    override void init(Menu parent)
	{
		Super.init(parent);
		
		//We setup the Command Handler for the Save Menu here
		cmdHandler = new("SaveMenuHandler");

		//We will need a referance to this menu in the handler so we set that up here
		SaveMenuHandler(cmdHandler).menu = self;

		//We check to see if we are on the title screen to disable saving
		if(Level.MapName == "TITLEMAP")
		{
			//Just some text telling the user they cant save on the title screen
			MainMenuText(BaseRes);
		}else
		{
			//The actual Save Menu
			SaveMenu(BaseRes);
		}
	}
	
	void MainMenuText(Vector2 Resolution)
	{
		//Create a frame to stick all of our menu stuff into
		let SaveMenu_Frame = UIFrame.create((0,0), Resolution);
		SaveMenu_Frame.pack(mainFrame);

		//Title text
		let TitleLabel = UILabel.create((0,216), (1920,540), "На титульном экране сохраняться нельзя.\nЗагрузите игру или начните новую, чтобы сохраниться!", "BIGFONT", 2, true, true, textscale: 4.0);
		TitleLabel.pack(SaveMenu_Frame);
	}

	void SaveMenu(Vector2 Resolution)
	{
		//This loads the data for the save games so we can use it later
		Manager.ReadSaveStrings();
		
		//Create a frame to stick all of our menu stuff into
		let SaveMenu_Frame = UIFrame.create((0,0), Resolution);
		SaveMenu_Frame.pack(mainFrame);

		//Title text
		let TitleLabel = UILabel.create((0,20), (1920,150), "Сохранить игру", "BIGFONT", 2, true, true, textscale: 4.0);
		TitleLabel.pack(SaveMenu_Frame);

		//Save Slot Frame
		//im going to build the contents into this frame 
		//and then use that info to create a scrollable area
		let SaveFrame = UIFrame.create((0,0), (1440,864));

		//This will fetch each save and put that info into a couple of arrays

		//SaveSlotButton - Holds all of the buttons
		//SaveSlotTitle - Holds all of the Text
		//DeleteSaveSlot - Holds all of the delete buttons
		//SaveSlotMapNumber - Not used, but it could hold the Map number as "MapXX"
		//SaveSlotMapName - Holds all of the Map Names
		//SaveSlotSaveAge - Holds all of the Play times 
		//SaveSlotTimeSaved - Holds all of The dates the saves were created

		for(int i = -1; i < manager.SavegameCount(); i++)
		{
			//If we are on the First iteration create a button to create a new save
			if(i == -1)
			{
				//This is how we create a brand new save instead of overwriting an old save
				let NewSaveSlotButton = UIButton.create((120,0), (1200,SlotSize), "", cmdHandler, 'ConfirmNewSave', SaveDefaultNormal, SaveSlotHover, SaveSlotNormal, SaveDefaultNormal);
				let NewSaveSlotTitle = UILabel.create((120,36) , (1200,76), "+" , "BIGFONT", 2, textscale: 6.0);
				NewSaveSlotTitle.SetDontBlockMouse(true);
				NewSaveSlotButton.pack(SaveFrame);
				NewSaveSlotTitle.pack(SaveFrame);
			}else
			{
				//This loads a specific save to extract its data
				manager.ExtractSaveData(i);

				//We create a Button and a Label for the Save slot itself
				//The title and button are seperate because of customization limitations in zforms for button text
				SaveSlotButton.push(UIButton.create((120,(SlotSize*(i+1))), (1200,SlotSize), "", cmdHandler, 'SaveSlot:'..i, SaveSlotNormal, SaveSlotHover, SaveSlotNormal, SaveSlotNormal));
				SaveSlotTitle.push(UILabel.create((145,(SlotSize*(i+1))+15), (1200,50), Manager.GetSaveGame(i).SaveTitle , "BIGFONT", textscale: 3.0, textColor: Font.CR_DARKGRAY));
				SaveSlotTitle[i].SetDontBlockMouse(true);

				//This is the button the controls if we delete the specific save or not
				DeleteSaveSlot.push(UIButton.create((SaveSlotButton[i].getwidth()+88,(SlotSize*(i+1))+4), (32,32), "", cmdHandler, 'ConfirmMenu'..i, DeleteSaveNormal, DeleteSaveHover, DeleteSaveNormal, DeleteSaveNormal));

				//I take the Saves description and cut it up into pieces to rearange the data on the Save Slot later
				string SaveCommentString = ""..manager.SaveCommentString;
				string TimeSaved = SaveCommentString.mid(0,10);
				//string MapNumber = SaveCommentString.mid(SaveCommentString.indexof("MAP"), 6);
				string MapName = SaveCommentString.mid(SaveCommentString.indexof("MAP")+8, SaveCommentString.indexof("Time")-(SaveCommentString.indexof("MAP")+8));
				string SaveAge = SaveCommentString.mid(11,9);

				// SaveSlotMapNumber.push(UILabel.create((25,(SlotSize*i)+70), (100,400), MapNumber , "SMALLFONT", textscale: 3.0));
				// SaveSlotMapNumber[i].SetDontBlockMouse(true);
				SaveSlotMapName.push(UILabel.create((155,(SlotSize*(i+1))+70), (1440,400), MapName , "SMALLFONT", textscale: 3.0, textColor: Font.CR_DARKGRAY));
				SaveSlotMapName[i].SetDontBlockMouse(true);

				SaveSlotSaveAge.push(UILabel.create((560,(SlotSize*(i+1))+110), (400,400), "Время: "..SaveAge , "SMALLFONT", textscale: 3.0, textColor: Font.CR_DARKGRAY));
				SaveSlotSaveAge[i].SetDontBlockMouse(true);

				SaveSlotTimeSaved.push(UILabel.create((155,(SlotSize*(i+1))+110), (600,500), "Дата: "..TimeSaved , "SMALLFONT", textscale: 3.0, textColor: Font.CR_DARKGRAY));
				SaveSlotTimeSaved[i].SetDontBlockMouse(true);

				//Pack everything into our saveFrame for use in the Scroll Area later
				SaveSlotButton[i].pack(SaveFrame);
				SaveSlotTitle[i].pack(SaveFrame);
				SaveSlotTimeSaved[i].pack(SaveFrame);
				//SaveSlotMapNumber[i].pack(SaveFrame);
				SaveSlotMapName[i].pack(SaveFrame);
				SaveSlotSaveAge[i].pack(SaveFrame);
				DeleteSaveSlot[i].pack(SaveFrame);
			}

			
		}

		//Scroll area for the Save Games
		SaveFrameScrollArea = UIScrollContainer.create((225,108), (1350,864), 15, manager.SavegameCount()*SlotSize, SlotSize, ScrollNormal, ScrollHover, ScrollHover, null, SaveFrame);
		
		//Save Frame Background
		let SaveFrameBackgroundImage = UIImage.create(SaveFrameScrollArea.getpos() - (8,7),(1448,876), "Graphics/LoadSave Menu/SaveFrameBackground.png");
		
		//Pack order is the display order
		SaveFrameBackgroundImage.pack(SaveMenu_Frame);
		SaveFrameScrollArea.pack(SaveMenu_Frame);
	}
	
	override void Drawer()
    {
	    Screen.Dim(Color(0, 0, 0), 1.0, 0, 0, Screen.GetWidth(), Screen.GetHeight());
		
	    Super.Drawer();
		
		//Draw the save game image using the converted position and size above
		Manager.DrawSavePic(RealPos.x, RealPos.y, RealSize.x, RealSize.y);
    }
	
	override bool OnUIEvent(UIEvent ev)
    {
		if(Manager.SavegameCount() > 0)
		{
			if(!overwrite_wait && !del_wait)
			{
				if(ev.Type == UIEvent.Type_KeyDown && ev.KeyChar == 26)
				{
					if(save_pic_index >= Manager.SavegameCount())
						save_pic_index--;
					  
					del_wait = true;
					overwrite_wait = false;
					SaveFrameScrollArea.Disable();
					save_title = Manager.GetSaveGame(save_pic_index).SaveTitle;
					ConfirmDelete(BaseRes, save_pic_index);
				}
			}
			else if(!overwrite_wait && del_wait)
			{
				if(ev.Type == UIEvent.Type_KeyDown && ev.KeyChar == 89) //Confirm
				{
					del_wait = false;
					overwrite_wait = false;
					SaveMenuHandler(cmdHandler).DeleteSave(save_pic_index);
					SaveFrameScrollArea.Enable();
					MenuSound("menu/prompt");
				}
				else if(ev.Type == UIEvent.Type_KeyDown && ev.KeyChar == 78) //Cancel
				{
					del_wait = false;
					overwrite_wait = false;
					Delete_Frame.unpack();
					SaveFrameScrollArea.Enable();
				}
			}
			else if(overwrite_wait && ev.Type == UIEvent.Type_KeyDown)
			{
				if(ev.KeyChar == 89) //Confirm
				{
					del_wait = false;
					overwrite_wait = false;
					Manager.ReadSaveStrings();
					Manager.RemoveSaveSlot(save_pic_index);
					EventHandler.SendNetworkEvent("ManualSave");
					Close();
				}
				else if(ev.KeyChar == 78) //Cancel
				{
					overwrite_wait = false;
					OverwriteSave_Frame.unpack();
					SaveFrameScrollArea.Enable();
				}
			}
		}
		return Super.OnUIEvent(ev);
	}
}