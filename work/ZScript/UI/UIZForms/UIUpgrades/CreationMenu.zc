class NameMenu : UIGenericMenu
{
  PlayerPawn pmo;
  NameMenuHandler handler;
  UITextInput prompt;
  Font fnt;
  
  override void Init(Menu parent)
  {
    Super.Init(parent);
	
	fnt = Font.GetFont("RU_DF_FONT");
	pmo = players[consoleplayer].mo;
	handler = new("NameMenuHandler");
    handler.menu = self;
	MenuSound("Shop_On");
    SetBaseResolution((720, 400));
	
	let rBtnTex = UIBoxTextures(new("UIBoxTextures")).createSingleTexture("Graphics/Creation/Btn_Inactive.png", false);
	let rBtnHover = UIBoxTextures(new("UIBoxTextures")).createSingleTexture("Graphics/Creation/Btn_Hover.png", false);
	let nameBG = UIBoxTextures(new("UIBoxTextures")).createSingleTexture("Graphics/Creation/PromptBG.png", false);
	
	UIImage BGSkill = UIImage(new("UIImage")).Create((360 - 75, 200 - 50), (150, 100), image: "Graphics/Creation/CreationBG.png");
	BGSkill.Pack(mainframe);
	
	let nameLabel = new("UILabel").Create
	(
	  (240, 153),
	  (240, 16),
	  text: "Введите имя персонажа:",
	  fnt: fnt,
	  alignment: UILabel.AlignType_TopCenter,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	nameLabel.Pack(mainframe);
	
	prompt = UITextInput(new("UITextInput")).Create(
	(297, 169),
	(128, 16),
	fnt, 0.5,
	cmdhandler: handler);
	prompt.Pack(mainframe);
	
	prompt.setTyping();
	
	UIButton rYes = UIButton(new("UIButton").Create
	(
	  (335, 197),
	  (50, 16),
	  "Принять",
	  cmdHandler: handler,
	  command: "AcceptName",
	  inactive : rBtnTex,
	  hover: rBtnHover,
	  click: rBtnTex,
	  fnt: fnt,
	  textscale: 0.5,
	  alignment: UIButton.AlignType_Center
	));				
	rYes.Pack(mainframe);
  }
  
  override bool menuEvent(int mkey, bool fromcontroller)
  {
    if(mkey == MKEY_Enter)
	  handler.Confirm();
	
    return Super.menuEvent(mkey, fromController);
  }
  
  override void Drawer()
  {
    Screen.Dim(Color(0, 0, 0), 1.0, 0, 0, Screen.GetWidth(), Screen.GetHeight());
	
    Super.Drawer();
  }
}

class NameMenuHandler : UIHandler
{
  NameMenu menu;
  
  void Confirm()
  {
    EventHandler.SendNetworkEvent("SetName:" .. menu.prompt.getText());
	Menu.MenuSound("Diag_Sel");
	Menu.Close();
  }
  
  override void ButtonClickCommand(UIButton caller, Name command)
  {
	if(command == "AcceptName")
	  Confirm();
  }
}

class NameActivator : Inventory
{
  Default
  {
	Inventory.Amount 1;
	+Inventory.UNDROPPABLE
  }

  override bool Use(bool pickup)
  {
	if(owner == null)
	  return true;

	if(owner == players[consoleplayer].mo)
	  Menu.SetMenu("NameMenu");

	  return false;
  }
}