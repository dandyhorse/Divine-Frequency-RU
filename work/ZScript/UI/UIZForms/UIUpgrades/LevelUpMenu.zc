class LevelUpMenu : UIGenericMenu
{
  static const int cost[] = {8000, 12000, 24000, 9999999999, 9999999999};
  
  Font fnt;
  PlayerPawn pmo;
  bool startBG, drawBG, canMutate;
  double fAlp, fiAlp, fScale;
  String PrimaryName, SecondaryName, TertiaryName;
  int alpheros, sc, PriCount, SecCount, TetCount;
  
  UIFrame UPGPanel, UPGInfo;
  UILabel PriCur, PriCost, SecCur, SecCost, TetCur, TetCost;
  UILabel expCur, lInfo;
  Array<UIButton> bootuns;
  LevelUpHandler handler;
  
  //Confirmation
  string upg_command;
  bool confirm_wait;
  UIButton btn_confirm, btn_cancel;
  UIFrame confirm_box, confirm_bound;
  UILabel confirm_msg;
  
  override void Ticker()
  {
	Super.Ticker(); 
	
	if(!canMutate && pmo && DFPlayer(pmo).bBase_Phy)
	{
	  CreateMenuTabs();
	  canMutate = true;
	}
	
	if(fiAlp >= 1.0 && alpheros > 0)
	{
	  alpheros--;
	  fScale += 0.01;
	}
	
	if(alpheros == 1)
	  startBG = true;
	
	if(fiAlp < 1.0)
	  fiAlp += 0.1;
	  
	if(fiAlp >= 1.0 && fAlp > 0.0)
	  fAlp -= 0.1;
	  
	if(startBG && sc > 0)
	  sc--;
	  
	if(sc == 0)
	{
	  mainframe.show();
	  drawBG = true;
	  sc--;
	}

	if(pmo)
	{
	  if(DFPlayer(pmo).statBase ~== "Str")
	  {
		PriCount = pmo.CountInv("StrToken");
		SecCount = pmo.CountInv("WitToken");
		TetCount = pmo.CountInv("PhyToken");
	  }
	  else if(DFPlayer(pmo).statBase ~== "Wit")
	  {
		PriCount = pmo.CountInv("WitToken");
		SecCount = pmo.CountInv("StrToken");
		TetCount = pmo.CountInv("PhyToken");
	  }
	  else if(DFPlayer(pmo).statBase ~== "Phy")
	  {
		PriCount = pmo.CountInv("PhyToken");
		SecCount = pmo.CountInv("StrToken");
		TetCount = pmo.CountInv("WitToken");
	  }
	  
	  if(expCur)
	    expCur.setText(String.Format("Текущая экзальтация: \cF%d", pmo.CountInv("ExaltXP")));
	  
	  if(PriCur)
	    PriCur.setText(String.Format("Улучшение %s: %d -> %d", PrimaryName, PriCount, PriCount + 1));
	  
	  if(PriCost)
	    PriCost.setText(String.Format("Стоимость: %d", cost[PriCount]));
	  
	  if(SecCur)
	    SecCur.setText(String.Format("Улучшение %s: %d -> %d", SecondaryName, SecCount, SecCount + 1));
	  
	  if(SecCost)
	    SecCost.setText(String.Format("Стоимость: %d", cost[SecCount]));
	  
	  if(TetCur)
	    TetCur.setText(String.Format("Улучшение %s: %d -> %d", TertiaryName, TetCount, TetCount + 1));
	  
	  if(TetCost)
	    TetCost.setText(String.Format("Стоимость: %d", cost[TetCount]));
	}
  }
	
  override void Init(Menu parent)
  {
    Super.Init(parent);
		
	fnt = Font.GetFont("RU_DF_FONT");
	pmo = players[consoleplayer].mo;
	handler = new("LevelUpHandler");
    handler.menu = self;
    SetBaseResolution((720, 400));
	bootuns.Clear();
	
	if(DFPlayer(pmo).upgradeUsed)
	{
	  alpheros = 0;
	  fAlp = 0.0;
	  fiAlp = 1.0;
	  fScale = 1.0;
	  sc = 0;
	}
	else
	{
	  MenuSound("Level_On");
	  alpheros = 15;
	  fAlp = 1.0;
	  fiAlp = 0.0;
	  fScale = 1.0;
	  sc = 12;
	}
	
	let ShopBG = UIImage(new("UIImage")).Create((110, 75), (501, 250), "Graphics/LevelUpBG.png", imagescale: (0.5,0.5));
	ShopBG.Pack(mainframe); 
	UPGPanel = UIFrame(new("UIFrame")).Create((111, 76), (249,248));
	UPGPanel.Pack(mainframe);
	lInfo = new("UILabel").Create((365, 76), (241, 248), fnt: fnt, textscale: 0.4);
	lInfo.Pack(mainframe);
	
	if(pmo)
	{
	  if(DFPlayer(pmo).statBase ~== "Str")
	  {
	    PrimaryName = "Сила";
		SecondaryName = "Разум";
		TertiaryName = "Телосложение";
		PriCount = pmo.CountInv("StrToken");
		SecCount = pmo.CountInv("WitToken");
		TetCount = pmo.CountInv("PhyToken");
		SetupPrimary(String.Format("StrToken:$Str_Info:$Str_%d:%d:0", PriCount, cost[PriCount]));
		SetupSecondary(String.Format("WitToken:$Wit_Info:$Wit_%d:%d:1", SecCount, cost[SecCount]), String.Format("PhyToken:$Phy_Info:$Phy_%d:%d:2", TetCount, cost[TetCount]));
	  }
	  else if(DFPlayer(pmo).statBase ~== "Wit")
	  {
	    PrimaryName = "Разум";
		SecondaryName = "Сила";
		TertiaryName = "Телосложение";
		PriCount = pmo.CountInv("WitToken");
		SecCount = pmo.CountInv("StrToken");
		TetCount = pmo.CountInv("PhyToken");
		SetupPrimary(String.Format("WitToken:$Wit_Info:$Wit_%d:%d:0", PriCount, cost[PriCount]));
		SetupSecondary(String.Format("StrToken:$Str_Info:$Str_%d:%d:1", SecCount, cost[SecCount]), String.Format("PhyToken:$Phy_Info:$Phy_%d:%d:2", TetCount, cost[TetCount]));
	  }
	  else if(DFPlayer(pmo).statBase ~== "Phy")
	  {
	    PrimaryName = "Телосложение";
		SecondaryName = "Сила";
		TertiaryName = "Разум";
		PriCount = pmo.CountInv("PhyToken");
		SecCount = pmo.CountInv("StrToken");
		TetCount = pmo.CountInv("WitToken");
		SetupPrimary(String.Format("PhyToken:$Phy_Info:$Phy_%d:%d:0", PriCount, cost[PriCount]));
		SetupSecondary(String.Format("StrToken:$Str_Info:$Str_%d:%d:1", SecCount, cost[SecCount]), String.Format("WitToken:$Wit_Info:$Wit_%d:%d:2", TetCount, cost[TetCount]));
	  }
	}
	
	UIImage expBG = UIImage(new("UIImage")).Create((262, 327), (197, 16), image: "Graphics/Codex/Bestiary/bInfoHeader.png");
	expBG.Pack(mainframe); //262, 357
	UIImage expIcon = UIImage(new("UIImage")).Create((264, 329), (13, 13), image: "EK_ICON", imagescale: (0.5, 0.5));
	expIcon.Pack(mainframe);
	expCur = new('UILabel').Create((278, 327), (165, 16), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.45);
	expCur.Pack(mainframe);
	mainframe.hide();
	String nHelpText = String.Format("\cD[Esc] \cJВыйти ");
	UILabel nHelp = new('UILabel').Create
	(
	  (516, 385),
	  (200, 36),
	  text: nHelpText,
	  fnt: fnt,
	  alignment: UILabel.AlignType_CenterRight,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	nHelp.Pack(mainframe);
	
	//Confirmation stuff
	confirm_bound = UIFrame.Create((0,0), (720,400));
	confirm_bound.Pack(mainframe);
	confirm_bound.hide();
	let confirm_bound_img = UIImage.Create((0, 0), (720, 400), "Graphics/GunUpgrade/Confirm_Bound.png", imagescale: (4.0,4.0));
	confirm_bound_img.Pack(confirm_bound);
	
	confirm_box = UIFrame.Create((260,150), (202,74));
	
	let confirm_box_img = UIImage.Create((0, 0), (202, 74), "Graphics/GunUpgrade/Confirm_Box.png");
	confirm_box_img.Pack(confirm_box);
	
	let confirm_inactive = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button.png", true);
	let confirm_hover = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button2.png", true);
	confirm_msg = UILabel.Create
	(
	  (0, 0), (200, 32),
	  text: "", fnt: fnt,
	  alignment: UILabel.AlignType_Center,
	  textScale: 0.45
	);
	confirm_msg.Pack(confirm_box);
	
	btn_confirm = UIButton.Create((24, 36), (64, 24),
	"Подтвердить", handler,
	"Confirm_Choice",
	inactive: confirm_inactive,
	hover: confirm_hover,
	click: confirm_inactive,
	fnt: fnt, textScale: 0.45);
	btn_confirm.Pack(confirm_box);
	
	btn_cancel = UIButton.Create((112, 36), (64, 24),
	"Отмена", handler,
	"Cancel_Choice",
	inactive: confirm_inactive,
	hover: confirm_hover,
	click: confirm_inactive,
	fnt: fnt, textScale: 0.45);
	btn_cancel.Pack(confirm_box);
	
	confirm_box.Pack(mainframe);
	confirm_box.Hide();
  }
	
  override bool OnUIEvent(UIEvent ev)
  {
    for(int i = 0; i < bootuns.Size(); i++)
	{
	  if(bootuns[i].isHovered() || confirm_wait)
	    break;
		
	  if(i == bootuns.Size() -1 && !bootuns[i].isHovered())
	    lInfo.setText("");
	}
	
	if(ev.type == UIEvent.Type_RButtonDown)
	{
	  if(confirm_wait)
	  {
	    confirm_bound.hide();
		confirm_box.hide();
		confirm_wait = false;
	  }
	  else
	    Close();
	}
	else if(ev.type == UIEvent.Type_KeyDown)
	{
	  if((ev.KeyChar == 32 || ev.KeyChar == 89) && confirm_wait)
	    handler.Confirm();
	}
	
	return Super.OnUIEvent(ev);
  }
  
  override bool menuEvent(int mkey, bool fromcontroller)
  {
    if(mkey == MKEY_Enter && confirm_wait)
	  handler.Confirm();
	
    return Super.menuEvent(mkey, fromController);
  }
  
  override void handleBack()
  {
    if(confirm_wait)
	{
	  confirm_bound.hide();
	  confirm_box.hide();
	  confirm_wait = false;
	}
	else
	  Super.handleBack();
  }
  
  void SetupPrimary(string cmd)
  {
    string note = "\cI*Note: \cFSynergy Bonus\cI can only be acquired it if matches the waveform you've synchronized with.\n\n\cJYour chosen waveform: ";
	let pmo = players[consoleplayer].mo;
	
	if(DFPlayer(pmo).bStrOrigin)
	  note.AppendFormat("\cFLow Vibration");
	else if(DFPlayer(pmo).bWitOrigin)
	  note.AppendFormat("\cFHigh Vibration");
	else
	  note.AppendFormat("\cFChaotic Vibration");
	
	
	UIBoxTextures ht = UIBoxTextures(new("UIBoxTextures")).createSingleTexture("Graphics/LUHover.png", false);
	let btnIMG = UIImage(new("UIImage")).Create((9, 24), (234, 41), "Graphics/LevelButton.png");
	btnIMG.Pack(UPGPanel);
	let pText = UILabel(new("UILabel")).Create((4, 2), (241, 20),  //4,2
	"\cFPRIMARY ATTRIBUTE", fnt: fnt, textscale: 0.7);
	pText.SetAlpha(0.7);
	pText.Pack(UPGPanel);
	let pTextTip = UILabel(new("UILabel")).Create((8, 68), (237, 56),  //4,2
	note, fnt: fnt, textscale: 0.4);
	pTextTip.Pack(UPGPanel);
	PriCur = new("UILabel").Create((13, 28), (233, 16), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.5);
	PriCur.Pack(UPGPanel);
	PriCost = new("UILabel").Create((13, 50), (233, 11), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.45);
	PriCost.Pack(UPGPanel);
	
	let PButton = UIButton(new("UIButton").Create 
	(
	  (9, 24),
	  (234, 41),
	  cmdHandler: handler,
	  command: cmd,
	  inactive : null,
	  hover: ht,
	  click: null,
	  fnt: fnt,
	  textscale: 0.5,
	  alignment: UIButton.AlignType_CenterLeft
	));
	bootuns.Push(PButton);
	PButton.Pack(UPGPanel);
  }
  
  void SetupSecondary(String cmd1, String cmd2)
  {
    UIBoxTextures ht = UIBoxTextures(new("UIBoxTextures")).createSingleTexture("Graphics/LUHover.png", false);
	let btnIMG1 = UIImage(new("UIImage")).Create((9, 153), (234, 41), "Graphics/LevelButton.png");
	let sText = UILabel(new("UILabel")).Create((4, 131), (241, 20),  //4,2
	"ВТОРИЧНЫЕ АТРИБУТЫ", fnt: fnt, textscale: 0.7);
	sText.SetAlpha(0.5);
	sText.Pack(UPGPanel);
	btnIMG1.Pack(UPGPanel);
	SecCur = new("UILabel").Create((13, 157), (233, 16), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.5);
	SecCur.Pack(UPGPanel);
	SecCost = new("UILabel").Create((13, 179), (233, 11), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.45);
	SecCost.Pack(UPGPanel);
	let SButton1 = UIButton(new("UIButton").Create 
	(
	  (9, 153),
	  (234, 41),
	  cmdHandler: handler,
	  command: cmd1,
	  inactive : null,
	  hover: ht,
	  click: null,
	  fnt: fnt,
	  textscale: 0.5,
	  alignment: UIButton.AlignType_CenterLeft
	));
	bootuns.Push(SButton1);
	SButton1.Pack(UPGPanel);
	
	let btnIMG2 = UIImage(new("UIImage")).Create((9, 201), (234, 41), "Graphics/LevelButton.png");
	btnIMG2.Pack(UPGPanel);
	TetCur = new("UILabel").Create((13, 205), (233, 16), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.5);
	TetCur.Pack(UPGPanel);
	TetCost = new("UILabel").Create((13, 227), (233, 11), fnt: fnt, UILabel.AlignType_CenterLeft, textscale: 0.45);
	TetCost.Pack(UPGPanel);
	let SButton2 = UIButton(new("UIButton").Create 
	(
	  (9, 201),
	  (234, 41),
	  cmdHandler: handler,
	  command: cmd2,
	  inactive : null,
	  hover: ht,
	  click: null,
	  fnt: fnt,
	  textscale: 0.5,
	  alignment: UIButton.AlignType_CenterLeft
	));
	bootuns.Push(SButton2);
	SButton2.Pack(UPGPanel);
  }
  
  void CreateMenuTabs()
  {
    UIBoxTextures inactiveTexture = UIBoxTextures(new('UIBoxTextures')).createSingleTexture("Graphics/Shop/TabInactive.png", false);
	UIBoxTextures hoverTexture = UIBoxTextures(new('UIBoxTextures')).createSingleTexture("Graphics/Codex/TabHover.png", false);
	
	UIFrame tabFrame = UIFrame(new("UIFrame")).Create((295, 32), (130, 24));
	tabFrame.Pack(mainframe);
	
	UIImage tbg = UIImage(new("UIImage")).Create((0, 0), (130, 24), image: "Graphics/Shop/MenuSwap.png");
	tbg.Pack(tabFrame);
	
	UIButton lvl = UIButton(new("UIButton")).Create((0, 0), (64, 24), "Экзальтация", handler, "ChangeMenu:LevelUpMenu",
	inactive : null,
	hover: hoverTexture,
	click: null,
	fnt: fnt,
	textscale: 0.5,
	alignment: UIButton.AlignType_Center
	);
	lvl.pack(tabFrame);
	
	UIButton mut = UIButton(new("UIButton")).Create((64, 0), (64, 24), "Мутация", handler, "ChangeMenu:MutationMenu",
	inactive : null,
	hover: hoverTexture,
	click: null,
	fnt: fnt,
	textscale: 0.5,
	alignment: UIButton.AlignType_Center
	);
	mut.pack(tabFrame);
	
    String nHelpText = String.Format("\cD[Esc] \cJВыйти ");
	UILabel nHelp = new('UILabel').Create
	(
	  (516, 385),
	  (200, 36),
	  text: nHelpText,
	  fnt: fnt,
	  alignment: UILabel.AlignType_CenterRight,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	nHelp.Pack(mainframe);
  }
  
  override void Drawer()
  {
	Screen.Dim(Color(8, 8, 8), 0.85, 0, 0, Screen.GetWidth(), Screen.GetHeight());
	
	//DEFAULT BACKGROUND
	if(drawBG)
	{
	  TextureID bg = TexMan.CheckForTexture("SHOP_07", TexMan.Type_Any);
	  Screen.DrawTexture(bg, true, 0, 0,
	  DTA_DestWidth, Screen.GetWidth(),
	  DTA_DestHeight, Screen.GetHeight());
	}
	
	mainframe.fill((90,55), (540,290), Color(0,0,0), 0.8);
	
    Super.Drawer();
	
	//NO SIGNAL GLITCH VFXs
    if(sc > 0)
	{
	  double nsAl = 1.0;
	  if(fiAlp < 1.0)
	    nsAl = 0.01;
		
	  TextureID sbg = TexMan.CheckForTexture("SHOP_01", TexMan.Type_Any);
	  Screen.DrawTexture(sbg, true, 0, 0,
	  DTA_DestWidth, Screen.GetWidth(),
	  DTA_DestHeight, Screen.GetHeight(),
	  DTA_Alpha, nsAl);
	}
	
	//UNIVERSE'S LINKING VFX
	if(alpheros > 0.0)
	{
	  double al = 1.0;
	  if(fiAlp < 1.0)
	    al = 0.01;
	  
	  TextureID tex = TexMan.CheckForTexture("ShopBG", TexMan.Type_Any);
	  Screen.DrawTexture(tex, true, Screen.GetWidth() * 0.5, Screen.GetHeight() * 0.5,
	  DTA_DestWidth, Screen.GetWidth(),
	  DTA_DestHeight, Screen.GetHeight(),
	  DTA_ScaleX, fScale,
	  DTA_ScaleY, fScale,
	  DTA_Alpha, al,
	  DTA_FlipX, random(0,1),
	  DTA_CenterOffset, true);
	}
	
	//INTRO WHITE FLASH
	if(fiAlp >= 1.0 && fAlp > 0.0)
	  Screen.Dim(Color(152, 152, 152), fAlp, 0, 0, Screen.GetWidth(), Screen.GetHeight());
	  
	if(fiAlp < 1.0)
	  Screen.Dim(Color(152, 152, 152), fiAlp, 0, 0, Screen.GetWidth(), Screen.GetHeight());
  }
}

class LevelUpHandler : UIHandler
{
  LevelUpMenu menu;
  string commandList;
  
  bool canBuy(int cost)
  {
    PlayerPawn pmo = players[consoleplayer].mo;
	int cur = pmo.CountInv("ExaltXP");
	
	if(cur >= cost)
	  return true;
	  
	return false;
  }
  
  void Confirm()
  {
    PlayerPawn pmo = players[consoleplayer].mo;
    Array<String> c_cmd;
	menu.upg_command.Split(c_cmd, ":");
	  
	EventHandler.SendNetworkEvent(String.Format("LevelUpBoi:%s:%d", c_cmd[0], c_cmd[3].ToInt(10)));
	menu.MenuSound("ADB_Psi");
	  
	String sNew = String.Format("%s%d", c_cmd[2].Left(5), pmo.CountInv(c_cmd[0]) + 1);
	int pCheck = c_cmd[4].ToInt(10);
	if(pCheck == 0)
	  c_cmd[3] = String.Format("%d", menu.cost[pmo.CountInv(c_cmd[0]) + 1]);
	else
	  c_cmd[3] = String.Format("%d", menu.cost[pmo.CountInv(c_cmd[0]) + 1]);
		
	if(menu.lInfo)
	  menu.lInfo.setText(StringTable.Localize(c_cmd[1]) .. StringTable.Localize(sNew));
		
	if(menu.bootuns[c_cmd[4].ToInt(10)])
	{
	  String newCMD = String.Format("%s:%s:%s:%s:%s", c_cmd[0], c_cmd[1], sNew, c_cmd[3], c_cmd[4]);
	  menu.bootuns[c_cmd[4].ToInt(10)].SetCommand(newCMD);
	}
	  
	menu.confirm_bound.hide();
	menu.confirm_box.hide();
	menu.confirm_wait = false;
  }
	
  override void elementHoverChanged(UIElement caller, Name command, bool unhovered)
  {
	if(!unhovered)
	{
	  Array<String> cmd;
	  cmd.Clear();
	  commandList = command;
	  commandList.Split(cmd, ":");
	  
	  if(cmd[0] != "ChangeMenu" && cmd[0] != "Confirm_Choice" && cmd[0] != "Cancel_Choice" && menu.lInfo)
	    menu.lInfo.setText(StringTable.Localize(cmd[1]) .. StringTable.Localize(cmd[2]));
	}
  }
  
  override void ButtonClickCommand(UIButton caller, Name command)
  {
	Array<String> cmd;
	cmd.Clear();
	commandList = command;
	commandList.Split(cmd, ":");

	PlayerPawn pmo = players[consoleplayer].mo;
	
	if(cmd[0] ~== "ChangeMenu")
	{
	  if(cmd[1] != "LevelUpMenu")
	  {
	    Menu.Close();
	    Menu.SetMenu(cmd[1]);
		Menu.MenuSound("menu/clear");
	  }
	}
	else if(cmd[0] ~== "Confirm_Choice")
	{
	  Confirm();
	}
	else if(cmd[0] ~== "Cancel_Choice")
	{
	  menu.confirm_bound.hide();
	  menu.confirm_box.hide();
	  menu.confirm_wait = false;
	}
	else if(pmo && canBuy(cmd[3].ToInt(10)))
	{
	  string text = "Подтвердить выбор: \cF";
	  if(cmd[0] ~== "StrToken")
	    text.AppendFormat("Улучшение Силы\cJ?");
	  else if(cmd[0] ~== "WitToken")
	    text.AppendFormat("Улучшение Разума\cJ?");
	  else
	    text.AppendFormat("Улучшение Телосложения\cJ?");
		
	  menu.MenuSound("M_Click1");
	  menu.confirm_msg.setText(text);
	  menu.upg_command = command;
	  menu.confirm_bound.Show();
	  menu.confirm_box.Show();
	  menu.confirm_wait = true;
	}
  }
}

Class God_Crystal : Actor
{
  override bool Used(Actor user)
  {
    if(user && user is "DFPlayer")
	{
	  Menu.SetMenu("LevelUpMenu");
	  DFPlayer(user).upgradeUsed = self;
	}
	return true;
  }
  
  Default
  {
    Radius 25;
    Height 75;
	FloatBobStrength 0.05;
	FloatBobPhase 1;
	RenderStyle "Translucent";
	//Alpha 0.7;
	XScale 0.6;
	YScale 0.5;
	+FLOATBOB
    +NOGRAVITY
	+SOLID
  }
  
  States
  {
    Spawn:
	  TNT1 A 0 NoDelay A_SpawnItemEx("God_Hand", zofs: 10, tid: tid);
	  DIC1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2 Light("UpgradeStationPulse");
	  DIC2 ABCDEF 2 Light("UpgradeStationPulse");
	  Goto Spawn+1;
  }
}

Class God_Hand : Actor
{
  Default
  {
	FloatBobStrength 0.05;
	FloatBobPhase 1;
	RenderStyle "Add";
	Alpha 0.4;
	Scale 0.4;
	+NOINTERACTION
	+FLOATBOB
	+BRIGHT
  }
  
  States
  {
    Spawn:
	  GODH A -1;
	  Stop;
  }
}

Class God_Crystal_Spawner : Actor
{
  Default
  {
    RenderStyle "AddStencil";
	StencilColor "0080FF";
	XScale 3.0;
	YScale 2.5;
	+BRIGHT
    +NOINTERACTION
  }
  States
  {
    Spawn:
	  TNT1 A 0 NoDelay A_StartSound("GodHand", CHAN_AUTO, volume: 0.7, attenuation: 0.1);
	  TNT1 A 0
	  {
	    A_SpawnItemEx("God_Crystal", flags: SXF_NOCHECKPOSITION);
		A_SpawnParticleEx("0066CC", TexMan.CheckForTexture("BWAVA0"), STYLE_AddShaded, SPF_FULLBRIGHT|SPF_RELATIVE, 35, 256,
		startalphaf: 0.4, fadestepf: 0.025, sizestep: 100.0);
		A_SpawnParticleEx("0066CC", TexMan.CheckForTexture("BWAVA0"), STYLE_AddShaded, SPF_FULLBRIGHT|SPF_RELATIVE, 35, 256,
		startalphaf: 0.4, fadestepf: 0.025, sizestep: 100.0);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("EXPFC0"), STYLE_Add, SPF_FULLBRIGHT|SPF_RELATIVE, 5, 250, 250);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("EXPFC0"), STYLE_Add, SPF_FULLBRIGHT|SPF_RELATIVE, 5, 250, 250);
		A_QuakeEx(2, 2, 4, 60, 0, 2000, "dsempty");
		if(players[consoleplayer].mo)
		  players[consoleplayer].mo.A_SetBlend("CDE8FF", 0.8, 60);
	  }
	  MDM2 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1
	  {
	    for(int i = 0; i < 32; i++)
	    {
	      int pit = random(-90,90);
		  int ang = random(0,359);
		  Vector3 newPos = 128.0 * (cos(pit) * cos(ang), cos(pit) * sin(ang), sin(pit) * 0.83);
		  Vector3 newVel = 0.1 * newPos;
		  A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SPFLE0"), STYLE_Add, SPF_FULLBRIGHT|SPF_RELATIVE, 105, 20, 0,
		  newPos.x, newPos.y, newPos.z, newVel.x, newVel.y, newVel.z, -0.01 * newVel.x, -0.01 * newVel.y, -0.01 * newVel.z);
	    }
	  }
	  MDM3 ABCD 1;
	  Stop;
  }
}

class LevelUpActivator : Inventory
{
  Default
  {
	Inventory.Amount 1;
	+Inventory.UNDROPPABLE
  }

  override bool Use(bool pickup)
  {
	if(owner == null)
	  return true;

	if(owner == players[consoleplayer].mo)
	{
	  Menu.SetMenu("LevelUpMenu");
	  DFPlayer(owner).upgradeUsed = true;
	}
	  
	return false;
  }
}