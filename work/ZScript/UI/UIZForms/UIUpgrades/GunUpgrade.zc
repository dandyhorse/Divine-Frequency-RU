class GunMenu : UIGenericMenu
{
  static const string uNames[] = {
  "\cFFull-Auto",
  "\cFDaish Oscillator",
  "\cVStrange Blue Glyph",
  "\cFTerminal Velocity",
  "\cFCharon Cycler",
  "\cIStrange Orange Glyph",
  "\cFLethal Gas",
  "\cFChemical Twist",
  "\cRStrange Red Glyph",
  "Модификация ствола",
  "Увеличенный магазин",
  "Экзотическая пороховая смесь"
  };
  //Upgrade_cmd - Description - Uses attunement
  static const string bCmds[] = {
  "w_HandgunAuto:$G_FullAuto",
  "w_HandgunProtect:$G_Dur",
  "Psi_Handgun:$G_PsiBlue",
  "w_ShotgunVel:$G_TV",
  "w_ShotgunReload:$G_Tube",
  "Psi_Shotgun:$G_PsiOrange",
  "w_SprayLethal:$G_Lethal",
  "w_SpraySave:$G_Chem",
  "Psi_Spray:$G_PsiRed",
  "n:$G_AR1",
  "n:$G_AR2",
  "n:$G_AR3"
  };

  Font fnt, numfnt;
  PlayerPawn pmo;
  GunMenuHandler handler;
  UIBoxTextures btnInactive, btnHover, sbFG, sbBG, sbHov;
  UIFrame InfoFrame, ButtonFrame;
  UILabel UpgradeText, nSelect, Cur_Attunement;
  UIScrollContainer UpgradeList;
  int btnY, crop;
  Array<UIButton> bootuns;
  Array<UIImage> pictures;
  
  //Confirmation
  string upg_command;
  bool confirm_wait;
  UIButton btn_confirm, btn_cancel;
  UIFrame confirm_box, confirm_bound;
  UILabel confirm_msg;
  
  override void Init(Menu parent)
  {
    Super.Init(parent);
	
	fnt = Font.GetFont("RU_DF_FONT");
	numfnt = Font.GetFont("BIGNUMFONT");
	pmo = players[consoleplayer].mo;
	handler = new("GunMenuHandler");
    handler.menu = self;
	crop = 1;
	
    SetBaseResolution((720, 400));
	pmo.A_StartSound("GM_On", CHAN_VOICE, CHANF_UI);
	pmo.A_StartSound("GM_Loop", CHAN_VOICE, CHANF_UI|CHANF_OVERLAP |CHANF_LOOPING);
	
	let UpgBG = UIImage.Create((0, 0), (720, 400), "GU4_1");
	UpgBG.Pack(mainframe);
	
	btnInactive = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Upgrade02.png", false);
	btnHover = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Upgrade01.png", false);
	sbFG = UIBoxTextures.createSingleTexture("Graphics/Codex/ScrollFG.png", false);
	sbBG = UIBoxTextures.createSingleTexture("Graphics/Codex/ScrollBG.png", false);
	sbHov = UIBoxTextures.createSingleTexture("Graphics/Codex/ScrollHover.png", false);
	
	let UpgHG1 = UIImage.Create((490, 100), (200, 260), "GU6_1", imageScale: (0.5, 0.5));
	upgHG1.SetAlpha(0.2);
	UpgHG1.Pack(mainframe);
	
	ButtonFrame = UIFrame.Create((30, 100), (200, 260));
	ButtonFrame.Pack(mainframe);
	InfoFrame = UIFrame.Create((270, 185), (180, 168));
	InfoFrame.Pack(mainframe);
	UpgradeText = UILabel.Create((4, 2), (172, 164),
	"", fnt: fnt, textscale: 0.45, lineSpacing: 0);
	UpgradeText.Pack(InfoFrame);
	let UpgBoxBG = UIImage.Create((20, 90), (220, 280), "Graphics/GunUpgrade/UpgBoxBound.png");
	UpgBoxBG.Pack(mainframe);
	let NFORBoxBG = UIImage.Create((260, 175), (210, 188), "Graphics/GunUpgrade/NFOBoxBound.png");
	NFORBoxBG.Pack(mainframe);
	let EXTRBoxBG = UIImage.Create((480, 90), (220, 280), "Graphics/GunUpgrade/UpgBoxBound.png");
	EXTRBoxBG.Pack(mainframe);
	
	let UpgHG2 = UIImage.Create((258, 0), (241, 205), "GU1_1", imageScale: (0.67,0.67));
	upgHG2.SetAlpha(0.7);
	upgHG2.Pack(mainframe);
	
	let UpgLT1 = UIImage.Create((20, 0), (228, 94), "GU2_1", imageScale: (0.65,0.65));
	UpgLT1.Pack(mainframe);
	let UpgLT2 = UIImage.Create((485, -16), (218, 130), "GU3_1", imageScale: (0.9,0.9));
	UpgLT2.Pack(mainframe);
	
	
	UpgradeList = new("UIScrollContainer").Create(
	(30, 100),
	(200, 260),
	4, UpgradePanelHeight(), 12.0,
	sbFG, sbHov, sbFG, sbBG,
	scrollArea: null
	);
	UpgradeList.Pack(mainframe);
	
	SetupButtons();
	
	String nHelpText = String.Format("\cD[Esc] \cJВыйти ");
	UILabel nHelp = UILabel.Create
	(
	  (516, 385),
	  (200, 36),
	  text: nHelpText,
	  fnt: fnt,
	  alignment: UILabel.AlignType_CenterRight,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	nHelp.Pack(mainframe);
	
	nSelect = UILabel.Create
	(
	  (0, 70),
	  (200, 36),
	  text: "\cF[Select a Weapon Modification]",
	  fnt: fnt,
	  alignment: UILabel.AlignType_CenterRight,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	nSelect.Pack(mainframe);
	

	Cur_Attunement = UILabel.Create
	(
	  (218, 157),
	  (200, 36),
	  text: "",
	  fnt: fnt,
	  alignment: UILabel.AlignType_CenterRight,
	  wrap: true,
	  autoSize: true,
	  textScale: 0.45
	);
	Cur_Attunement.Pack(mainframe);
	
	confirm_bound = UIFrame.Create((0,0), (720,400));
	confirm_bound.Pack(mainframe);
	confirm_bound.hide();
	let confirm_bound_img = UIImage.Create((0, 0), (720, 400), "Graphics/GunUpgrade/Confirm_Bound.png", imagescale: (4.0,4.0));
	confirm_bound_img.Pack(confirm_bound);
	
	confirm_box = UIFrame.Create((260,150), (202,74));
	
	let confirm_box_img = UIImage.Create((0, 0), (202, 74), "Graphics/GunUpgrade/Confirm_Box.png");
	confirm_box_img.Pack(confirm_box);
	
	let confirm_inactive = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button.png", true);
	let confirm_hover = UIBoxTextures.createSingleTexture("Graphics/GunUpgrade/Confirm_Button2.png", true);
	confirm_msg = UILabel.Create
	(
	  (0, 0), (200, 32),
	  text: "", fnt: fnt,
	  alignment: UILabel.AlignType_Center,
	  textScale: 0.45
	);
	confirm_msg.Pack(confirm_box);
	
	btn_confirm = UIButton.Create((24, 36), (64, 24),
	"Подтвердить", handler,
	"Confirm_Choice",
	inactive: confirm_inactive,
	hover: confirm_hover,
	click: confirm_inactive,
	fnt: fnt, textScale: 0.45);
	btn_confirm.Pack(confirm_box);
	
	btn_cancel = UIButton.Create((112, 36), (64, 24),
	"Отмена", handler,
	"Cancel_Choice",
	inactive: confirm_inactive,
	hover: confirm_hover,
	click: confirm_inactive,
	fnt: fnt, textScale: 0.45);
	btn_cancel.Pack(confirm_box);
	
	confirm_box.Pack(mainframe);
	confirm_box.Hide();
  }
  
  override void Ticker()
  {
    Super.Ticker();
	
    if(!UpgradeList.containsMouse() && !confirm_wait)
	    UpgradeText.setText("");
		
	if(crop < 200)
	  crop *= 2;
  }
  
  override void Drawer()
  {
	Screen.Dim(Color(8, 8, 8), 0.85, 0, 0, Screen.GetWidth(), Screen.GetHeight());
	mainframe.fill((30,100), (200,260), Color(0,0,0), 0.8);
	mainframe.fill((270,185), (180,168), Color(0,0,0), 0.8);
	Super.Drawer();
	if(crop < 200)
	{
	  mainframe.fill((0,0 - crop), (720,200), Color(0,0,0), 1.0);
	  mainframe.fill((0,200 + crop), (720,200), Color(0,0,0), 1.0);
	}
  }
  
  override bool OnUIEvent(UIEvent ev)
  {
	if(ev.type == UIEvent.Type_RButtonDown)
	{
	  if(confirm_wait)
	  {
	    confirm_bound.hide();
		confirm_box.hide();
		confirm_wait = false;
	  }
	  else
	    Close();
	}
	else if(ev.type == UIEvent.Type_KeyDown)
	{
	  if((ev.KeyChar == 32 || ev.KeyChar == 89) && confirm_wait)
	    handler.Confirm();
	}
	return Super.OnUIEvent(ev);
  }
  
  override bool menuEvent(int mkey, bool fromcontroller)
  {
    if(mkey == MKEY_Enter && confirm_wait)
	  handler.Confirm();
	
    return Super.menuEvent(mkey, fromController);
  }
  
  override void handleBack()
  {
    if(confirm_wait)
	{
	  confirm_bound.hide();
	  confirm_box.hide();
	  confirm_wait = false;
	}
	else
	  Super.handleBack();
  }
  
  int UpgradePanelHeight()
  {
    let pmo = players[consoleplayer].mo;
	uint y = 0;
	
	if(pmo.FindInventory("Handgun"))
	  y += 96;
	
	if(pmo.FindInventory("TrenchGun"))
	  y += 96;
	  
	if(pmo.FindInventory("SprayCan"))
	  y += 96;
	  
	if(pmo.FindInventory("AR"))
	  y += 96;
	  
	if(y > 260)
	  return y;
	else
	  return 260;
  }
  
  void SetupButtons()
  {
    let pmo = players[consoleplayer].mo;
	if(pmo.FindInventory("Handgun"))
	{
	  CreateButton(uNames[0], bCmds[0], "Graphics/GunUpgrade/P_Up1.png", DFPlayer(pmo).bP_Up1);
	  CreateButton(uNames[1], bCmds[1], "Graphics/GunUpgrade/P_Up2.png", DFPlayer(pmo).bP_Up2);
	  CreateButton(uNames[2], bCmds[2], "Graphics/GunUpgrade/P_Up3.png", DFPlayer(pmo).bP_Up3);
	}
	
	if(pmo.FindInventory("TrenchGun"))
	{
	  CreateButton(uNames[3], bCmds[3], "Graphics/GunUpgrade/S_Up1.png", DFPlayer(pmo).bS_Up1);
	  CreateButton(uNames[4], bCmds[4], "Graphics/GunUpgrade/S_Up2.png", DFPlayer(pmo).bS_Up2);
	  CreateButton(uNames[5], bCmds[5], "Graphics/GunUpgrade/S_Up3.png", DFPlayer(pmo).bS_Up3);
	}
	
	if(pmo.FindInventory("SprayCan"))
	{
	  CreateButton(uNames[6], bCmds[6], "Graphics/GunUpgrade/Sp_Up1.png", DFPlayer(pmo).bSp_Up1);
	  CreateButton(uNames[7], bCmds[7], "Graphics/GunUpgrade/Sp_Up2.png", DFPlayer(pmo).bSp_Up2);
	  CreateButton(uNames[8], bCmds[8], "Graphics/GunUpgrade/Sp_Up3.png", DFPlayer(pmo).bSp_Up3);
	}
	
	if(pmo.FindInventory("AR"))
	{
	  CreateButton(uNames[9], bCmds[9], "Graphics/GunUpgrade/AR_Up1.png", True);
	  CreateButton(uNames[10], bCmds[10], "Graphics/GunUpgrade/AR_Up2.png", True);
	  CreateButton(uNames[11], bCmds[11], "Graphics/GunUpgrade/AR_Up3.png", True);
	}
  }
  
  void CreateButton(String upgName, String command, String img, bool have)
  {
    String cmd = "Upgrade:";
	UIBoxTextures hov = btnHover;
	double ap = 1.0;
	if(have)
	{
	  cmd = "n:";
	  hov = btnInactive;
	  ap = 0.5;
	}
	
	UIButton btn = UIButton(new("UIButton")).Create((26, btnY), (144, 32),
	upgName, handler,
	cmd .. command .. String.Format(":%d", bootuns.size()),
	inactive: btnInactive,
	hover: hov,
	click: btnInactive);
	btn.SetAlpha(ap);
	
	UIImage btnImg = UIImage.Create((0, btnY), (26, 26), image: img, imagescale: (0.2,0.2));
	btnImg.SetAlpha(ap);
	
	bootuns.Push(btn);
	pictures.Push(btnImg);
	UIFrame frm = UIFrame(UpgradeList.getScrollArea());
	btn.Pack(frm);
	btnImg.Pack(frm);
	btnY += 32;
  }
}

Class GunMenuHandler : UIHandler
{
  GunMenu menu;
  
  void Confirm()
  {
    int i = random(1,3);
	int im = 50;
	if(i == 2)
	  im = 46;
	else if(i == 3)
	  im = 49;
		  
	let ev = GenericScreenStuff(EventHandler.Find("GenericScreenStuff"));
	if(ev)
	  ev.SendNetworkEvent(String.Format("SetAnimation:GUP%d_:640:360:%d:0.75", i, im));
		
	let uh = UpgradeHandler(EventHandler.Find("UpgradeHandler"));
	if(uh)
	{
	  uh.SendNetworkEvent(menu.upg_command);
	  uh.SendNetworkEvent("Adjust_Attunement");
	  uh.SendNetworkEvent("CloseShop");
	}
	menu.MenuSound("GM_Done");
	menu.Close();
  }
  
  override void elementHoverChanged(UIElement caller, Name command, bool unhovered)
  {
	if(!unhovered)
	{
	  Array<String> cmd;
	  cmd.Clear();
	  String commandList = command;
	  commandList.Split(cmd, ":");
	  
	  if(cmd.size() < 4)
	  return;
	  
	  if(cmd[1].Left(3) ~== "Psi")
	  {
	    PlayerPawn pmo = players[consoleplayer].mo;
	    if(DFPlayer(pmo).tune >= DFPlayer(pmo).tune_max)
	      menu.Cur_Attunement.SetText(String.Format("\cR[Current Attunement: %d/%d]", DFPlayer(pmo).tune, DFPlayer(pmo).tune_max));
		else
		  menu.Cur_Attunement.SetText(String.Format("\cD[Current Attunement: %d/%d]", DFPlayer(pmo).tune, DFPlayer(pmo).tune_max));
	  }
	  else
	    menu.Cur_Attunement.SetText("");	  
	 
	  menu.UpgradeText.setText(StringTable.Localize(cmd[2]));
	}
  }
  
  override void ButtonClickCommand(UIButton caller, Name command)
  {
	Array<String> cmd;
	cmd.Clear();
	String commandList = command;
	commandList.Split(cmd, ":");

	PlayerPawn pmo = players[consoleplayer].mo;
	
	if(cmd[0] ~== "n")
	  return;
	  
	if(cmd.Size() > 1 && cmd[1].Left(3) ~== "Psi")
	{
	  if(DFPlayer(pmo).tune >= DFPlayer(pmo).tune_max)
	    return;
	}
	
	if(cmd[0] ~== "Upgrade")
	{
	  menu.MenuSound("M_Click1");
	  menu.confirm_msg.setText("Confirm Selection: \cF" .. menu.uNames[cmd[3].ToInt(10)] .. "?");
	  menu.upg_command = cmd[1];
	  menu.confirm_bound.Show();
	  menu.confirm_box.Show();
	  menu.confirm_wait = true;
	}
	
	if(cmd[0] ~== "Cancel_Choice")
	{
	  menu.confirm_bound.hide();
	  menu.confirm_box.hide();
	  menu.confirm_wait = false;
	}
	  
	if(cmd[0] ~== "Confirm_Choice")
	  Confirm();
  }
}

Class GunActivator : Inventory
{
  Default
  {
	Inventory.Amount 1;
	+Inventory.UNDROPPABLE
  }

  override bool Use(bool pickup)
  {
	if(owner == null)
	  return true;

	if(owner == players[consoleplayer].mo)
	  Menu.SetMenu("GunMenu");

	  return false;
  }
}

Class UpgradeStation : Actor
{
  bool uzed;
  int sndOff, phyTamp;
  
  override void Tick()
  {
    Super.Tick();
	
	if(sndOff == 1)
	{
	  let pmo = players[consoleplayer].mo;
	  if(pmo)
	    pmo.A_StopSound(CHAN_VOICE);
		
	  sndOff--;
	}
	
	if(sndOff > 0)
	  sndOff--;
  }
  
  override bool Used(Actor user)
  {
    if(user && user is "DFPlayer" && DFPlayer(user).statBase == "Phy")
	{
	  if(phyTamp < 50)
	  {
		user.ACS_NamedExecute("ForbidPhysique");
		user.DamageMobj(self, self, 1, "Energy", DMG_NO_ARMOR|DMG_NO_FACTOR|DMG_NO_PROTECT);
		user.A_QuakeEx(0.5, 0.5, 0.5, 5, 0, 100, "dsempty");
		user.A_SetBlend("Red", 0.12, 5);
		A_StartSound("GM_No", CHAN_AUTO);
	    phyTamp++;
	  
	    if(phyTamp == 50)
	      SetStateLabel("Troll");
	  }
	  return false;
	}
	
    if(user && user is "DFPlayer" && !uzed)
	{
	  DFPlayer(user).upgActr = self;
	  Menu.SetMenu("GunMenu");
	  sndOff = 2;
	}
	return true;
  }
  
  Default
  {
    Radius 58;
    Height 184;
	YScale 0.83;
	FloatBobStrength 0.15;
	+FLOATBOB
    +NOGRAVITY
	+SOLID
  }
  
  States
  {
    Spawn:
	  UPST A random(350, 525) Light("UpgradeStationPulse");
	  UGS1 ABCDEFGHIJKLMNOPQRSTUVWXYZ 1 Light("UpgradeStationPulse");
	  UGS2 ABCDEFGHIJKLMNOPQRSTUV 1 Light("UpgradeStationPulse");
	  Loop;
	Death:
	  TNT1 A 0
	  {
	    uzed = true;
		if(players[consoleplayer].mo)
		  players[consoleplayer].mo.A_CallSpecial(special, args[0], args[1], args[2], args[3], args[4]);
	  }
	  UPST A 1 Light("UpgradeStationPulse") A_FadeOut(0.05);
	  Wait;
	Troll:
	  TNT1 A 0 A_StartSound("GM_Warn", CHAN_AUTO, volume: 0.5);
	  UPST AAAAAAAAAAAAA 1 A_SpriteOffset(frandom(-2.0,2.0), frandom(-2.0,2.0));
	  TNT1 A 1
	  {
		A_QuakeEx(4, 9, 9, 35, 0, 2048, "DSEMPTY", QF_RELATIVE|QF_SCALEDOWN|QF_SHAKEONLY);
		A_QuakeEx(0, 0, 0, 4, 0, 2048, "DSEMPTY", QF_SHAKEONLY, rollintensity: 5);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("EXPFA0"), STYLE_ADD, SPF_FULLBRIGHT, 15, 223, 0,
	    0, 0, 48, startalphaf: 0.9, fadestepf: 0.07, sizestep: 11);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("EXPFA0"), STYLE_ADD, SPF_FULLBRIGHT, 10, 500, 0,
	    0, 0, 48, startalphaf: 1.0, fadestepf: 0.1);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SMK1_01"), STYLE_Translucent, SPF_RELATIVE|SPF_ROLL|SPF_LOCAL_ANIM, 61, 256, 0,
	    -64, 0, 4, fadestepf: 0.0, startroll: random(0,359));
	  }
	  TNT1 A 1
	  {
		A_StartSound("Bar_Exp2", CHAN_AUTO, attenuation: 0.7);
		A_SpawnItemEx("MineExplosion3", zofs: 32);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SMK1_01"), STYLE_Translucent, SPF_RELATIVE|SPF_ROLL|SPF_LOCAL_ANIM, 61, 256, 0,
	    64, 0, 4, fadestepf: 0.0, startroll: random(0,359));
	  }
	  TNT1 A 1
	  {
	    A_SpawnItemEx("MineExplosion", zofs: 8);
		A_SpawnItemEx("MineExplosion2", zofs: 2);
		A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SMK1_01"), STYLE_Translucent, SPF_RELATIVE|SPF_ROLL|SPF_LOCAL_ANIM, 61, 256, 0,
	    0, -64, 4, fadestepf: 0.0, startroll: random(0,359));
	    for(int i = 0; i < 18; i++)
		{
		  int pitch = random(2,90);
		  int angle = random(0,359);
		  
		  Vector3 newPos = 32 * (cos(pitch) * cos(angle), cos(pitch) * sin(angle), sin(pitch)); //ALL plushiinations
		  Vector3 newVel = frandom(0.5, 0.8) * (0.8 * newPos);
		  A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SPFLA0"), STYLE_ADD, SPF_FULLBRIGHT, 35, 12, 0, newPos.x, newPos.y, newPos.z, newVel.x, newVel.y, newVel.z,
		  accelz: -0.01
		  );
	    }
	  }
	  TNT1 A 1
	  {
	    A_SpawnParticleEx("FFFFFF", TexMan.CheckForTexture("SMK1_01"), STYLE_Translucent, SPF_RELATIVE|SPF_ROLL|SPF_LOCAL_ANIM, 61, 256, 0,
	    0, 64, 4, fadestepf: 0.0, startroll: random(0,359));
	    for(int i = 0; i < 18; i++)
		{
		  int pitch = random(2,90);
		  int angle = random(0,359);
		  
		  Vector3 newPos = 32 * (cos(pitch) * cos(angle), cos(pitch) * sin(angle), sin(pitch)); //ALL plushiinations
		  Vector3 newVel = 0.8 * newPos;
		  
		  Actor puff = Spawn("ESpark",  pos + (random(24,32) * (cos(pitch) * cos(angle), cos(pitch) * sin(angle), sin(pitch))));
		  if(puff)
		    puff.vel = newVel;
	    }
	  }
	  TNT1 A 1 A_Explode(random(800,900), 1000, XF_NOTMISSILE , 0, 1000, damagetype: "Explode");
	  TNT1 A 70;
	  Stop;
  }
}