Lore_24 =
"\cU[Глава VII — Мутации]\n\n"
"\cJ__ __ __ __ \cU-Как бы чудесно они ни выглядели, аномалии сохранялись в их структуре и чертеже. Это всё ещё несовершенно- \cJ__ __ __ "
"__ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ "
"__ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ "
"\cUПоказывает возможность истинной совершенной последовательности, относящейся к высшему возможному порядку. \cJ__ __ __ __ __ __";

Lore_25 =
"\cU[Глава VII — Мутации]\n\n"
"\cJ__ 01 __ ?? ?? ?? \cU-криптографическое озарение изображает математическое выражение точки, растягивающейся в линии на противоположных концах, "
"и другой точки, проявляющейся над исходной позицией, чтобы соединить два полюса и объединить целое. Это- "
"\cJ__ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __"
" \cU[Конец отрывка]";
