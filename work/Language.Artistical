[ru]

GAME_INTRO1 = "\"...По сути, воздействие Божественной Частоты в нашей вселенной равносильно богу,\n"
"разрушающему творение и создающему на его месте нечто иное.\"\n\n"
"-Демиург, «О природе снов»";

Lore_Get = "\cD[Установить спутниковый канал]";
Lore_Reset = "\cD[Прочитать снова]";
Link_01 = "Канал установлен. Пакет передан на 460.789.";

Lore_09 =
"\cD://ID: 03.8-12\n"
"://Relay: 103.588\n"
"://Transmitting.\n"
"://Packet received.\n"
"[Code - 1DFL]\n"
"<Отрывок из «Манускрипта Кристалиты»>.";

Lore_10 =
"\cU[Введение]\n\n"
"Во вселенной, где каждая нить её существования осаждается пришествием нового онтологического стандарта, вещи, которые никогда не должны быть "
"увидены или поняты ни в каком слое, кроме абстрактного (или концептуального), проявляются в других слоях существования.";

Lore_11 =
"\cU[Глава I — Психус]\n\n"
"Что происходит с сознанием после смерти, остаётся одной из величайших загадок человечества. Некоторые предполагают, что логически наш разум просто прекращает существовать. "
"Мы возвращаемся во вселенную через разложение, становясь частью почвы и воздуха, снова вливаясь в жизнь экосистемы. "
"Другие верят, что только в смерти рождается истинное сознание, поскольку оно больше не связано биологическими и сенсорными обратными связями.";

Lore_12 =
"\cU[Глава I — Психус]\n\n"
"Увы, недавно обнаруженное в полевых исследованиях пролило некоторый свет на этот древний вопрос. Анализ тел, извлечённых из Периметра, выявляет "
"феномен, который проявляется, когда от существования умершего удаляется достаточно частей.";

Lore_13 =
"\cU[Глава I — Психус]\n\n"
"Этот феномен оказывает психоактивное воздействие на любое разумное существо поблизости. Пострадавшие в большинстве случаев "
"испытывают «двойное сознание», постоянно переживая последние мгновения умирающего, и их приходится вручную уводить, чтобы разорвать этот эффект. "
"Именно поэтому мы назвали феномен «Психус».";

Lore_14 =
"\cU[Глава I — Психус]\n\n"
"То, что я обнаружил в наблюдениях и экспериментальных исследованиях Психуса, мне всё ещё трудно выразить словами. Его свойства крайне озадачивают, "
"а выводы всё ещё ограничены из-за опасной природы места наблюдения. Я могу объяснить это лишь как последний «вздох» "
"части нашей вселенной, проявившейся и оставшейся сиротой там, где она не может пройти естественное разложение, поддерживающее законы термодинамики.";

Lore_15 =
"\cU[Глава I — Психус]\n\n"
"Другие считают, что сила проявления напрямую связана с тем, насколько глубоко аберрантная мутация проникла в мутировавшее физическое тело. Они предположили, что эта гибридная энергия затем "
"становится доступной для любых сущностей, способных её поглощать. [Конец отрывка]";

Lore_20 =
"\cD://ID: 01.21-62\n"
"://Relay: 110.424\n"
"://Transmitting.\n"
"://Packet received.\n"
"[Code - 1DFL]\n"
"<Отрывок из «Манускрипта Кристалиты»>.";

Lore_21 =
"\cU[Глава VII — Мутации]\n\n"
"\cJ0xAF13 C9 7E 44 00 FF 9A 1B 1B 1B 6E D4 A0 ?? 3C __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __ "
"__ __ __ __ __ __ __ __ __ __ __ __ __ __ __ __\cU-штаммы мутаций не являются еретическими и рукотворными, они принадлежат высшему порядку. "
"В отличие от обычных изменений, которые формируются медленно, аберрантные мутации — результат внезапного и всепоглощающего воздействия резонансных объектов "
"или сил.";

Lore_22 =
"\cU[Глава VII — Мутации]\n\n"
"В этом случае мутация проявляется не как сбалансированное переформирование или деконструкция того, что подверглось воздействию Божественной- \cJ0x7FFF FFFE __ __ __ __"
"\cU -а скорее как агрессивный рак или инфекция, приводящая к неравномерной мутации, а в некоторых случаях- \cJDE AD 7F 2E 90 90 90 5A 5A 5A C0 FE 11 "
"08 7B 4F 00 00 00 00 17 17 FF FF FF EE EE 2A 2A A9 B1 C3 D5 || || || || || || || || || __ __ __ __ __";

