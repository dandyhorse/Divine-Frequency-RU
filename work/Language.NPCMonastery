[ru]
//////////////ALTAR
ALTAR_01_DLG_01 =
"\cDТы замечаешь манящую ауру, исходящую от гриба. Твои чувства влекут тебя к новым ощущениям.";
ALTAR_01_DLG_01a =
"\cQ[Исток] \cDСотворить безмолвную молитву.";

//////////////SHROOM
SHRM_02 = "Аномальный гриб";
SHRM_INTRO =
"\cDТы замечаешь манящую ауру, исходящую от гриба. Твои чувства влекут тебя к новым ощущениям.";
SHRM_INTRO_1 =
"\cD[Слушать цвета]";
SHRM_INTRO_2 =
"\cD[Есть звуки]";

SHRM_SOUND1 = "\cDНичего не происходит.";
SHRM_SOUND1a = "\cD[Подождать]";
SHRM_SOUND2 =
"\cDТы впадаешь в транс. Теряя всякое осознание себя...\n\n"
"Когда ты просыпаешься, ты уже лягушка. Ты голоден, измождён, отчаянно хочешь есть. Ты можешь только есть. Твои инстинкты требуют этого.";
SHRM_SOUND2a = "\cD[Искать что-нибудь съедобное]";
SHRM_SOUND3 = 
"\cDНо вокруг нет ничего съедобного. Кроме... электрического сигнала. Да. Ты убеждён, что он питателен, приятен, даже аппетитен. "
"Он утолит твой бесконечный голод.";
SHRM_SOUND3a = "\cD[Съесть сигнал]";
SHRM_SOUND4 = 
"\cDТы поглощаешь сигнал. У него долгое сладкое послевкусие. Твои чувства обостряются. Ты чувствуешь себя изумительно.\n\n"
"И кто бы мог подумать, что будет ещё? Симфония звуковых волн и экзотических цветов окружает тебя. Ожидая, когда её пожрут.";
SHRM_SOUND4a = "\cD[Продолжать есть]";
SHRM_SOUND5 =
"\cDТы жадно пожираешь музыку. Ощущение оргазмическое, будто триллион рецепторов удовольствия срабатывает в каждой клетке твоего существа.\n\n"
"Горькое, безумное, знакомое, светлое, горячее, интенсивное, тесное, давление, холод и множество других ощущений сливаются, пока не исчезает всякое различие.";
SHRM_SOUND6 =
"\cDТебя полностью перезаписывают. Ни следа от тебя не остаётся. То, что существует теперь, просто за пределами этого мира. Ты можешь вспомнить лишь искажённые отголоски "
"своего прежнего «я». Теперь ты фрагментирован и дрейфуешь между двумя мирами в вечности.";
SHRM_COLOR1 =
"\cDТы впадаешь в транс. Видя за пределами опыта себя...\n\n"
"Ты — цветок лотоса, существующий в состоянии полной гармонии. Однажды тебя навещает красный свет. Он говорит игриво:\n"
"\cJ''Всё предназначено меняться, даже Солнце и Земля. Ты не исключение.''\cD\n\n"
"Проходит мгновение — и свет уходит.";
SHRM_COLOR2 =
"\cDНа второй день тебя навещает зелёный и синий свет. Зелёный свет говорит:\n"
"\cJ''Скоро к тебе придут многие другие гости. Будь готов.''\n\n"
"\cDЗатем синий свет говорит:\n"
"\cJ''Время на исходе.''\cD\n\n"
"Проходит мгновение — и огни уходят.";
SHRM_COLOR3 =
"\cDНа третий день приходит больше огней, каждый шепчет тебе в разум тревожную истину.\n\n"
"Один напомнил, что это существование будет бесконечно расширяться и сжиматься, что нынешняя конфигурация неизбежно вернётся. Ты проживёшь эту самую жизнь "
"снова без единого воспоминания. Тебе никогда не выбраться из спирального водоворота бесконечности.";
SHRM_COLOR4 =
"\cDНа четвёртый день цвета множатся и схлопываются друг в друга. Каждое столкновение вызывает рекурсивное расширение лучей света. "
"Их шум теперь оглушительный визг, грозящий дестабилизировать саму твою онтологическую природу, пока вибрация прокатывается по твоему разуму.\n\n"
"Ты полностью растворяешься в свете.";
SHRM_COLOR5 =
"\cDНа седьмой день ты просыпаешься в радостной сцене, погружённый в священные материи. Ты — вихрь воплощённых мыслей. Продукт высшего порядка.";
