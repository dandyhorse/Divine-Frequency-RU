[ru]
//*******************************************************
Fridge = "Холодильник";
Goat = "Ученик Рааха";
Goat_01 =
"Приветствую. Какие подношения ты принёс?";
Goat_01a = "Что ты принимаешь?";
Goat_01b = "У меня нет подношений.";
Goat_01c = "\cD[Открыть дверцы]";
Goat_01a_1 =
"Я принимаю всё, что имеет высокую ценность. Но сегодня я готов довольствоваться чем-нибудь вкусным.";
Goat_01a_1a = "Что? Почему именно этим?";
Goat_01a_2 =
"\cDХолодильник тихо посмеивается, его тембр звенит весельем. \cJЭто единственное наслаждение, которое возносит жизнь к самым ярким горизонтам, "
"не так ли?\n\n"
"Вчера — вкус плоти. Позавчера — тройственная душа. Завтра — кристаллы миксолидийских преломлений.";
Goat_01a_2a = "Да. Я тоже успел отведать всяких странностей в своих странствиях.";
Goat_01a_2a_1 =
"Видно. Их остатки всё ещё цепляются за тебя. Некоторые из них даже возвысили твоё состояние. Именно поэтому я "
"решаюсь поглощать определённые вещества.\n\n"
"В конце концов, разве не сам опыт приводит Самость в движение? Лишь когда кто-то отвергает эту истину, он медленно умирает. "
"Я же продолжу искать новые опыты.";
Goat_01a_2a_2 = 
"\cDГолос повышается на пару тонов. \cJК слову о вещах, дарующих яркие ощущения: одну мою вещь должны были доставить мне давным-давно, но она потерялась в пути.\n\n"
"Если найдёшь её и принесёшь сюда, я щедро тебя вознагражу.";
Goat_01a_2b = "Кристаллы миксолидийских преломлений?";
Goat_01a_2b_1 = 
"Поистине уникальная смесь аудиовизуальных ощущений на вкус. Было время, когда многие из нас вкушали их "
"вместе. О, как это открывало наши умы возможностям за пределами.";
Goat_01a_2b_1a = "Это то подношение, которое ты хочешь?";
Goat_01a_2b_2 = 
"Нет. Сейчас мне хочется другого съестного — того, что превыше даже этого.\n\n"
"\cDХолодильник замолкает на несколько секунд, словно обдумывая своё положение.\n"
"\cJЗнаешь, хорошо, что ты оказался здесь. Мне нужна услуга, и когда ты её выполнишь, тебя тоже ждёт кое-что приятное.";
Goat_01a_2c = "Извини. Мне это не близко.";
Goat_01a_2c_1 =
"\cDГолос становится разочарованным. \cJКак жаль. И дело не в очевидной лжи твоих слов, а в том, что ты, возможно, не знаешь, что на самом деле поглощал всё это время.";
Goat_01a_2c_1a = "Что ты имеешь в виду?";
Goat_01a_2c_2 = "Помоги мне — и узнаешь.";
Goat_01b_2 =
"\cDХолодильник улыбается. \cJЕсть, просто ты пока об этом не знаешь.";
Goat_01b_2a = "Перестань улыбаться. Мне жутко.";
Goat_01b_3 =
"\cDУлыбка холодильника растягивается ещё шире, чем прежде. С каждой секундой она становится всё более уродливой, оскорбительной и оставляющей шрамы в сознании.\n\n";
Goat_01b_3a = "Прекрати! Что тебе нужно?!";
Goat_01b_4 =
"Ха-ха-ха-ха! Расслабься! Я не собираюсь тебя есть. Кто-кто, а я знаю, что не стоит пытаться поглотить нечто вроде ядерного реактора.\n\n"
"\cDПосле короткой паузы. \cJТак, на чём я остановился...";
Goat_01c_1 =
"\cDДверцы плотно закрыты.";
Goat_01_0a = "Ладно. Слушаю.";
Goat_01_0b = "\cQ(Уйти) \cJНет.";
Goat_01_0c = "\cQ(Уйти) \cJХватит этого!";
Goat_02 = 
"Назовём это... предчувствием. Думаю, мы можем помочь друг другу. Видишь ли, я проголодался, но не по обычному мусору, "
"что мне предлагают, а по чему-то, что действительно насытит чувства.\n\n"
"То место, где ты стоишь, наверняка привлечёт неприятных гостей. Я могу дать тебе средства справиться с ними. Интересно?";
Goat_02_a = "Да. Продолжай.";
Goat_03 = 
"Отлично! Мне нужно, чтобы ты принёс реликвию двуногого животного. Сегодня я жажду вкусить небо, его зов становится для меня всё "
"громче с каждой секундой.\n\nВернись ко мне с этим артефактом целым, и я обменяю его на нечто равноценное.";
Goat_03a = "\cI[Принять] \cJХорошо, где мне найти эту вещь?";
Goat_03b = "\cR[Отказаться] \cJЭто нелепая просьба. У меня есть дела поважнее."; 
Goat_03c = "\cR[Отказаться] \cJНет."; 
Goat_04a_01 =
"Она находится в месте, куда нельзя попасть — по крайней мере, пока. Видишь ли... она должна притянуться к тебе: и ты, и это событие "
"должны резонировать соответствующим образом, чтобы найти друг друга.\n\n"
"Возьми это, и пусть оно поможет тебе в пути. \cDХолодильник ставит перед тобой энергетическую ловушку.";
Goat_04a_01a = "Не можешь хотя бы дать полезную информацию?";
Goat_04a_01b = "\cQ(Уйти) \cJЯ пойду.";
Goat_04a_02 =
"Досадный исход, но понятный. Если передумаешь — возвращайся в любое время.";
Goat_04x01 = "Ты передумал?";
Goat_04x02 =
"Очень хорошо! Теперь об этой вещи... она находится в месте, куда нельзя попасть — по крайней мере, пока. Видишь ли, она должна притянуться к тебе: и ты, и это событие "
"должны резонировать соответствующим образом, чтобы найти друг друга.\n\n"
"Возьми это, и пусть оно поможет тебе в пути. \cDХолодильник ставит перед тобой энергетическую ловушку.";
Goat_05 =
"Ммм... Единственное, что приходит на ум, — искать то, что внизу.";
Goat_05a = "А как насчёт ресурсов? Ты ведь хочешь, чтобы я вернулся живым, да?";
Goat_05b = "\cQ(Уйти) \cJЭто совсем не помогает.";
Goat_05c = "\cQ(Уйти) \cDПромолчать.";
Goat_06 =
"Хорошо.\n\n"
"Восемь... Восемь... Восемь. Это всё, что у меня есть для тебя.";
Goat_06a = "\cQ(Уйти) \cJПонял. Тогда я пошёл.";
Goat_06b = "\cQ(Уйти) \cJКак и ожидалось, очередная чушь.";
Goat_06c = "\cQ(Кивнуть и уйти)";
Goat_07 = "Как продвигаются поиски?";
Goat_07a = "\cI[Отдать курицу] \cJВот она.";
Goat_07b = "Пока ничего.";
Goat_07a_01 = "Великолепно! Это подношение радует меня. Теперь я покину этот мир с чувством удовлетворения. Прими это как выражение моей благодарности.\n\nНаша сделка завершена. Прощай.";
Goat_07a_01a = "Подожди! У меня есть вопросы, прежде чем ты уйдёшь.";
Goat_07a_01b = "\cQ(Уйти) \cJБыло честью служить тебе.";
Goat_07a_01c = "\cQ(Уйти) \cJСпасибо. Не возвращайся.";
Goat_07a_01d = "\cQ(Уйти) \cDКивнуть.";
Goat_08 =
"\cDСущность издаёт громкий зловещий смех, его отзвук разносится по пустым залам. \cJДа, ты хочешь узнать природу того, что "
"поглощал всё это время.\n\n"
"Это не то, что ты сознательно выбираешь поглотить, а то, что было взято без раздумий. Пищеварение этого мира и другого. "
"Ты уже съел изрядную долю. Это уже изменило тебя.";
Goat_08a = "Объяснись.";
//*******************************************************
Sjinn = "Ученик Сджинна";
Sjinn_00 = "Прошу прощения. Дворец сейчас закрыт.";
Sjinn_01 = "\cDГлаза открываются, она смотрит на тебя и улыбается.\n\n\cJПриветствую, странник. Ты пришёл посетить Дворец?";
Sjinn_01a = "Да, я хотел бы его посетить.";
Sjinn_01a2 = "У меня есть колокол.";
Sjinn_01b = "Что такое Дворец?";
Sjinn_01c = "Кто ты?";
Sjinn_01d = "\cQ(Уйти) \cJНе сейчас.";
Sjinn_01a_1 =
"О, похоже, у тебя нет резонирующего колокола. Пожалуйста, вернись, когда добудешь его. Посетители должны всегда иметь при себе колокол, чтобы "
"не заблудиться.\n\nСпасибо за понимание.";
Sjinn_01a_1a = "Где его можно найти?";
Sjinn_01a_2 = 
"Резонирующий колокол можно получить в нескольких местах.\n\n"
"Один дают каждому паломнику, когда тот достигает конца своего испытания посвящения. Другой могут временно выдать для наглядной "
"демонстрации. Частные бронирования сейчас недоступны. Мы глубоко сожалеем о неудобствах.";
Sjinn_01a_2a = "Есть ещё кое-что, о чём я хочу тебя спросить.";
Sjinn_01a_3 = "Конечно, чем я могу помочь?";
Sjinn_01b_1 =
"Дворец — совместный проект учеников Сджинна и учеников Адама. Благодаря их поразительным нейрокибернетическим "
"достижениям и нашим обширным исследованиям снов мы можем предложить глубокий опыт, соответствующий глубочайшей реальности внутри пользователя.";
Sjinn_01c_1 =
"Я больше не помню, кто я в этом бодрствующем мире. Я существую лишь для того, чтобы приветствовать и направлять тех, кто ищет вход во Дворец.";
Sjinn_04 = "Очень хорошо. Позвони в колокол, когда будешь готов, и мы отправимся вместе.";
