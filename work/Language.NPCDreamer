[ru]
M01_DREAM_01 =
"\cDКогда ты подходишь ближе, твоё сознание начинает качаться в такт каждому мерцающему кадру. Каждое мгновение рядом с этой вещью забирает "
"крошечный фрагмент твоего разума, словно впитывая его в зловещую тьму.";
M01_DREAM_01a = "\cD[Протянуть руку к сущности]";
M01_DREAM_02 =
"\cDТвой разум растворяется в исполинском присутствии перед тобой. Мгновение спустя становится совершенно темно.\n\n"
"\cFТы чувствуешь, как собаки ищут тебя, они идут по твоему следу. Ты мёртв, но лишь в материальном смысле. Мир вокруг тебя оживает.";
M01_DREAM_03 =
"\cFТы — ничто. Всего лишь капля дождя в шторме. Отпусти разум и осознание. Существуй в полной пустоте и пробудись в новом состоянии.\n\n"
"Вдохни. Затем выдохни густой воздух. Вдохни. Затем выдохни. Вдохни... Выдохни...\n\n"
"\cDСпустя мгновение транс заканчивается.";

STUDENT_00 = "Загадочная фигура";
STUDENT = "Ученик Сармипадхвы";
STUDENT_01 =
"\cDБольшая фигура перед тобой, кажется, находится в состоянии транса. Она не замечает твоего присутствия. Возможно, она даже не знает, что ты здесь.";
STUDENT_01a = "\cD[Протянуть руку к сущности]";
STUDENT_01a_1 =
"\cDТвой разум растворяется в исполинском присутствии перед тобой. Мгновение спустя становится совершенно темно.\n\n"
"\cFГлаз, видящий истину, закрывается. Якорь потерян во времени, ты утонешь в бурлящей чёрной воде. Но где-то в глубинах ты и сорок девять "
"других душ всколыхнулись в отчаянном гневе.";
STUDENT_01a_2 =
"\cFЦелый сектор опустошён. Разумы блуждают по этой плоскости и по далёким от неё. Сегодня настал момент, когда человек стал псом. "
"Они ищут твой мёртвый труп и вернули его сюда.\n\n"
"Теперь ты видишь себя чужими глазами — световое шоу бесконечных фракталов и энергии, выраженных константами вселенной. "
"Но это лишь предчувствие, его нужно пережить, чтобы оно стало истинным.\n\n"
"\cDСпустя мгновение транс заканчивается.";
STUDENT_02 =
"\cDМедленный, оглушительный голос отдаётся эхом в твоём разуме, будто тысяча молний вспыхнула одновременно — и звучит ещё громче.\n\n"
"\cFО, ПОЧТЕННЫЙ - РЕБЁНОК - ГАРМОНИИ.  ТО, - ЧТО - ТЫ - ИЩЕШЬ, - ЛЕЖИТ - В - ВЕТРЕ - И - БУРЕ.\n\n"
"\cRВЕРНИСЬ - С - ПУТИ, - КОТОРЫМ - ТЫ - ШЁЛ.";
STUDENT_02a = "\cQ[Инстинкт] \cDНачать церемонию.";
